# Docker Compose project name
COMPOSE_PROJECT_NAME=xianfeng

# Public app settings
PORT=3001
CORS_ORIGIN=https://your-domain.com
PUBLIC_BASE_URL=https://your-domain.com
API_PUBLIC_BASE_URL=https://your-domain.com
ALLOW_PUBLIC_REGISTER=false
# Optional: set to require this invite code only for new mobile registrations.
LOGIN_INVITE_CODE=Xf2606137KQ9

# Frontend build setting
# Leave empty when frontend and API share the same domain through Nginx gateway.
VITE_API_URL=
VITE_PRO_BILLING_ENABLED=true

# Database
MONGO_PORT=27017
MONGODB_URI=mongodb://mongo:27017/xianfeng

# Auth
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d

# Billing
BILLING_DISABLE_MOCK_PAY=true
PRO_BILLING_ENABLED=true
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_pay_private_key.pem
WECHAT_PAY_PLATFORM_CERT_PATH=/run/secrets/wechat_pay_platform_cert.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/billing/wechat/notify

# WeChat mini program login
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# WeKnora guest AI knowledge layer (optional; use with `docker compose --profile weknora up -d`)
WEKNORA_ENABLED=false
WEKNORA_BASE_URL=http://weknora-app:8080/api/v1
WEKNORA_APP_ID=
WEKNORA_API_KEY=
WEKNORA_GUEST_KB_PREFIX=xianfeng-guest
WEKNORA_TIMEOUT_MS=8000
WEKNORA_GLOBAL_KB_IDS=
WEKNORA_RAG_TOP_K=8
WEKNORA_RAG_TIMEOUT_MS=8000
WEKNORA_VERSION=latest
WEKNORA_APP_PORT=18080
WEKNORA_DB_USER=weknora
WEKNORA_DB_PASSWORD=replace-with-a-strong-weknora-db-password
WEKNORA_DB_NAME=weknora
WEKNORA_REDIS_PASSWORD=replace-with-a-strong-weknora-redis-password

# AI generation
AI_PROVIDER=mock
OPENAI_API_KEY=
AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_TEXT_MODEL=gpt-4o-mini

# DeepSeek metadata extraction
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=jiahewanshi
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Volcengine speech-to-text
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_API_KEY=
VOLCENGINE_SECRET_KEY=
VOLCENGINE_RESOURCE_ID=volc.bigasr.auc_turbo,volc.bigasr.auc
VOLCENGINE_MODE=flash
VOLCENGINE_PUBLIC_BASE_URL=https://your-domain.com
VOLCENGINE_FETCH_TIMEOUT_MS=180000

# Volcengine ARK (metadata extraction)
ARK_API_KEY=
ARK_MODEL_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
