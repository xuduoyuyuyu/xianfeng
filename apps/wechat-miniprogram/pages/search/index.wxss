@import "../../styles/native-list.wxss";

page {
  background: #f3f2f8;
  color: #1f1d1a;
}

.xf-native-search-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-right: 26rpx;
  padding-bottom: 80rpx;
  padding-left: 26rpx;
  background-color: #f3f2f8;
  background-image:
    linear-gradient(45deg, rgba(118, 83, 205, 0.055) 0, rgba(118, 83, 205, 0.055) 1rpx, transparent 1rpx, transparent 36rpx),
    linear-gradient(-45deg, rgba(118, 83, 205, 0.04) 0, rgba(118, 83, 205, 0.04) 1rpx, transparent 1rpx, transparent 64rpx);
  background-position: 0 0, 0 0;
  background-size: 36rpx 36rpx, 64rpx 64rpx;
}

.xf-native-search-panel {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 18rpx 0 24rpx;
}

.xf-native-search-field {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  min-width: 0;
  height: 70rpx;
  padding: 0 8rpx 0 26rpx;
  border: 2rpx solid #d8d0ef;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
  color: #8d8d93;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 70rpx;
  box-shadow: 0 8rpx 22rpx rgba(31, 29, 26, 0.04);
}

.xf-native-search-main {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
}

.xf-native-search-icon {
  position: relative;
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  margin-right: 16rpx;
}

.xf-native-search-circle {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #4b5563;
  border-radius: 50%;
}

.xf-native-search-line {
  position: absolute;
  right: 4rpx;
  bottom: 5rpx;
  width: 16rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #4b5563;
  transform: rotate(45deg);
  transform-origin: center;
}

.xf-native-search-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 70rpx;
  min-height: 70rpx;
  color: #1f1d1a;
  font-size: 28rpx;
  line-height: 70rpx;
}

.xf-native-search-field.is-empty .xf-native-search-input {
  flex: 0 1 220rpx;
  width: 220rpx;
  color: #8b8792;
}

.xf-native-search-placeholder {
  color: #8b8792;
  font-size: 28rpx;
  line-height: 70rpx;
}

.xf-native-search-close {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #f3edff;
  color: #5e17eb;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1;
}

.xf-native-search-close::after,
.xf-native-search-chip::after,
.xf-native-search-recent-keyword::after,
.xf-native-search-clear-history::after,
.xf-native-search-tab::after,
.xf-native-search-retry::after {
  border: 0;
}

.xf-native-search-start,
.xf-native-search-results {
  display: grid;
  gap: 34rpx;
}

.xf-native-search-card {
  display: grid;
  gap: 18rpx;
  padding: 10rpx 0 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.xf-native-search-card-title {
  color: #24180a;
  font-size: 26rpx;
  font-weight: 900;
}

.xf-native-search-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44rpx;
}

.xf-native-search-clear-history {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin: 0 0 0 auto;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #f3edff;
  color: #5e17eb;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1;
}

.xf-native-search-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.xf-native-search-recent-list {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  column-gap: 34rpx;
  row-gap: 18rpx;
  max-width: 100%;
}

.xf-native-search-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid #d9c8ff;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5e17eb;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 54rpx;
}

.xf-native-search-recent-keyword {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  max-width: 100%;
  min-height: 44rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #8b8792;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 44rpx;
  text-align: left;
}

.xf-native-search-recent-keyword text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-native-search-clock {
  position: relative;
  flex: 0 0 auto;
  box-sizing: border-box;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid #a7a4ad;
  border-radius: 50%;
}

.xf-native-search-clock::before {
  position: absolute;
  top: 5rpx;
  left: 10rpx;
  width: 3rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #a7a4ad;
  content: "";
}

.xf-native-search-clock::after {
  position: absolute;
  top: 11rpx;
  left: 10rpx;
  width: 7rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #a7a4ad;
  content: "";
}

.xf-native-search-tabs {
  display: flex;
  gap: 34rpx;
  overflow-x: auto;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  white-space: nowrap;
}

.xf-native-search-tab {
  position: relative;
  flex: 0 0 auto;
  min-width: auto;
  min-height: 76rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #969baa;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 76rpx;
}

.xf-native-search-tab.on {
  color: #14142b;
  font-weight: 800;
}

.xf-native-search-tab.on::before {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 6rpx;
  border-radius: 999rpx;
  background: #5e17eb;
  content: "";
}

.xf-native-search-list {
  display: grid;
  gap: 18rpx;
  overflow: hidden;
}

.xf-native-search-result {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  gap: 22rpx;
  overflow: hidden;
  padding: 22rpx;
  border: 1rpx solid #e1daf0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(63, 38, 112, 0.06);
}

.xf-native-search-thumb {
  display: flex;
  flex: 0 0 104rpx;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1f143a, #4b1db2 44%, #b79bff);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.xf-native-search-thumb image {
  width: 100%;
  height: 100%;
}

.xf-native-search-thumb.has-icon-image {
  background: transparent;
}

.xf-native-search-thumb.has-fallback-avatar {
  background: #ffffff;
}

.xf-native-search-thumb.has-fallback-avatar image {
  width: 86%;
  height: 86%;
}

.xf-native-search-thumb.has-topic-emoji {
  background: transparent;
  font-size: 58rpx;
  line-height: 1;
}

.xf-native-search-body {
  display: grid;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  overflow: hidden;
  gap: 8rpx;
}

.xf-native-search-result-head {
  display: flex;
  align-items: center;
  min-width: 0;
  overflow: hidden;
  gap: 12rpx;
}

.xf-native-search-type {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #ccf8e3;
  color: #059669;
  font-size: 20rpx;
  font-weight: 900;
}

.xf-native-search-meta {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #8b8177;
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-native-search-title {
  display: -webkit-box;
  max-width: 100%;
  overflow: hidden;
  color: #24180a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.xf-native-search-desc {
  display: -webkit-box;
  max-width: 100%;
  overflow: hidden;
  color: #6f665d;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.xf-native-search-tags {
  display: flex;
  flex-wrap: wrap;
  min-width: 0;
  overflow: hidden;
  gap: 10rpx;
}

.xf-native-search-tag {
  box-sizing: border-box;
  max-width: 100%;
  padding: 5rpx 16rpx;
  overflow: hidden;
  border: 1rpx solid #d9c8ff;
  border-radius: 999rpx;
  background: #f6f0ff;
  color: #5e17eb;
  font-size: 20rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-native-search-state {
  display: grid;
  justify-items: center;
  gap: 18rpx;
  padding: 64rpx 32rpx;
  border: 1rpx dashed #d2c5ee;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.84);
  color: #8e81b3;
  font-size: 24rpx;
}

.xf-native-search-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 999rpx;
  background: #5e17eb;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.xf-native-search-skeleton {
  width: 100%;
  height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(94, 23, 235, 0.08), rgba(94, 23, 235, 0.18), rgba(94, 23, 235, 0.08));
}

.xf-native-search-skeleton.is-short {
  width: 62%;
}
