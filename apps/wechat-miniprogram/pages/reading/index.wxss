@import "../../styles/native-list.wxss";

.xf-reading-view-switch {
  display: flex;
  box-sizing: border-box;
  justify-content: flex-end;
  margin: 0 0 24rpx;
}

.xf-reading-view-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #f3edff;
  box-shadow: none;
}

.xf-reading-view-toggle::after {
  border: 0;
}

.xf-reading-view-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.xf-reading-page .xf-native-meta-text {
  margin-top: 8rpx;
  color: #6f62a4;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
}

.xf-reading-page .xf-native-card-title {
  margin-top: 0;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1.3;
}

.xf-reading-page .xf-native-description {
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
}

.xf-reading-page .xf-native-book-cover-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.xf-reading-page .xf-native-book-cover {
  background: transparent;
}

.xf-reading-page .xf-native-book-cover-empty {
  background: #ffffff;
  color: #5e17eb;
}

.xf-reading-page.is-feature .xf-reading-list {
  gap: 36rpx;
}

.xf-reading-page.is-feature .xf-reading-card {
  display: block;
  padding: 18rpx;
  border-color: #e2dcf0;
  border-radius: 34rpx;
  box-shadow: 0 18rpx 48rpx rgba(60, 40, 80, 0.06);
}

.xf-reading-page.is-feature .xf-native-book-cover-wrap {
  width: 100%;
  height: 378rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.xf-reading-page.is-feature .xf-native-book-cover,
.xf-reading-page.is-feature .xf-native-book-cover-empty {
  width: 100%;
  height: 378rpx;
}

.xf-reading-page.is-feature .xf-native-book-cover-empty {
  font-size: 42rpx;
}

.xf-reading-page.is-feature .xf-native-body {
  padding: 18rpx 6rpx 4rpx;
}

.xf-reading-page.is-feature .xf-native-card-title {
  margin-top: 0;
  color: #2b1a3a;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.24;
}

.xf-reading-page.is-feature .xf-native-meta-text {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.74;
}

.xf-reading-page.is-feature .xf-native-description {
  margin-top: 22rpx;
  color: #6f665d;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.74;
}

.xf-reading-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
  min-height: 32rpx;
  overflow: visible;
  white-space: normal;
}

.xf-reading-recommender-tag {
  display: flex;
  flex: 0 1 auto;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  max-width: 100%;
  min-height: 32rpx;
  padding: 0 12rpx;
  overflow: visible;
  border: 2rpx solid #d9c8ff;
  border-radius: 999rpx;
  background: #f6f0ff;
  color: #5e17eb;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 32rpx;
  overflow-wrap: anywhere;
  word-break: break-all;
  word-wrap: break-word;
  white-space: normal;
}

.xf-reading-topic-tag {
  display: flex;
  align-items: center;
  flex: 0 1 auto;
  max-width: 100%;
  min-height: 32rpx;
  overflow: visible;
  color: #5e17eb;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 32rpx;
  overflow-wrap: anywhere;
  word-break: break-all;
  word-wrap: break-word;
  white-space: normal;
}

.xf-reading-topic-tag.is-active {
  border-radius: 999rpx;
  background: #f3edff;
}

.xf-reading-page.is-feature .xf-reading-tags {
  gap: 16rpx;
  margin-top: 28rpx;
  min-height: 42rpx;
}

.xf-reading-page.is-feature .xf-reading-recommender-tag {
  max-width: 100%;
  min-height: 42rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.xf-reading-page.is-feature .xf-reading-topic-tag {
  max-width: 100%;
  min-height: 42rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 42rpx;
}
