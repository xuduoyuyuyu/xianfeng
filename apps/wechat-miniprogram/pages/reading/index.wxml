<import src="../../templates/settings-profile-views.wxml" />

<view class="xf-native-page xf-reading-page {{fontSizeClass}} {{compactMode ? 'is-compact' : 'is-feature'}} {{useExternalLibrarySource ? 'is-external-library' : 'is-native-library'}}" style="padding-top: {{chromeHeight}}px;">
  <view class="xf-native-topbar" style="height: {{topbarHeight}}px;">
    <view class="xf-native-nav-row" style="height: {{topbarHeight}}px;">
      <view class="xf-native-menu-button" style="top: {{logoTop}}px; height: {{logoHeight}}px;" catchtap="openSettings" role="button" aria-label="打开设置">
        <view class="xf-native-menu-icon" aria-hidden="true"></view>
      </view>
      <image class="xf-native-logo" style="top: {{logoTop}}px; height: {{logoHeight}}px;" src="/assets/nav/logo.png" mode="aspectFit" bindtap="goProgramsHome" aria-label="回到顶部" />
      <button class="xf-native-welfare-button" style="top: {{logoTop}}px; right: {{welfareRight}}px; height: {{logoHeight}}px;" catchtap="openWelfare" aria-label="百宝箱">
        <image class="xf-native-welfare-icon" src="/assets/menu/welfare-gift-icon.png" mode="aspectFit" aria-hidden="true" />
      </button>
    </view>
  </view>

  <view class="xf-native-search-panel has-view-toggle" aria-label="搜索">
    <view class="xf-native-search-field has-filter" bindtap="openSearch" role="button">
      <view class="xf-native-search-icon" aria-hidden="true">
        <view class="xf-native-search-circle"></view>
        <view class="xf-native-search-line"></view>
      </view>
      <text class="xf-native-search-text">{{searchPrompt}}</text>
      <button class="xf-native-search-filter" catchtap="openFilterDrawer" aria-label="打开及阅筛选">
        <image class="xf-native-search-filter-icon" src="/assets/nav/filter-sliders.png" mode="aspectFit" aria-hidden="true" />
      </button>
    </view>
    <button class="xf-reading-view-toggle" bindtap="switchBookViewMode" aria-label="切换及阅展示样式">
      <image wx:if="{{compactMode}}" class="xf-reading-view-icon" src="/assets/nav/view-grid.png" mode="aspectFit" aria-hidden="true" />
      <image wx:else class="xf-reading-view-icon" src="/assets/nav/view-list.png" mode="aspectFit" aria-hidden="true" />
    </button>
  </view>

  <view wx:if="{{activeReadingTagLabel}}" class="xf-native-filter-bar">
    <text class="xf-native-filter-text">正在筛选：{{activeReadingTagLabel}}</text>
    <button class="xf-native-filter-clear" catchtap="clearReadingTagFilter" aria-label="清除筛选">×</button>
  </view>

  <view wx:if="{{loading}}" class="xf-native-state">
    <view class="xf-native-skeleton"></view>
    <view class="xf-native-skeleton is-short"></view>
    <view class="xf-native-skeleton"></view>
  </view>

  <view wx:if="{{!loading && books.length}}" class="xf-native-list xf-reading-list">
    <view
      wx:for="{{books}}"
      wx:key="id"
      class="xf-native-card xf-reading-card"
      data-index="{{index}}"
      bindtap="openBook"
    >
      <view class="xf-native-book-cover-wrap">
        <image wx:if="{{item.coverImage}}" class="xf-native-book-cover" src="{{item.coverImage}}" mode="aspectFit" />
        <image wx:else class="xf-native-book-cover-logo" src="/assets/menu/jiyue-logo.png" mode="aspectFit" />
      </view>
      <view class="xf-native-body">
        <text class="xf-native-card-title">{{item.title}}</text>
        <text class="xf-native-meta-text">{{item.author}}</text>
        <text wx:if="{{item.hasListDescription}}" class="xf-native-description">{{item.description}}</text>
        <view wx:if="{{item.recommenderTag || item.displayTags.length}}" class="xf-reading-tags">
          <text wx:if="{{item.recommenderTag}}" class="xf-reading-recommender-tag">{{item.recommenderTag}}</text>
          <block
            wx:for="{{item.displayTags}}"
            wx:for-item="tag"
            wx:key="*this"
          >
            <text
              class="xf-reading-topic-tag {{activeReadingTag === tag ? 'is-active' : ''}}"
              data-tag="{{tag}}"
              catchtap="onReadingTagTap"
            >{{tag}}</text>
          </block>
        </view>
        <view wx:if="{{item.miniProgramShortLink}}" class="xf-reading-purchase-button" aria-label="购买">
          <image class="xf-reading-purchase-icon" src="/assets/icons/shopping-cart-share.svg" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !books.length}}" class="xf-native-state">
    <text>{{error || "暂时没有可展示的书单"}}</text>
    <button class="xf-native-retry" bindtap="retryLoad">重试</button>
  </view>

  <view wx:if="{{filterDrawerOpen}}" class="xf-native-filter-mask" catchtap="closeFilterDrawer" catchtouchmove="noop">
    <view
      class="xf-native-filter-drawer"
      style="height: {{filterDrawerHeight}}px;"
      data-drag-mode="drawer"
      catchtap="noop"
      bindtouchstart="onFilterDrawerTouchStart"
      bindtouchmove="onFilterDrawerTouchMove"
      bindtouchend="onFilterDrawerTouchEnd"
      bindtouchcancel="onFilterDrawerTouchEnd"
    >
      <view
        class="xf-native-filter-handle"
        data-drag-mode="handle"
        catchtouchstart="onFilterDrawerTouchStart"
        catchtouchmove="onFilterDrawerTouchMove"
        catchtouchend="onFilterDrawerTouchEnd"
        catchtouchcancel="onFilterDrawerTouchEnd"
      ></view>
      <view class="xf-native-filter-head">
        <view>
          <text class="xf-native-filter-title">及阅筛选</text>
          <text class="xf-native-filter-subtitle">筛选全部及阅图书</text>
        </view>
        <button class="xf-native-filter-close" catchtap="closeFilterDrawer" aria-label="关闭筛选">×</button>
      </view>

      <scroll-view class="xf-native-filter-scroll" scroll-y="{{filterDrawerExpanded}}" enhanced show-scrollbar="false">
        <view
          wx:for="{{readingFilterGroups}}"
          wx:for-item="group"
          wx:key="key"
          wx:if="{{group.options.length}}"
          class="xf-native-filter-section"
        >
          <text class="xf-native-filter-section-title">{{group.title}}</text>
          <view class="xf-native-filter-chip-group">
            <button
              wx:for="{{group.options}}"
              wx:for-item="option"
              wx:key="value"
              class="xf-native-filter-chip {{option.selected ? 'is-active' : ''}}"
              data-tag="{{option.value}}"
              catchtap="onDrawerReadingTagTap"
            >{{option.label}}</button>
          </view>
        </view>
      </scroll-view>
      <view class="xf-native-filter-actions">
        <button class="xf-native-filter-reset" catchtap="resetReadingFilterDraft">重置</button>
        <button class="xf-native-filter-submit" catchtap="applyReadingFilterDraft">查看 {{readingFilterPreviewCount}} 本图书</button>
      </view>
    </view>
  </view>

  <view wx:if="{{settingsPanelOpen}}" class="xf-native-settings-mask" style="height: {{settingsPanelHeight}}px;" catchtap="closeSettings" catchtouchmove="noop">
    <scroll-view class="xf-native-settings-panel" style="height: {{settingsPanelHeight}}px; padding-top: {{profilePanelTop}}px;" scroll-y="true" enhanced show-scrollbar="false" catchtap="noop">
      <view class="xf-native-settings-panel-inner">
      <block wx:if="{{settingsPanelView === 'menu'}}">
        <button wx:if="{{!isLoggedIn}}" class="xf-native-settings-account" open-type="getPhoneNumber" bindgetphonenumber="loginWithPhone">
          <view class="xf-native-settings-avatar-wrap">
            <image class="xf-native-settings-avatar" src="{{accountAvatar}}" mode="aspectFill" />
          </view>
          <view class="xf-native-settings-copy">
            <view class="xf-native-settings-title-row">
              <text class="xf-native-settings-title">{{accountTitle}}</text>
            </view>
            <view class="xf-native-settings-subtitle-row">
              <text class="xf-native-settings-subtitle">{{accountSubtitle}}</text>
            </view>
          </view>
          <text class="xf-native-settings-chevron">›</text>
        </button>
        <view wx:else class="xf-native-settings-account" catchtap="openSettingsItem" data-page="{{accountPage}}" data-title="{{accountTitle}}" data-panel-view="{{accountPanelView}}">
          <view class="xf-native-settings-avatar-wrap">
            <image class="xf-native-settings-avatar" src="{{accountAvatar}}" mode="aspectFill" />
          </view>
          <view class="xf-native-settings-copy">
            <view class="xf-native-settings-title-row">
              <text class="xf-native-settings-title">{{accountTitle}}</text>
            </view>
            <view class="xf-native-settings-subtitle-row">
              <text class="xf-native-settings-subtitle">{{accountSubtitle}}</text>
            </view>
          </view>
          <text class="xf-native-settings-chevron">›</text>
        </view>

        <view
          wx:for="{{settingsSections}}"
          wx:for-item="section"
          wx:for-index="sectionIndex"
          wx:key="key"
          class="xf-native-settings-card"
        >
          <view
            wx:for="{{section.items}}"
            wx:for-item="item"
            wx:for-index="itemIndex"
            wx:key="key"
            class="xf-native-settings-row"
            catchtap="openSettingsItem"
            data-section-index="{{sectionIndex}}"
            data-item-index="{{itemIndex}}"
          >
            <button wx:if="{{!isLoggedIn}}" class="xf-settings-item-login" open-type="getPhoneNumber" bindgetphonenumber="loginWithPhone" data-section-index="{{sectionIndex}}" data-item-index="{{itemIndex}}" catchtap="noop" disabled="{{bindingPhone}}"></button>
            <image wx:if="{{item.iconType === 'image'}}" class="xf-native-settings-logo-icon" src="{{item.image}}" mode="aspectFit" />
            <text wx:elif="{{item.iconType === 'emoji'}}" class="xf-native-settings-emoji-icon">{{item.emoji}}</text>
            <text wx:else class="xf-native-settings-symbol material-symbols-rounded">{{item.icon}}</text>
            <text class="xf-native-settings-label">{{item.title}}</text>
            <text wx:if="{{item.key === 'pro' && settingsMemberBadgeLabel}}" class="xf-native-settings-member-badge">{{settingsMemberBadgeLabel}}</text>
            <text class="xf-native-settings-chevron">›</text>
          </view>
        </view>
      </block>
      <template wx:elif="{{settingsPanelView === 'profile'}}" is="xfSettingsProfilePanel" data="{{profileHeaderHeight: profileHeaderHeight, profileDraft: profileDraft, profileAvatar: profileAvatar, profileGenderOptions: profileGenderOptions, profilePanelMessage: profilePanelMessage}}"></template>
      <template wx:elif="{{settingsPanelView === 'archive'}}" is="xfSettingsArchivePanel" data="{{profileHeaderHeight: profileHeaderHeight, archiveHasChildren: archiveHasChildren, archiveChildren: archiveChildren, archiveInsightGrade: archiveInsightGrade, archiveDraft: archiveDraft, archiveProfileStatus: archiveProfileStatus, archiveRelationOptions: archiveRelationOptions, archiveRegionOptions: archiveRegionOptions, archiveRegionIndex: archiveRegionIndex, archiveStageOptions: archiveStageOptions, archiveStageIndex: archiveStageIndex, archiveStage: archiveStage, archiveGradeOptions: archiveGradeOptions, archiveStageGradeColumns: archiveStageGradeColumns, archiveStageGradeValue: archiveStageGradeValue, archiveGradeDisplayText: archiveGradeDisplayText, archiveGradeSelectOptions: archiveGradeSelectOptions, archiveGradeName: archiveGradeName, archiveGradeDropdownOpen: archiveGradeDropdownOpen, archiveTagOptions: archiveTagOptions, profilePanelMessage: profilePanelMessage}}"></template>
      <template wx:elif="{{settingsPanelView === 'memory'}}" is="xfSettingsMemoryPanel" data="{{profileHeaderHeight: profileHeaderHeight, memoryEnabled: memoryEnabled}}"></template>
      <template wx:elif="{{settingsPanelView === 'memoryManager'}}" is="xfSettingsMemoryManagerPanel" data="{{profileHeaderHeight: profileHeaderHeight, memorySearchQuery: memorySearchQuery, filteredMemoryItems: filteredMemoryItems, memoryPanelMessage: memoryPanelMessage}}"></template>
      <template wx:elif="{{settingsPanelView === 'settings'}}" is="xfSettingsAppPanel" data="{{profileHeaderHeight: profileHeaderHeight, isLoggedIn: isLoggedIn, hasMobile: hasMobile, bindingPhone: bindingPhone, maskedMobile: maskedMobile, fontSizeClass: fontSizeClass, fontOptions: fontOptions, profilePanelMessage: profilePanelMessage}}"></template>
      </view>
    </scroll-view>
  </view>
</view>
<profile-onboarding id="profileOnboarding" bind:saved="onProfileOnboardingSaved" />
