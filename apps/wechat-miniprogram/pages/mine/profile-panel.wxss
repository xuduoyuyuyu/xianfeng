@font-face {
  font-family: "Material Symbols Rounded";
  src: url("/assets/fonts/material-symbols-rounded.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: block;
}

page {
  min-height: 100vh;
  background: #f6f7fb;
  color: #101335;
}

button::after {
  border: 0;
}

.xf-profile-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #f6f7fb;
}

.xf-profile-scrim {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 28vw;
  z-index: 1;
  background: rgba(23, 28, 44, 0.48);
  backdrop-filter: blur(14rpx);
}

.xf-profile-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  width: 72vw;
  height: 100vh;
  box-sizing: border-box;
  padding: 86rpx 28rpx 44rpx;
  background: #f6f7fb;
  border-radius: 0 0 0 34rpx;
}

.xf-profile-header {
  display: grid;
  grid-template-columns: 140rpx 1fr 140rpx;
  align-items: center;
  min-height: 62rpx;
  margin-bottom: 34rpx;
}

.xf-profile-back {
  border: 0;
  background: transparent;
  color: #7c3aed;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  text-align: left;
  padding: 0;
}

.xf-profile-title {
  color: #101335;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
  line-height: 1.1;
}

.xf-profile-header-spacer {
  width: 140rpx;
}

.xf-profile-tabs,
.xf-profile-empty-tabs {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 30rpx;
}

.xf-profile-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-width: 136rpx;
  max-width: 196rpx;
  height: 64rpx;
  margin-right: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe1ea;
  border-radius: 999rpx;
  background: #ffffff;
  color: #101335;
  font-size: 24rpx;
  font-weight: 900;
  padding: 0 24rpx;
  vertical-align: top;
}

.xf-profile-tab.is-active {
  border-color: #cdb8ff;
  background: #efe8ff;
  color: #6c27d6;
  box-shadow: inset 0 0 0 4rpx rgba(124, 58, 237, 0.12);
}

.xf-profile-tab image {
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
}

.xf-profile-tab text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-profile-add {
  min-width: 64rpx;
  width: 64rpx;
  padding: 0;
  color: #7c3aed;
  font-size: 34rpx;
}

.xf-profile-add-child {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 2rpx dashed #cdb8ff;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6c27d6;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 64rpx;
  vertical-align: top;
}

.xf-profile-add-child::after {
  border: 0;
}

.xf-profile-insight {
  box-sizing: border-box;
  margin-bottom: 34rpx;
  padding: 30rpx 34rpx;
  border: 2rpx solid #dacdff;
  border-radius: 30rpx;
  background: rgba(246, 244, 255, 0.84);
}

.xf-profile-insight-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #101335;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-profile-insight-head text:last-child {
  color: #7c3aed;
  font-size: 24rpx;
}

.xf-profile-insight-copy {
  margin-top: 20rpx;
  color: #69728a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.55;
}

.xf-profile-card {
  overflow: hidden;
  box-sizing: border-box;
  margin-bottom: 32rpx;
  padding: 32rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(31, 20, 71, 0.06);
}

.xf-profile-card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  color: #101335;
  font-size: 28rpx;
  font-weight: 900;
}

.xf-profile-card-title text:last-child {
  color: #7c3aed;
  font-size: 24rpx;
}

.xf-profile-field {
  margin-bottom: 28rpx;
}

.xf-profile-label {
  display: block;
  margin-bottom: 14rpx;
  color: #445066;
  font-size: 25rpx;
  font-weight: 900;
}

.xf-profile-field input {
  width: 100%;
  height: 70rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe1ea;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #101335;
  font-size: 25rpx;
  font-weight: 850;
  padding: 0 24rpx;
}

.xf-profile-input-like {
  display: flex;
  align-items: center;
  width: 100%;
  height: 70rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe1ea;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #101335;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 70rpx;
  padding: 0 24rpx;
}

.xf-profile-select-like {
  justify-content: space-between;
  gap: 16rpx;
}

.xf-profile-select-like text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.xf-profile-grade-field {
  grid-column: 1 / -1;
}

.xf-profile-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.xf-profile-chip {
  min-height: 52rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe1ea;
  border-radius: 999rpx;
  background: #f4f6fb;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 52rpx;
  padding: 0 24rpx;
  margin: 0;
  text-align: center;
}

.xf-profile-chip.is-active {
  border-color: #7c3aed;
  background: #f5efff;
  color: #6c27d6;
}

.xf-profile-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 14rpx;
}

.xf-profile-delete-zone {
  display: flex;
  justify-content: center;
  padding: 6rpx 0 16rpx;
}

.xf-profile-delete-child {
  display: block;
  width: auto;
  min-width: 0;
  height: auto;
  margin: 0;
  padding: 10rpx 24rpx;
  border: 0;
  background: transparent;
  color: #ff4d67;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.xf-profile-delete-child::after {
  border: 0;
}

.xf-profile-primary,
.xf-profile-secondary {
  height: 76rpx;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 76rpx;
  padding: 0;
}

.xf-profile-primary {
  background: #6c27d6;
  color: #ffffff;
}

.xf-profile-secondary {
  background: #eef2ff;
  color: #101335;
}

.xf-profile-message {
  min-height: 0;
  margin-top: 18rpx;
  color: #6c27d6;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.xf-profile-danger {
  display: block;
  width: 100%;
  margin: 44rpx 0 0;
  border: 0;
  background: transparent;
  color: #ff4057;
  font-size: 26rpx;
  font-weight: 900;
}

.xf-memory-panel,
.xf-settings-panel {
  background: #f6f7fb;
}

.xf-memory-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 74rpx;
}

.xf-memory-title,
.xf-memory-section-title {
  color: #101335;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-memory-subtitle {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 750;
}

.xf-memory-switch {
  position: relative;
  width: 96rpx;
  height: 54rpx;
  border: 0;
  border-radius: 999rpx;
  background: #e2e8f0;
  padding: 0;
}

.xf-memory-switch text {
  position: absolute;
  top: 7rpx;
  left: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.16);
  transition: left 0.16s ease;
}

.xf-memory-switch.is-on {
  background: #6c27d6;
}

.xf-memory-switch.is-on text {
  left: 48rpx;
}

.xf-memory-copy {
  margin-top: 20rpx;
  font-size: 23rpx;
  font-weight: 500;
  color: #9aa4b5;
  line-height: 1.62;
}

.xf-memory-copy view {
  margin-bottom: 16rpx;
}

.xf-memory-copy view:last-child {
  margin-bottom: 0;
}

.xf-memory-search {
  display: flex;
  align-items: center;
  gap: 18rpx;
  height: 86rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.xf-memory-search text {
  flex: 0 0 auto;
  color: #94a3b8;
  font-size: 36rpx;
  font-weight: 700;
}

.xf-memory-search input {
  flex: 1 1 auto;
  min-width: 0;
  height: 86rpx;
  color: #101335;
  font-size: 27rpx;
  font-weight: 800;
}

.xf-memory-search button {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 0 0 26rpx;
  border: 0;
  border-left: 1rpx solid rgba(15, 23, 42, 0.1);
  background: transparent;
  color: #101335;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-memory-list-card {
  padding: 24rpx;
}

.xf-memory-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.xf-memory-item,
.xf-memory-empty {
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #101335;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.55;
  padding: 24rpx;
}

.xf-memory-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.xf-memory-item text {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-memory-item button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #fff1f4;
  color: #ff4057;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.xf-memory-empty {
  color: #69728a;
}

.xf-memory-login,
.xf-settings-login {
  width: 100%;
  margin-top: 22rpx;
}

.xf-settings-card {
  padding: 0;
}

.xf-setting-row {
  min-height: 92rpx;
  box-sizing: border-box;
  border: 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 0;
  background: #ffffff;
  color: #101335;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.2;
  padding: 0 30rpx;
  text-align: left;
}

.xf-setting-row:last-child {
  border-bottom: 0;
}

.xf-setting-button {
  width: 100%;
}

.xf-setting-row text,
.xf-setting-row button {
  font-size: inherit;
}

.xf-setting-value {
  color: #94a3b8;
  font-size: 25rpx;
  font-weight: 850;
}

.xf-setting-segment {
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #f1f4f9;
  padding: 6rpx;
}

.xf-setting-segment button {
  min-width: 68rpx;
  height: 48rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: #9aa3b7;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 48rpx;
  padding: 0 18rpx;
}

.xf-setting-segment button.is-active {
  background: #ffffff;
  color: #6c27d6;
  box-shadow: 0 6rpx 16rpx rgba(31, 20, 71, 0.08);
}

.xf-font-standard .xf-setting-row text,
.xf-font-standard .xf-setting-row button,
.xf-font-standard .xf-setting-value,
.xf-font-standard .xf-setting-segment button {
  font-size: 25rpx;
}

.xf-font-small .xf-setting-row {
  font-size: 24rpx;
}

.xf-font-small .xf-setting-row text,
.xf-font-small .xf-setting-row button,
.xf-font-small .xf-setting-value,
.xf-font-small .xf-setting-segment button {
  font-size: 22rpx;
}

.xf-font-large .xf-setting-row {
  font-size: 31rpx;
}

.xf-font-large .xf-setting-row text,
.xf-font-large .xf-setting-row button,
.xf-font-large .xf-setting-value,
.xf-font-large .xf-setting-segment button {
  font-size: 29rpx;
}
