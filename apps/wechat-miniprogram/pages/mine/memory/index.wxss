@import "../profile-panel.wxss";

.xf-memory-copy-card {
  padding: 0;
}

.xf-memory-manage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 92rpx;
  box-sizing: border-box;
  border: 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 0;
  background: #ffffff;
  padding: 0 32rpx;
  text-align: left;
}

.xf-memory-chevron {
  color: #94a3b8;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.xf-memory-copy {
  font-size: 23rpx;
  font-weight: 500;
  color: #9aa4b5;
  line-height: 1.62;
  margin-top: 0;
  padding: 26rpx 32rpx 34rpx;
}

.xf-memory-copy view + view {
  margin-top: 18rpx;
}
