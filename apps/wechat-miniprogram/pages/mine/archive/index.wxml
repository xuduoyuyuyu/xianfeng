<view class="xf-profile-shell xf-archive-page {{fontSizeClass}}">
  <view class="xf-profile-scrim"></view>
  <scroll-view class="xf-profile-panel xf-archive-panel" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="xf-profile-header">
      <button class="xf-profile-back" bindtap="goBack">← 返回</button>
      <view class="xf-profile-title">{{title}}</view>
      <view class="xf-profile-header-spacer"></view>
    </view>

    <scroll-view wx:if="{{hasChildren}}" class="xf-profile-tabs" scroll-x="true" show-scrollbar="false">
      <button
        wx:for="{{children}}"
        wx:key="id"
        class="xf-profile-tab {{item.selected ? 'is-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectChild"
      >
        <image src="{{item.avatar}}" mode="aspectFit" />
        <text>{{item.title}}</text>
      </button>
      <button class="xf-profile-tab xf-profile-add" bindtap="addChild">＋</button>
    </scroll-view>

    <view wx:else class="xf-profile-empty-tabs">
      <button class="xf-profile-tab is-active" bindtap="addChild">
        <image src="{{draft.avatar}}" mode="aspectFit" />
        <text>新档案</text>
      </button>
    </view>

    <view class="xf-profile-insight">
      <view class="xf-profile-insight-head">
        <text>今日洞察</text>
        <text>{{insightGrade}}</text>
      </view>
      <view class="xf-profile-insight-copy">{{draft.displayName || '孩子'}}的档案会同步给小玩子，用于生成更贴合年龄、年级和关注点的建议。</view>
    </view>

    <view class="xf-profile-card">
      <view class="xf-profile-card-title">
        <text>基本信息</text>
        <text>{{profileStatus}}</text>
      </view>

      <view class="xf-profile-field">
        <text class="xf-profile-label">称呼</text>
        <input value="{{draft.displayName}}" placeholder="例如 小圆子" bindinput="updateName" />
      </view>

      <view class="xf-profile-field">
        <text class="xf-profile-label">关系</text>
        <view class="xf-profile-chips">
          <button
            wx:for="{{relationOptions}}"
            wx:key="value"
            class="xf-profile-chip {{item.selected ? 'is-active' : ''}}"
            data-value="{{item.value}}"
            bindtap="chooseRelation"
          >{{item.value}}</button>
        </view>
      </view>

      <view class="xf-profile-field">
        <text class="xf-profile-label">出生日期</text>
        <picker mode="date" value="{{draft.birthDate}}" bindchange="chooseBirthDate">
          <view class="xf-profile-input-like">{{draft.birthDate || '请选择出生日期'}}</view>
        </picker>
      </view>

      <view class="xf-profile-grid">
        <view class="xf-profile-field">
          <text class="xf-profile-label">城市</text>
          <input value="{{draft.city}}" placeholder="如：上海" bindinput="updateCity" />
        </view>
        <view class="xf-profile-field">
          <text class="xf-profile-label">区域</text>
          <picker wx:if="{{regionOptions.length}}" range="{{regionOptions}}" value="0" bindchange="chooseRegion">
            <view class="xf-profile-input-like xf-profile-select-like">
              <text>{{draft.region || '请选择区域'}}</text>
              <text>⌄</text>
            </view>
          </picker>
          <input wx:else value="{{draft.region}}" placeholder="{{draft.city ? '手动输入区域' : '先填城市'}}" bindinput="updateRegionInput" />
        </view>
      </view>

      <view class="xf-profile-grid">
        <view class="xf-profile-field xf-profile-grade-field">
          <text class="xf-profile-label">学段 / 年级</text>
          <picker mode="multiSelector" range="{{stageGradeColumns}}" value="{{stageGradeValue}}" bindcolumnchange="updateStageGradeColumn" bindchange="chooseStageGrade">
            <view class="xf-profile-input-like xf-profile-select-like">
              <text>{{gradeDisplayText}}</text>
              <text>⌄</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="xf-profile-field">
        <text class="xf-profile-label">关注点（非必选）</text>
        <view class="xf-profile-chips">
          <button
            wx:for="{{tagOptions}}"
            wx:key="value"
            class="xf-profile-chip {{item.selected ? 'is-active' : ''}}"
            data-value="{{item.value}}"
            bindtap="toggleTag"
          >{{item.value}}</button>
        </view>
      </view>

      <view class="xf-profile-actions">
        <button class="xf-profile-primary" bindtap="saveProfile">保存档案</button>
        <button class="xf-profile-secondary" bindtap="openXiaowanzi">找小玩子</button>
      </view>
    </view>
    <view class="xf-profile-message">{{message}}</view>
    <view class="xf-profile-delete-zone">
      <button class="xf-profile-delete-child" bindtap="deleteChild">删除</button>
    </view>
  </scroll-view>
</view>
