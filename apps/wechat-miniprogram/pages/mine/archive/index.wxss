@import "../profile-panel.wxss";

.xf-archive-panel {
  padding-bottom: 56rpx;
}

.xf-profile-input-like {
  display: flex;
  align-items: center;
  width: 100%;
  height: 70rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe1ea;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #101335;
  font-size: 25rpx;
  font-weight: 850;
  padding: 0 24rpx;
}

.xf-profile-select-field {
  position: relative;
}

.xf-profile-select-like {
  justify-content: space-between;
  gap: 16rpx;
}

.xf-profile-select-like text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-profile-inline-options {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 12rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8c7ff;
  border-radius: 22rpx;
  background: #ffffff;
}

.xf-profile-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #101335;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 64rpx;
  text-align: left;
}

.xf-profile-option.is-active {
  background: #efe8ff;
  color: #6c27d6;
}
