@import "../../styles/native-list.wxss";

page {
  background: #f0edff;
}

.xf-welfare-page {
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  background: #f0edff;
  color: #17143d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.xf-welfare-scroll {
  box-sizing: border-box;
  padding: 0 40rpx 64rpx;
}

.xf-welfare-hero {
  position: relative;
  padding: 52rpx 0 34rpx;
}

.xf-welfare-pill {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 74rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #5d52db;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 44rpx rgba(82, 72, 160, 0.1);
}

.xf-welfare-pill image {
  width: 44rpx;
  height: 44rpx;
}

.xf-welfare-hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 28rpx;
  margin-top: 32rpx;
}

.xf-welfare-hero-copy {
  min-width: 0;
}

.xf-welfare-title {
  display: block;
  color: #15123f;
  font-size: 72rpx;
  font-weight: 950;
  line-height: 1.08;
}

.xf-welfare-subtitle {
  display: block;
  margin-top: 22rpx;
  color: #8a84a0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.7;
}

.xf-welfare-mascot {
  flex: 0 0 auto;
  width: 184rpx;
  height: 184rpx;
  margin-top: -48rpx;
}

.xf-welfare-card,
.xf-welfare-history {
  box-sizing: border-box;
  padding: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.36);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.xf-welfare-section-head,
.xf-welfare-history-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
  color: #15123f;
  font-size: 40rpx;
  font-weight: 950;
}

.xf-welfare-section-head image {
  width: 44rpx;
  height: 44rpx;
}

.xf-welfare-state {
  box-sizing: border-box;
  padding: 42rpx 36rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #8a84a0;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: center;
}

.xf-welfare-list,
.xf-welfare-history {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.xf-welfare-message {
  margin-top: 24rpx;
  padding: 24rpx 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #5e43e6;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.6;
  box-shadow: 0 16rpx 38rpx rgba(77, 69, 148, 0.08);
}

.xf-welfare-history {
  margin-top: 34rpx;
}

.xf-welfare-history-head {
  justify-content: space-between;
  margin-bottom: 4rpx;
  font-size: 36rpx;
}

.xf-welfare-history-head text:last-child {
  color: #9b95aa;
  font-size: 22rpx;
}

.xf-welfare-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 44rpx rgba(77, 69, 148, 0.1);
}

.xf-welfare-item.is-history {
  opacity: 0.72;
}

.xf-welfare-item-cover {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #f1ecff;
}

.xf-welfare-item-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-welfare-item-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.xf-welfare-item-title {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #17143d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-welfare-item-status {
  flex: 0 0 auto;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f2efff;
  color: #5e43e6;
  font-size: 20rpx;
  font-weight: 900;
}

.xf-welfare-item-desc,
.xf-welfare-item-stock {
  display: block;
  margin-top: 8rpx;
  color: #8d879b;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.45;
}

.xf-welfare-item-stock {
  color: #aaa3b8;
  font-size: 22rpx;
}

.xf-welfare-claim {
  flex: 0 0 auto;
  min-width: 132rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: #5f50eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 72rpx;
  box-shadow: 0 14rpx 30rpx rgba(95, 80, 235, 0.28);
}

.xf-welfare-claim::after {
  border: 0;
}

.xf-welfare-claim.is-disabled,
.xf-welfare-claim[disabled] {
  background: #eceaf4;
  color: #9b95aa;
  box-shadow: none;
}
