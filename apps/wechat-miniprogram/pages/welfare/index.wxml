<view class="xf-welfare-page {{fontSizeClass}}" style="padding-top: {{chromeHeight}}px;">
  <view class="xf-native-topbar" style="height: {{topbarHeight}}px;">
    <view class="xf-native-nav-row" style="height: {{topbarHeight}}px;">
      <view class="xf-native-menu-button xf-native-back-button" style="top: {{backTop}}px; width: {{backSize}}px; height: {{backSize}}px;" catchtap="goBack" role="button" aria-label="返回">
        <view class="xf-native-back-icon" aria-hidden="true"></view>
      </view>
      <image class="xf-native-logo" style="top: {{logoTop}}px; height: {{logoHeight}}px;" src="/assets/nav/logo.png" mode="aspectFit" bindtap="goProgramsHome" aria-label="回到首页" />
    </view>
  </view>

  <scroll-view class="xf-welfare-scroll" style="height: calc(100vh - {{chromeHeight}}px);" scroll-y enhanced show-scrollbar="false">
    <view class="xf-welfare-hero">
      <view class="xf-welfare-pill">
        <image src="/assets/menu/welfare-gift-icon.png" mode="aspectFit" />
        <text>我的福利</text>
      </view>
      <view class="xf-welfare-hero-row">
        <view class="xf-welfare-hero-copy">
          <text class="xf-welfare-title">小玩子百宝箱</text>
          <text class="xf-welfare-subtitle">福利多多，好运多多</text>
        </view>
        <image class="xf-welfare-mascot" src="/assets/wel-avatar/wizard.png" mode="aspectFit" />
      </view>
    </view>

    <view class="xf-welfare-card">
      <view class="xf-welfare-section-head">
        <image src="/assets/menu/welfare-gift-icon.png" mode="aspectFit" />
        <text>可领取福利</text>
      </view>

      <view wx:if="{{loading}}" class="xf-welfare-state">正在打开百宝箱...</view>
      <view wx:elif="{{activeCampaigns.length === 0}}" class="xf-welfare-state">今天没有新的福利，过几天再来看看。</view>
      <view wx:else class="xf-welfare-list">
        <view wx:for="{{activeCampaigns}}" wx:key="_id" class="xf-welfare-item">
          <image class="xf-welfare-item-cover" src="{{item.coverImageUrl}}" mode="aspectFit" />
          <view class="xf-welfare-item-copy">
            <view class="xf-welfare-item-title-row">
              <text class="xf-welfare-item-title">{{item.title}}</text>
              <text class="xf-welfare-item-status">{{item.statusText}}</text>
            </view>
            <text class="xf-welfare-item-desc">{{item.subtitle}}</text>
            <text class="xf-welfare-item-stock">{{item.stockText}}</text>
          </view>
          <button class="xf-welfare-claim {{item.unavailable ? 'is-disabled' : ''}}" disabled="{{item.unavailable || claimingId === item._id}}" data-id="{{item._id}}" bindtap="claimWelfare">{{claimingId === item._id ? "领取中" : item.actionText}}</button>
        </view>
      </view>
    </view>

    <view wx:if="{{message}}" class="xf-welfare-message">{{message}}</view>

    <view wx:if="{{historyCampaigns.length}}" class="xf-welfare-history">
      <view class="xf-welfare-history-head">
        <text>历史福利</text>
        <text>历史内容</text>
      </view>
      <view wx:for="{{historyCampaigns}}" wx:key="_id" class="xf-welfare-item is-history">
        <image class="xf-welfare-item-cover" src="{{item.coverImageUrl}}" mode="aspectFit" />
        <view class="xf-welfare-item-copy">
          <view class="xf-welfare-item-title-row">
            <text class="xf-welfare-item-title">{{item.title}}</text>
            <text class="xf-welfare-item-status">{{item.statusText}}</text>
          </view>
          <text class="xf-welfare-item-desc">{{item.subtitle}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
