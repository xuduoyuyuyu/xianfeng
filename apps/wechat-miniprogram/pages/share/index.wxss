.xf-share-page {
  min-height: 100vh;
  padding: 150rpx 44rpx 72rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 74% 2%, rgba(255, 228, 236, 0.9) 0, rgba(255, 228, 236, 0) 34%),
    radial-gradient(circle at 16% 10%, rgba(211, 218, 255, 0.92) 0, rgba(211, 218, 255, 0) 40%),
    linear-gradient(180deg, #f8f7fc 0%, #eef2ff 100%);
}

.xf-share-card {
  padding: 56rpx 40rpx 44rpx;
  border-radius: 44rpx;
  background: #f7f4ff;
  border: 2rpx solid rgba(94, 23, 235, 0.16);
  box-shadow: 0 24rpx 72rpx rgba(52, 24, 92, 0.12);
}

.xf-share-logo {
  width: 176rpx;
  height: 176rpx;
  display: block;
  border-radius: 40rpx;
  margin: 0 auto 34rpx;
  box-shadow: 0 18rpx 44rpx rgba(94, 23, 235, 0.24);
}

.xf-share-kicker {
  display: block;
  text-align: center;
  color: #5e17eb;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.xf-share-title {
  display: block;
  text-align: center;
  color: #22152d;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
  margin-bottom: 26rpx;
}

.xf-share-subtitle {
  display: block;
  color: #5f566b;
  font-size: 30rpx;
  line-height: 1.72;
  text-align: center;
  margin-bottom: 40rpx;
}

.xf-share-primary,
.xf-share-secondary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0;
}

.xf-share-primary {
  color: #ffffff;
  background: #5e17eb;
}

.xf-share-secondary {
  margin-top: 20rpx;
  color: #5e17eb;
  background: rgba(94, 23, 235, 0.1);
}

.xf-share-conversation {
  position: relative;
  padding-bottom: 64rpx;
}

.xf-share-readonly-head {
  margin-bottom: 44rpx;
}

.xf-share-brand {
  display: block;
  width: 222rpx;
  height: 72rpx;
  margin: 0 auto;
}

.xf-share-messages {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.xf-share-message {
  position: relative;
  display: flex;
  box-sizing: border-box;
  max-width: 100%;
}

.xf-share-message.is-user {
  justify-content: flex-end;
}

.xf-share-message.is-assistant {
  justify-content: flex-start;
}

.xf-share-user-bubble {
  max-width: 584rpx;
  box-sizing: border-box;
  padding: 22rpx 30rpx 26rpx;
  border-radius: 34rpx 8rpx 34rpx 34rpx;
  background: linear-gradient(108deg, #5368ff 0%, #6847ff 56%, #601bec 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.75;
  text-align: left;
  box-shadow: 0 14rpx 32rpx rgba(96, 27, 236, 0.2);
}

.xf-share-assistant-card {
  box-sizing: border-box;
  width: 100%;
  padding: 30rpx 30rpx 32rpx;
  border: 1rpx solid rgba(122, 103, 238, 0.1);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #11143b;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.82;
  box-shadow:
    0 10rpx 24rpx rgba(72, 75, 132, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.xf-share-message-text {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.78;
  white-space: pre-wrap;
}

.xf-share-md-heading {
  display: block;
  margin: 24rpx 0 12rpx;
  color: #111936;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.56;
}

.xf-share-md-heading:first-child {
  margin-top: 0;
}

.xf-share-md-paragraph {
  display: block;
  margin: 0 0 22rpx;
  color: #11143b;
  font-size: 28rpx;
  font-weight: inherit;
  line-height: 1.82;
  white-space: pre-wrap;
}

.xf-share-md-paragraph:last-child {
  margin-bottom: 0;
}

.xf-share-md-list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 10rpx 0;
  color: #11143b;
  font-size: 28rpx;
  font-weight: inherit;
  line-height: 1.72;
}

.xf-share-md-list-bullet {
  flex: 0 0 18rpx;
  width: 18rpx;
  color: #6d28f2;
  font-weight: 500;
  line-height: inherit;
}

.xf-share-md-list-text {
  flex: 1 1 auto;
  min-width: 0;
  line-height: inherit;
}

.xf-share-message-link {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 100%;
  min-height: 88rpx;
  margin: 2rpx 0 4rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(115, 83, 224, 0.24);
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(126, 95, 255, 0.14) 0%, rgba(217, 196, 255, 0.22) 100%);
  box-sizing: border-box;
  color: #6845e8;
  font: inherit;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.34;
  text-align: left;
  box-shadow:
    0 12rpx 24rpx rgba(100, 82, 186, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.xf-share-message-link-body {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-share-message-link-arrow {
  flex: 0 0 auto;
  margin-left: 18rpx;
  color: #6d28f2;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.xf-share-message-link-text {
  display: -webkit-box;
  color: #2a2350;
  overflow-wrap: anywhere;
  word-break: break-word;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.xf-share-references {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(124, 52, 232, 0.12);
}

.xf-share-references-title {
  display: block;
  margin-bottom: 14rpx;
  color: #6d28f2;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.xf-share-reference-link {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  width: 100%;
  min-height: 54rpx;
  margin: 0;
  padding: 8rpx 0;
  border: 0;
  background: transparent;
  color: #2a2350;
  font: inherit;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.48;
  text-align: left;
}

.xf-share-reference-index {
  flex: 0 0 auto;
  color: #6d28f2;
}

.xf-share-reference-title {
  flex: 1 1 auto;
  min-width: 0;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.xf-share-reference-arrow {
  flex: 0 0 auto;
  color: #6d28f2;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.48;
}

.xf-share-ai-note {
  display: block;
  margin: 30rpx 0 0 34rpx;
  color: #a6adc2;
  font-size: 24rpx;
  line-height: 1.4;
}

.xf-share-open-xiaowanzi {
  display: block;
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 160rpx auto 0;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(108deg, #5368ff 0%, #6847ff 56%, #601bec 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 24rpx 44rpx rgba(96, 27, 236, 0.24);
}

.xf-share-open-xiaowanzi::after {
  border: 0;
}
