.xf-share-page {
  min-height: 100vh;
  padding: 156rpx 44rpx 64rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 74% 2%, rgba(255, 228, 236, 0.9) 0, rgba(255, 228, 236, 0) 34%),
    radial-gradient(circle at 16% 10%, rgba(211, 218, 255, 0.92) 0, rgba(211, 218, 255, 0) 40%),
    linear-gradient(180deg, #f2f1ff 0%, #e9edff 100%);
}

.xf-share-card {
  padding: 56rpx 40rpx 44rpx;
  border-radius: 44rpx;
  background: #f7f4ff;
  border: 2rpx solid rgba(94, 23, 235, 0.16);
  box-shadow: 0 24rpx 72rpx rgba(52, 24, 92, 0.12);
}

.xf-share-logo {
  width: 176rpx;
  height: 176rpx;
  display: block;
  border-radius: 40rpx;
  margin: 0 auto 34rpx;
  box-shadow: 0 18rpx 44rpx rgba(94, 23, 235, 0.24);
}

.xf-share-kicker {
  display: block;
  text-align: center;
  color: #5e17eb;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.xf-share-title {
  display: block;
  text-align: center;
  color: #22152d;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
  margin-bottom: 26rpx;
}

.xf-share-subtitle {
  display: block;
  color: #5f566b;
  font-size: 30rpx;
  line-height: 1.72;
  text-align: center;
  margin-bottom: 40rpx;
}

.xf-share-primary,
.xf-share-secondary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0;
}

.xf-share-primary {
  color: #ffffff;
  background: #5e17eb;
}

.xf-share-secondary {
  margin-top: 20rpx;
  color: #5e17eb;
  background: rgba(94, 23, 235, 0.1);
}

.xf-share-conversation {
  position: relative;
  padding-bottom: 120rpx;
}

.xf-share-brand {
  display: block;
  width: 220rpx;
  height: 72rpx;
  margin: 0 auto 58rpx;
}

.xf-share-messages {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.xf-share-message {
  box-sizing: border-box;
  max-width: 100%;
}

.xf-share-message.is-user {
  align-self: flex-end;
  max-width: 78%;
  padding: 26rpx 34rpx;
  border-radius: 34rpx 34rpx 8rpx 34rpx;
  background: linear-gradient(135deg, #5b66ff 0%, #6d28f2 100%);
  color: #ffffff;
  text-align: left;
  box-shadow: 0 22rpx 44rpx rgba(109, 40, 242, 0.24);
}

.xf-share-message.is-assistant {
  padding: 36rpx 34rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #111936;
  box-shadow: 0 18rpx 48rpx rgba(70, 73, 132, 0.08);
}

.xf-share-message-text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.78;
  white-space: pre-wrap;
}

.xf-share-ai-note {
  display: block;
  margin: 24rpx 0 0 34rpx;
  color: #a6adc2;
  font-size: 24rpx;
  line-height: 1.4;
}

.xf-share-open-xiaowanzi {
  position: fixed;
  left: 50%;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  min-width: 280rpx;
  height: 78rpx;
  padding: 0 42rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5b66ff 0%, #6d28f2 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 78rpx;
  box-shadow: 0 20rpx 44rpx rgba(109, 40, 242, 0.24);
}
