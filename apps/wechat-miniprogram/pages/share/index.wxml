<view class="xf-share-page {{fontSizeClass}}">
  <view wx:if="{{conversationShare}}" class="xf-share-conversation">
    <view class="xf-share-readonly-head">
      <image class="xf-share-brand" src="/assets/xiaowanzi-icons/share-logo.png" mode="aspectFit" />
    </view>
    <view class="xf-share-messages">
      <view
        wx:for="{{conversationShare.messages}}"
        wx:key="key"
        class="xf-share-message is-{{item.role}}"
      >
        <view wx:if="{{item.role === 'user'}}" class="xf-share-user-bubble">
          <text>{{item.content}}</text>
        </view>
        <view wx:else class="xf-share-assistant-card">
          <block wx:for="{{item.contentParts}}" wx:for-item="part" wx:key="key">
            <view wx:if="{{part.type === 'md_heading'}}" class="xf-share-md-heading">{{part.text}}</view>
            <view wx:elif="{{part.type === 'md_list_item'}}" class="xf-share-md-list-item">
              <text class="xf-share-md-list-bullet">•</text>
              <text class="xf-share-md-list-text">{{part.text}}</text>
            </view>
            <view wx:elif="{{part.type === 'md_paragraph'}}" class="xf-share-md-paragraph">{{part.text}}</view>
            <text wx:elif="{{part.type !== 'link'}}" class="xf-share-message-text">{{part.text}}</text>
            <view wx:else class="xf-share-message-link is-readonly">
              <view class="xf-share-message-link-body">
                <text class="xf-share-message-link-text">{{part.text}}</text>
              </view>
              <text class="xf-share-message-link-arrow">↗</text>
            </view>
          </block>
          <view wx:if="{{item.references.length}}" class="xf-share-references">
            <text class="xf-share-references-title">站内引用</text>
            <view
              wx:for="{{item.references}}"
              wx:for-item="reference"
              wx:key="key"
              class="xf-share-reference-link"
            >
              <text class="xf-share-reference-index">{{index + 1}}</text>
              <text class="xf-share-reference-title">{{reference.title}}</text>
              <text class="xf-share-reference-arrow">↗</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <text class="xf-share-ai-note">内容由AI生成</text>
    <button class="xf-share-open-xiaowanzi" bindtap="openTarget">打开小玩子</button>
  </view>
  <view wx:elif="{{shareLoading}}" class="xf-share-card">
    <image class="xf-share-logo" src="/assets/share/timeline-logo.png" mode="aspectFill" />
    <text class="xf-share-title">正在打开分享内容</text>
  </view>
  <view wx:elif="{{shareError}}" class="xf-share-card">
    <image class="xf-share-logo" src="/assets/share/timeline-logo.png" mode="aspectFill" />
    <text class="xf-share-title">{{shareError}}</text>
    <button class="xf-share-secondary" bindtap="goPrograms">先逛逛节目</button>
  </view>
  <view wx:else class="xf-share-card">
    <image class="xf-share-logo" src="/assets/share/timeline-logo.png" mode="aspectFill" />
    <text class="xf-share-kicker">家长先疯</text>
    <text class="xf-share-title">{{title}}</text>
    <text class="xf-share-subtitle">家长先疯把节目、书单、资料和请教内容放在一起，方便你随时回到正在关心的问题。</text>
    <button class="xf-share-primary" bindtap="openTarget">打开分享内容</button>
    <button class="xf-share-secondary" bindtap="goPrograms">先逛逛节目</button>
  </view>
</view>
