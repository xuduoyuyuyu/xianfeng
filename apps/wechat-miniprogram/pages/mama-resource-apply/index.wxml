<import src="../../templates/settings-profile-views.wxml" />

<view class="xf-mama-page {{fontSizeClass}}" style="padding-top: {{chromeHeight}}px;">
  <view class="xf-native-topbar" style="height: {{topbarHeight}}px;">
    <view class="xf-native-nav-row" style="height: {{topbarHeight}}px;">
      <view class="xf-native-menu-button xf-native-back-button" style="top: {{backTop}}px; width: {{backSize}}px; height: {{backSize}}px;" catchtap="goBack" role="button" aria-label="返回">
        <view class="xf-native-back-icon" aria-hidden="true"></view>
      </view>
      <image class="xf-native-logo" style="top: {{logoTop}}px; height: {{logoHeight}}px;" src="/assets/nav/logo.png" mode="aspectFit" bindtap="goProgramsHome" aria-label="回到顶部" />
      <button class="xf-native-welfare-button" style="top: {{logoTop}}px; right: {{welfareRight}}px; height: {{logoHeight}}px;" catchtap="openWelfare" aria-label="百宝箱">
        <image class="xf-native-welfare-icon" src="/assets/menu/welfare-gift-icon.png" mode="aspectFit" aria-hidden="true" />
      </button>
    </view>
  </view>

  <view class="xf-mama-content">
    <block wx:if="{{!isLoggedIn}}">
      <view class="xf-mama-card xf-mama-login-card">
        <image class="xf-mama-login-icon" src="/assets/menu/mama-hao-zhuan-icon.png" mode="aspectFit" aria-hidden="true" />
        <text class="xf-mama-info-kicker">进入好赚</text>
        <text class="xf-mama-login-title">手机号授权后查看任务</text>
        <text class="xf-mama-login-copy">授权成功后会直接展示任务，并使用你在家长先疯已有的信息预填资料。</text>
        <button class="xf-mama-submit" data-action="enter" open-type="getPhoneNumber" bindgetphonenumber="authorizeMamaResourceAction">授权手机号并查看任务</button>
      </view>
    </block>

    <block wx:elif="{{mamaResourceView === 'apply'}}">
      <view wx:if="{{profileManagerMode === 'onboarding'}}" class="xf-mama-card xf-mama-profile-onboarding">
        <view class="xf-mama-onboarding-head">
          <text class="xf-mama-info-kicker">只需完成一次</text>
          <text class="xf-mama-title">先完善资料，再继续任务</text>
          <text class="xf-mama-subtitle">任务不会丢失。完成后会自动回到刚才的任务继续操作。</text>
        </view>

        <view class="xf-mama-onboarding-progress">
          <view class="xf-mama-onboarding-progress-item is-active">
            <text class="xf-mama-onboarding-progress-number">1</text>
            <text>个人资料</text>
          </view>
          <view class="xf-mama-onboarding-progress-line {{profileOnboardingStep === 'media' ? 'is-active' : ''}}"></view>
          <view class="xf-mama-onboarding-progress-item {{profileOnboardingStep === 'media' ? 'is-active' : ''}}">
            <text class="xf-mama-onboarding-progress-number">2</text>
            <text>媒体账号</text>
          </view>
        </view>

        <view wx:if="{{profileOnboardingStep === 'personal'}}" class="xf-mama-onboarding-step">
          <text class="xf-mama-onboarding-step-kicker">第 1 步 · 完善个人资料</text>
          <text class="xf-mama-onboarding-step-title">用于联系和任务结算</text>
          <text class="xf-mama-onboarding-step-copy">填写姓名、微信和支付宝信息，保存后才会进入下一步。</text>
          <button class="xf-mama-submit" catchtap="openPersonalInfoEditor">填写个人资料</button>
        </view>

        <view wx:else class="xf-mama-onboarding-step">
          <text class="xf-mama-onboarding-step-kicker">第 2 步 · 添加社交媒体账号（选填）</text>
          <text class="xf-mama-onboarding-step-title">让运营更快匹配合适任务</text>
          <text class="xf-mama-onboarding-step-copy">可以添加小红书、抖音或视频号；暂时没有也可以先完成资料。</text>
          <view wx:if="{{profileOverview.accounts.length}}" class="xf-mama-onboarding-account-list">
            <view wx:for="{{profileOverview.accounts}}" wx:key="accountKey" class="xf-mama-info-account" data-source="{{item.sourceType}}" data-index="{{item.sourceIndex}}" catchtap="openMediaAccountEditor" role="button" aria-label="编辑账号 {{item.title}}">
              <view class="xf-mama-info-account-head">
                <view class="xf-mama-platform-logo {{item.platformLogoClass}}">
                  <image wx:if="{{item.platformLogoUrl}}" class="xf-mama-platform-logo-image" src="{{item.platformLogoUrl}}" mode="aspectFill" />
                  <text wx:else>{{item.platformLogoText}}</text>
                </view>
                <view class="xf-mama-info-account-body">
                  <text class="xf-mama-info-account-title">{{item.title}}</text>
                  <text class="xf-mama-info-account-summary">{{item.summary}}</text>
                </view>
                <text class="xf-mama-info-account-edit">编辑</text>
              </view>
            </view>
          </view>
          <button type="button" class="xf-mama-onboarding-add" catchtap="openNewMediaAccount">{{profileOverview.accounts.length ? "继续添加账号" : "添加媒体账号"}}</button>
          <view wx:if="{{message}}" class="xf-mama-message {{messageType}}">{{message}}</view>
          <button class="xf-mama-submit" disabled="{{submitting}}" catchtap="completeProfileOnboarding">{{submitting ? "保存中..." : (pendingProfileAction === "open-task" ? "保存资料并查看任务" : (pendingProfileAction === "claim" ? "保存资料并继续领取" : (pendingProfileAction === "proof" ? "保存资料并继续提交" : "保存资料并返回任务")))}}</button>
        </view>

        <button type="button" class="xf-mama-onboarding-back" catchtap="cancelProfileOnboarding">返回任务</button>
      </view>

      <view wx:else class="xf-mama-card xf-mama-profile-manager">
        <view class="xf-mama-head">
          <view>
            <text class="xf-mama-title">资料管理</text>
            <text class="xf-mama-subtitle">这里是资料总览，个人资料和社交媒体账号独立维护</text>
          </view>
        </view>

        <view class="xf-mama-info-list">
          <view class="xf-mama-info-row is-personal" catchtap="openPersonalInfoEditor">
            <view>
              <text class="xf-mama-info-kicker">第一步</text>
              <text class="xf-mama-info-title">个人资料</text>
              <text class="xf-mama-info-copy">{{profileOverview.personalSummary}}</text>
            </view>
            <text class="xf-mama-info-action">编辑</text>
          </view>

          <view class="xf-mama-account-section">
            <view class="xf-mama-account-section-head">
              <view>
                <text class="xf-mama-info-kicker">第二步</text>
                <text class="xf-mama-info-title">社交媒体账号</text>
                <text class="xf-mama-info-copy">{{profileOverview.mediaSummary}}</text>
              </view>
              <button type="button" class="xf-mama-account-add-compact" catchtap="openNewMediaAccount">＋ 添加</button>
            </view>
            <view wx:if="{{!profileOverview.accounts.length}}" class="xf-mama-account-empty">
              <text class="xf-mama-account-empty-title">还没有账号</text>
              <text class="xf-mama-account-empty-copy">先添加常用的小红书账号，之后可继续添加抖音或视频号账号。</text>
            </view>
            <view wx:for="{{profileOverview.accounts}}" wx:key="accountKey" class="xf-mama-info-account" data-source="{{item.sourceType}}" data-index="{{item.sourceIndex}}" catchtap="openMediaAccountEditor" role="button" aria-label="编辑账号 {{item.title}}">
              <view class="xf-mama-info-account-head">
                <view class="xf-mama-platform-logo {{item.platformLogoClass}}">
                  <image wx:if="{{item.platformLogoUrl}}" class="xf-mama-platform-logo-image" src="{{item.platformLogoUrl}}" mode="aspectFill" />
                  <text wx:else>{{item.platformLogoText}}</text>
                </view>
                <view class="xf-mama-info-account-body">
                  <text class="xf-mama-info-account-title">{{item.title}}</text>
                  <text class="xf-mama-info-account-summary">{{item.summary}}</text>
                </view>
                <text class="xf-mama-info-account-edit">编辑</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{message}}" class="xf-mama-message {{messageType}}">{{message}}</view>
        <button class="xf-mama-submit" data-action="save" open-type="{{isLoggedIn ? '' : 'getPhoneNumber'}}" bindgetphonenumber="authorizeMamaResourceAction" disabled="{{submitting}}" catchtap="submitProfileDraft">{{submitting ? "保存中..." : "保存资料"}}</button>
      </view>

      <view wx:if="{{personalInfoModalOpen}}" class="xf-mama-account-mask" catchtap="closePersonalInfoModal">
        <scroll-view class="xf-mama-account-dialog" scroll-y catchtap="keepMediaAccountModalOpen">
          <form bindsubmit="savePersonalInfo">
            <view class="xf-mama-account-dialog-head">
              <view>
                <text class="xf-mama-account-dialog-kicker">个人资料</text>
                <text class="xf-mama-account-dialog-title">编辑个人信息</text>
              </view>
              <view class="xf-mama-account-dialog-close" catchtap="closePersonalInfoModal" role="button" aria-label="关闭">×</view>
            </view>

            <view class="xf-mama-grid">
              <label class="xf-mama-field">姓名/昵称<text class="xf-mama-required">*</text><input name="displayName" value="{{personalInfoDraft.displayName}}" data-field="displayName" bindinput="updatePersonalInfoDraftField" placeholder="例如：安安妈妈" placeholder-class="xf-mama-placeholder" /></label>
              <label class="xf-mama-field">微信号<text class="xf-mama-required">*</text><input name="contactWechat" value="{{personalInfoDraft.contactWechat}}" data-field="contactWechat" bindinput="updatePersonalInfoDraftField" placeholder="优先通过微信添加" placeholder-class="xf-mama-placeholder" /></label>
              <label class="xf-mama-field">手机号<input name="contactPhone" value="{{personalInfoDraft.contactPhone}}" data-field="contactPhone" bindinput="updatePersonalInfoDraftField" placeholder="备用联系电话" placeholder-class="xf-mama-placeholder" /></label>
              <label class="xf-mama-field">支付宝账号<text class="xf-mama-required">*</text><input name="alipayAccount" value="{{personalInfoDraft.alipayAccount}}" data-field="alipayAccount" bindinput="updatePersonalInfoDraftField" placeholder="用于任务结算转账" placeholder-class="xf-mama-placeholder" /></label>
              <label class="xf-mama-field">支付宝验证姓名<text class="xf-mama-required">*</text><input name="alipayVerifiedName" value="{{personalInfoDraft.alipayVerifiedName}}" data-field="alipayVerifiedName" bindinput="updatePersonalInfoDraftField" placeholder="支付宝实名认证姓名" placeholder-class="xf-mama-placeholder" /></label>
            </view>
            <view class="xf-mama-field">
              孩子档案
              <view wx:if="{{hasArchiveChildren}}" class="xf-mama-archive-link" catchtap="openChildArchive"><text class="xf-mama-archive-value">{{archiveChildrenText}}</text><text>›</text></view>
              <view wx:else class="xf-mama-archive-link" catchtap="openChildCreate">添加孩子 <text>›</text></view>
            </view>
            <view class="xf-mama-field">
              <text>创作能力</text>
              <view class="xf-mama-chips">
                <button wx:for="{{personalInfoCapabilityOptions}}" wx:key="label" class="xf-mama-chip {{item.selected ? 'is-active' : ''}}" data-value="{{item.label}}" catchtap="togglePersonalContentCapability" aria-label="选择创作能力 {{item.label}}">{{item.label}}</button>
              </view>
            </view>

            <text wx:if="{{personalInfoMessage}}" class="xf-mama-account-dialog-error">{{personalInfoMessage}}</text>
            <view class="xf-mama-account-dialog-actions">
              <button type="button" class="xf-mama-account-dialog-cancel" catchtap="closePersonalInfoModal">取消</button>
              <button form-type="submit" class="xf-mama-account-dialog-save">保存个人信息</button>
            </view>
          </form>
        </scroll-view>
      </view>

      <view wx:if="{{mediaAccountModalOpen}}" class="xf-mama-account-mask" catchtap="closeMediaAccountModal">
        <scroll-view class="xf-mama-account-dialog" scroll-y catchtap="keepMediaAccountModalOpen">
          <view class="xf-mama-account-dialog-head">
            <view>
              <text class="xf-mama-account-dialog-kicker">社交媒体账号</text>
              <text class="xf-mama-account-dialog-title">{{mediaAccountModalMode === 'edit' ? '编辑账号' : (mediaAccountModalSource === 'primary' ? '添加小红书账号' : '添加账号')}}</text>
            </view>
            <view class="xf-mama-account-dialog-close" catchtap="closeMediaAccountModal" role="button" aria-label="关闭">×</view>
          </view>

          <label class="xf-mama-field">
            平台
            <view wx:if="{{mediaAccountModalSource === 'primary'}}" class="xf-mama-picker is-locked">小红书</view>
            <picker wx:else mode="selector" range="{{mediaPlatformOptions}}" range-key="label" value="{{mediaAccountDraft.platformIndex}}" bindchange="selectMediaAccountDraftPlatform">
              <view class="xf-mama-picker">{{mediaAccountDraft.platformLabel}}</view>
            </picker>
          </label>
          <label class="xf-mama-field">账号昵称<text class="xf-mama-required">*</text><input value="{{mediaAccountDraft.nickname}}" data-field="nickname" bindinput="updateMediaAccountDraftField" placeholder="填写账号昵称" placeholder-class="xf-mama-placeholder" /></label>
          <label class="xf-mama-field">{{mediaAccountModalSource === 'primary' ? '小红书主页链接' : '主页链接'}}<text wx:if="{{mediaAccountModalSource === 'primary'}}" class="xf-mama-required">*</text><input value="{{mediaAccountDraft.profileUrl}}" data-field="profileUrl" bindinput="updateMediaAccountDraftField" placeholder="可粘贴整段口令或主页链接" placeholder-class="xf-mama-placeholder" /></label>
          <label class="xf-mama-field">粉丝数<input type="number" value="{{mediaAccountDraft.followerCount}}" data-field="followerCount" bindinput="updateMediaAccountDraftField" placeholder="例如：12800" placeholder-class="xf-mama-placeholder" /></label>

          <block wx:if="{{mediaAccountModalSource === 'primary'}}">
            <view class="xf-mama-field">
              <text>小红书页面截图</text>
              <button class="xf-mama-upload-button" type="button" loading="{{xiaohongshuScreenshotUploading}}" disabled="{{xiaohongshuScreenshotUploading}}" catchtap="chooseXiaohongshuScreenshot">
                {{mediaAccountDraft.screenshotUrl ? "已上传，重新选择" : "上传小红书主页截图"}}
              </button>
              <text class="xf-mama-upload-hint">{{xiaohongshuScreenshotUploading ? "截图上传中..." : (mediaAccountDraft.screenshotUrl ? "已上传，可继续保存" : "调用手机相册或相机上传截图")}}</text>
            </view>
          </block>
          <view class="xf-mama-field">
            <text>是否实名认证</text>
            <view class="xf-mama-gender-options">
              <button wx:for="{{realNameVerifiedOptions}}" wx:key="value" class="xf-mama-gender-chip {{(item.value === 'yes' && mediaAccountDraft.realNameVerified === true) || (item.value === 'no' && mediaAccountDraft.realNameVerified === false) ? 'is-active' : ''}}" data-value="{{item.value}}" catchtap="toggleMediaAccountDraftRealName" aria-label="选择实名认证状态 {{item.label}}">{{item.label}}</button>
            </view>
          </view>

          <text wx:if="{{mediaAccountMessage}}" class="xf-mama-account-dialog-error">{{mediaAccountMessage}}</text>
          <view class="xf-mama-account-dialog-actions">
            <button type="button" class="xf-mama-account-dialog-cancel" catchtap="closeMediaAccountModal">取消</button>
            <button type="button" class="xf-mama-account-dialog-save" catchtap="saveMediaAccountDraft">保存账号</button>
          </view>
          <button wx:if="{{mediaAccountModalMode === 'edit'}}" type="button" class="xf-mama-account-dialog-delete" catchtap="removeMediaAccountFromModal">删除这个账号</button>
        </scroll-view>
      </view>
    </block>

    <block wx:elif="{{mamaResourceView === 'reviewing'}}">
      <view class="xf-mama-review-card {{mamaResourceProfile.status}}">
        <view class="xf-mama-review-icon">{{mamaResourceProfile.status === "needs_info" ? "!" : (mamaResourceProfile.status === "rejected" ? "×" : "✓")}}</view>
        <text class="xf-mama-review-title">{{mamaResourceProfile.statusText || "资料已保存"}}</text>
        <text wx:if="{{mamaResourceProfile.status === 'pending'}}" class="xf-mama-review-copy">你的好赚资料已经保存，运营会按备注联系你。</text>
        <text wx:elif="{{mamaResourceProfile.status === 'needs_info'}}" class="xf-mama-review-copy">运营需要你补充或修正部分资料。补充后会继续用于任务匹配。</text>
        <text wx:elif="{{mamaResourceProfile.status === 'rejected'}}" class="xf-mama-review-copy">当前资料暂未通过本期任务匹配。你可以按运营建议调整后重新提交。</text>
        <text wx:else class="xf-mama-review-copy">资料状态已更新，请稍后刷新查看最新结果。</text>

        <view class="xf-mama-review-info">
          <view>
            <text>提交账号</text>
            <text>{{mamaResourceProfile.displayName || "未记录"}}</text>
          </view>
          <view>
            <text>提交时间</text>
            <text>{{mamaResourceProfile.submittedDateText || "刚刚提交"}}</text>
          </view>
          <view>
            <text>可发品类</text>
            <text>{{mamaResourceProfile.categoriesText || "待运营确认"}}</text>
          </view>
        </view>

        <view wx:if="{{mamaResourceProfile.reviewMessage}}" class="xf-mama-review-note">
          <text>运营备注</text>
          <text>{{mamaResourceProfile.reviewMessage}}</text>
        </view>

        <view class="xf-mama-review-next">
          <text>资料保存后会进入任务中心，任务会以项目列表展示，可进入详情提交链接和完成截图。</text>
        </view>

        <button class="xf-mama-review-action" catchtap="openProfileManager">
          资料管理
        </button>
      </view>
    </block>

    <block wx:elif="{{mamaResourceView === 'tasks'}}">
      <view class="xf-mama-task-hero">
        <image class="xf-mama-task-mascot" src="/assets/menu/mama-hao-zhuan-icon.png" mode="aspectFit" />
        <view class="xf-mama-task-identity">
          <view class="xf-mama-task-hero-copy">
            <text class="xf-mama-task-title">好赚</text>
            <text class="xf-mama-task-subtitle">{{mamaResourceProfile ? (mamaResourceProfile.displayName || "已完善资料") : "先选任务，打开后完善资料"}}</text>
          </view>
        </view>
        <button wx:if="{{mamaResourceProfile}}" class="xf-mama-task-manage" catchtap="openProfileManager">资料管理</button>
        <view wx:if="{{mamaResourceProfile && mamaResourceProfile.publicUid}}" class="xf-mama-task-uid-row" catchtap="copyMamaUid" role="button" aria-label="复制UID {{mamaResourceProfile.publicUid}}">
          <text class="xf-mama-task-uid-label">UID {{mamaResourceProfile.publicUid}}</text>
          <view class="xf-mama-task-uid-copy" aria-hidden="true">
            <view class="xf-mama-task-copy-icon" aria-hidden="true"></view>
          </view>
        </view>
      </view>

      <view class="xf-mama-task-section">
        <view wx:if="{{mamaTasksLoading}}" class="xf-mama-task-empty">任务加载中...</view>
        <view wx:elif="{{mamaTasks.length === 0}}" class="xf-mama-task-empty">暂无可领取任务，运营上架后会显示在这里。</view>
        <view wx:else class="xf-mama-task-list">
          <view wx:for="{{mamaTasks}}" wx:key="_id" class="xf-mama-task-row" data-id="{{item._id}}" catchtap="openMamaTask">
            <view class="xf-mama-task-row-head">
              <image class="xf-mama-task-logo" src="/assets/menu/mama-hao-zhuan-icon.png" mode="aspectFit" />
              <view class="xf-mama-task-main">
                <text class="xf-mama-task-name">{{item.title}}</text>
                <text class="xf-mama-task-meta">{{item.category}} · {{item.dataCycle || "T+9"}}</text>
              </view>
              <view class="xf-mama-task-price-group">
                <text class="xf-mama-task-price-label">任务单价</text>
                <text class="xf-mama-task-price">{{item.unitPriceText}}</text>
                <text wx:if="{{item.hasTrafficFee}}" class="xf-mama-task-traffic">投流补贴 {{item.trafficFeeText}}</text>
              </view>
            </view>
            <view class="xf-mama-task-stats">
              <text>{{item.statusText}}</text>
              <text>推广 {{item.promotionCountText}} 人</text>
              <text>{{item.remainingClaimText}}</text>
              <text wx:if="{{item.hasContentUrl}}">内容已下发</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <block wx:elif="{{mamaResourceView === 'detail'}}">
      <view class="xf-mama-detail-shell">
        <view class="xf-mama-detail-hero">
          <view class="xf-mama-detail-back" catchtap="backToMamaTasks">‹</view>
          <view class="xf-mama-detail-brand">
            <image class="xf-mama-detail-logo" src="/assets/menu/mama-hao-zhuan-icon.png" mode="aspectFit" />
            <view class="xf-mama-detail-copy">
              <text class="xf-mama-detail-title">{{currentMamaTask.title || "任推邦（红薯）评论"}}</text>
              <view class="xf-mama-detail-meta-row">
                <view class="xf-mama-detail-tags">
                  <text>{{currentMamaTask.difficulty || "简单"}}</text>
                  <text>{{currentMamaTask.phase || "测试期"}}</text>
                  <text>{{currentMamaTask.category || "小红书评论"}}</text>
                </view>
                <button class="xf-mama-detail-share-icon" disabled="{{taskShareGenerating}}" catchtap="openMamaTaskSharePoster" aria-label="生成任务分享图">
                  <text aria-hidden="true">↗</text>
                </button>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{currentMamaTask.announcement}}" class="xf-mama-notice-row" catchtap="openTaskAnnouncement">
          <text class="xf-mama-notice-badge">公告</text>
          <text>{{currentMamaTask.announcement}}</text>
          <text class="xf-mama-task-chevron">›</text>
        </view>

        <view class="xf-mama-project-card">
          <view class="xf-mama-project-title">项目信息</view>
          <view class="xf-mama-section-title">项目价格</view>
          <view class="xf-mama-price-table">
            <view>任务</view>
            <view>价格</view>
            <view>投流补贴</view>
            <view>结算周期</view>
            <view>{{currentMamaTask.category || "小红书评论"}}</view>
            <view class="is-price">{{currentMamaTask.unitPriceText}}</view>
            <view>{{currentMamaTask.hasTrafficFee ? currentMamaTask.trafficFeeText : "-"}}</view>
            <view>{{currentMamaTask.settlementCycle || "T+9"}}</view>
          </view>

          <view class="xf-mama-fold-row">
            <text>结算标准</text>
            <text>{{currentMamaTask.settlementStandard || "按项目要求发布并保留，后台审核通过后结算。"}}</text>
          </view>
          <view class="xf-mama-fold-row">
            <text>项目要求</text>
            <text>{{currentMamaTask.requirement || "提交小红书笔记链接和完成截图，否则无法结算。"}}</text>
            <view wx:if="{{currentMamaTask.exampleImageUrls.length}}" class="xf-mama-example-gallery">
              <image wx:for="{{currentMamaTask.exampleImageUrls}}" wx:key="*this" class="xf-mama-example-image" src="{{item}}" mode="widthFix" data-index="{{index}}" catchtap="previewTaskExampleImage" />
            </view>
          </view>

          <view wx:if="{{currentMamaTask.hasContentUrl}}" class="xf-mama-content-card">
            <view>
              <text class="xf-mama-content-title">你的专属任务内容</text>
              <text class="xf-mama-content-hint">打开后下载图片、复制文案并按要求发布</text>
            </view>
            <button type="button" class="xf-mama-content-button" catchtap="openMamaTaskContent">打开专属内容</button>
          </view>

          <view wx:if="{{currentMamaTask.isClaimable}}" class="xf-mama-task-actions">
            <text class="xf-mama-claim-note">此操作只是领取任务。领取后请等待运营下发具体内容链接并完成审核，内容下发前无需填写反馈。</text>
            <button class="xf-mama-submit" data-action="claim" open-type="{{isLoggedIn ? '' : 'getPhoneNumber'}}" bindgetphonenumber="authorizeMamaResourceAction" disabled="{{taskClaiming}}" catchtap="claimMamaTask">{{taskClaiming ? "领取中..." : "立即领取"}}</button>
          </view>

          <view wx:if="{{!currentMamaTask.isClaimable && !currentMamaTask.hasContentUrl}}" class="xf-mama-waiting-card">
            <text class="xf-mama-waiting-title">已领取，等待运营下发</text>
            <text class="xf-mama-waiting-copy">当前只是领取任务。运营审核后会下发具体内容链接，收到内容后再按要求完成并提交反馈。</text>
          </view>

          <view wx:if="{{taskMessage}}" class="xf-mama-message {{taskMessageType}}">{{taskMessage}}</view>

          <view wx:if="{{!currentMamaTask.isClaimable && currentMamaTask.hasContentUrl}}" class="xf-mama-proof-card">
            <text class="xf-mama-section-title">完成证明</text>
            <label class="xf-mama-field">完成链接<input value="{{taskProofLink}}" bindinput="updateTaskProofLink" placeholder="粘贴笔记内容" placeholder-class="xf-mama-placeholder" /></label>
            <button class="xf-mama-upload-button" type="button" loading="{{taskProofScreenshotUploading}}" disabled="{{taskProofScreenshotUploading}}" catchtap="chooseTaskProofScreenshot">
              {{taskProofScreenshotUrl ? "已上传，重新选择" : "上传完成截图"}}
            </button>
            <text class="xf-mama-upload-hint">{{taskProofScreenshotUploading ? "截图上传中..." : (taskProofScreenshotUrl ? "已上传，可提交回填" : "上传发布完成后的页面截图")}}</text>
            <button class="xf-mama-submit" data-action="proof" open-type="{{isLoggedIn ? '' : 'getPhoneNumber'}}" bindgetphonenumber="authorizeMamaResourceAction" disabled="{{taskSubmitting}}" catchtap="submitTaskProof">{{taskSubmitting ? "提交中..." : "提交回填"}}</button>
          </view>

          <view wx:if="{{currentMamaTask.hasContentUrl && currentMamaTask.transferScreenshotUrl}}" class="xf-mama-transfer-card">
            <text class="xf-mama-section-title">转账凭证</text>
            <image class="xf-mama-transfer-image" src="{{currentMamaTask.transferScreenshotUrl}}" mode="widthFix" catchtap="previewTransferScreenshot" />
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{taskAnnouncementOpen}}" class="xf-mama-dialog-mask" catchtap="closeTaskAnnouncement" catchtouchmove="noop">
    <view class="xf-mama-dialog" catchtap="noop">
      <button type="button" class="xf-mama-dialog-close" catchtap="closeTaskAnnouncement">×</button>
      <view class="xf-mama-dialog-head">
        <text>项目公告</text>
      </view>
      <text class="xf-mama-dialog-copy">{{currentMamaTask.announcement}}</text>
    </view>
  </view>

  <view wx:if="{{taskContentLinkOpen}}" class="xf-mama-dialog-mask" catchtap="closeMamaTaskContent" catchtouchmove="noop">
    <view class="xf-mama-content-link-dialog" catchtap="noop">
      <button type="button" class="xf-mama-dialog-close xf-mama-content-link-close" catchtap="closeMamaTaskContent">×</button>
      <text class="xf-mama-content-link-title">资料链接</text>
      <text class="xf-mama-content-link-name">{{currentMamaTask.title}}</text>
      <text class="xf-mama-content-link-value" user-select="true" catchtap="copyMamaTaskContentLink">{{currentMamaTask.contentUrl}}</text>
    </view>
  </view>

  <view wx:if="{{taskSharePreviewOpen}}" class="xf-mama-dialog-mask" catchtap="closeMamaTaskSharePreview" catchtouchmove="noop">
    <view class="xf-mama-share-dialog" catchtap="noop">
      <button type="button" class="xf-mama-dialog-close" catchtap="closeMamaTaskSharePreview">×</button>
      <image class="xf-mama-share-image" src="{{taskShareImageUrl}}" mode="widthFix" />
      <button class="xf-mama-submit" catchtap="saveMamaTaskShareImage">保存分享图</button>
    </view>
  </view>

  <canvas canvas-id="mamaTaskShareCanvas" class="xf-mama-share-canvas" width="750" height="1660" />

  <view wx:if="{{settingsPanelOpen}}" class="xf-native-settings-mask" style="height: {{settingsPanelHeight}}px;" catchtap="closeSettings" catchtouchmove="noop">
    <scroll-view class="xf-native-settings-panel" style="height: {{settingsPanelHeight}}px; padding-top: {{profilePanelTop}}px;" scroll-y="true" enhanced show-scrollbar="false" catchtap="noop">
      <view class="xf-native-settings-panel-inner">
      <block wx:if="{{settingsPanelView === 'menu'}}">
        <button wx:if="{{!isLoggedIn}}" class="xf-native-settings-account" open-type="getPhoneNumber" bindgetphonenumber="loginWithPhone">
          <view class="xf-native-settings-avatar-wrap">
            <image class="xf-native-settings-avatar" src="{{accountAvatar}}" mode="aspectFill" />
          </view>
          <view class="xf-native-settings-copy">
            <view class="xf-native-settings-title-row">
              <text class="xf-native-settings-title">{{accountTitle}}</text>
            </view>
            <view class="xf-native-settings-subtitle-row">
              <text class="xf-native-settings-subtitle">{{accountSubtitle}}</text>
            </view>
          </view>
          <text class="xf-native-settings-chevron">›</text>
        </button>
        <view wx:else class="xf-native-settings-account" catchtap="openSettingsItem" data-page="{{accountPage}}" data-title="{{accountTitle}}" data-panel-view="{{accountPanelView}}">
          <view class="xf-native-settings-avatar-wrap">
            <image class="xf-native-settings-avatar" src="{{accountAvatar}}" mode="aspectFill" />
          </view>
          <view class="xf-native-settings-copy">
            <view class="xf-native-settings-title-row">
              <text class="xf-native-settings-title">{{accountTitle}}</text>
            </view>
            <view class="xf-native-settings-subtitle-row">
              <text class="xf-native-settings-subtitle">{{accountSubtitle}}</text>
            </view>
          </view>
          <text class="xf-native-settings-chevron">›</text>
        </view>

        <view
          wx:for="{{settingsSections}}"
          wx:for-item="section"
          wx:for-index="sectionIndex"
          wx:key="key"
          class="xf-native-settings-card"
        >
          <view
            wx:for="{{section.items}}"
            wx:for-item="item"
            wx:for-index="itemIndex"
            wx:key="key"
            class="xf-native-settings-row"
            catchtap="openSettingsItem"
            data-section-index="{{sectionIndex}}"
            data-item-index="{{itemIndex}}"
          >
            <button wx:if="{{!isLoggedIn && !item.public}}" class="xf-settings-item-login" open-type="getPhoneNumber" bindgetphonenumber="loginWithPhone" data-section-index="{{sectionIndex}}" data-item-index="{{itemIndex}}" catchtap="noop" disabled="{{bindingPhone}}"></button>
            <image wx:if="{{item.iconType === 'image'}}" class="xf-native-settings-logo-icon" src="{{item.image}}" mode="aspectFit" />
            <text wx:elif="{{item.iconType === 'emoji'}}" class="xf-native-settings-emoji-icon">{{item.emoji}}</text>
            <text wx:else class="xf-native-settings-symbol material-symbols-rounded">{{item.icon}}</text>
            <text class="xf-native-settings-label">{{item.title}}</text>
            <text wx:if="{{item.key === 'pro' && settingsMemberBadgeLabel}}" class="xf-native-settings-member-badge">{{settingsMemberBadgeLabel}}</text>
            <text class="xf-native-settings-chevron">›</text>
          </view>
        </view>
      </block>
      <template wx:elif="{{settingsPanelView === 'profile'}}" is="xfSettingsProfilePanel" data="{{profileHeaderHeight: profileHeaderHeight, profileDraft: profileDraft, profileAvatar: profileAvatar, profileGenderOptions: profileGenderOptions, profilePanelMessage: profilePanelMessage}}"></template>
      <template wx:elif="{{settingsPanelView === 'archive'}}" is="xfSettingsArchivePanel" data="{{profileHeaderHeight: profileHeaderHeight, archiveHasChildren: archiveHasChildren, archiveChildren: archiveChildren, archiveInsightGrade: archiveInsightGrade, archiveDraft: archiveDraft, archiveProfileStatus: archiveProfileStatus, archiveRelationOptions: archiveRelationOptions, archiveRegionOptions: archiveRegionOptions, archiveRegionIndex: archiveRegionIndex, archiveStageOptions: archiveStageOptions, archiveStageIndex: archiveStageIndex, archiveStage: archiveStage, archiveGradeOptions: archiveGradeOptions, archiveStageGradeColumns: archiveStageGradeColumns, archiveStageGradeValue: archiveStageGradeValue, archiveGradeDisplayText: archiveGradeDisplayText, archiveGradeSelectOptions: archiveGradeSelectOptions, archiveGradeName: archiveGradeName, archiveGradeDropdownOpen: archiveGradeDropdownOpen, archiveTagOptions: archiveTagOptions, profilePanelMessage: profilePanelMessage}}"></template>
      <template wx:elif="{{settingsPanelView === 'memory'}}" is="xfSettingsMemoryPanel" data="{{profileHeaderHeight: profileHeaderHeight, memoryEnabled: memoryEnabled}}"></template>
      <template wx:elif="{{settingsPanelView === 'memoryManager'}}" is="xfSettingsMemoryManagerPanel" data="{{profileHeaderHeight: profileHeaderHeight, memorySearchQuery: memorySearchQuery, filteredMemoryItems: filteredMemoryItems, memoryPanelMessage: memoryPanelMessage}}"></template>
      <template wx:elif="{{settingsPanelView === 'settings'}}" is="xfSettingsAppPanel" data="{{profileHeaderHeight: profileHeaderHeight, isLoggedIn: isLoggedIn, hasMobile: hasMobile, bindingPhone: bindingPhone, maskedMobile: maskedMobile, fontSizeClass: fontSizeClass, fontOptions: fontOptions, profilePanelMessage: profilePanelMessage}}"></template>
      </view>
    </scroll-view>
  </view>
</view>
<phone-login-gate id="mamaResourcePhoneLoginGate" visible="{{false}}" bind:success="handleLoginSuccess" bind:failure="handleMamaResourceLoginFailure" />
