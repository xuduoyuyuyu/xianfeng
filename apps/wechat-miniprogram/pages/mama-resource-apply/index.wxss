@import "../../styles/native-list.wxss";

page {
  background: #f7f3ff;
  color: #171321;
}

.xf-mama-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: #f7f3ff;
  overflow-x: hidden;
}

.xf-mama-content {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx 28rpx 52rpx;
}

.xf-mama-login-card,
.xf-mama-intro-card,
.xf-mama-card {
  box-sizing: border-box;
  width: 100%;
  padding: 30rpx 28rpx;
  border: 2rpx solid rgba(94, 23, 235, 0.14);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(94, 23, 235, 0.08);
}

.xf-mama-card {
  margin-top: 48rpx;
}

.xf-mama-form {
  display: block;
}

.xf-mama-info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.xf-mama-info-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border: 2rpx solid #f0ebf7;
  border-radius: 24rpx;
  background: #ffffff;
}

.xf-mama-info-row:first-child {
  border-top: 2rpx solid #f0ebf7;
}

.xf-mama-info-row.is-personal {
  border-color: #dbe8ff;
  background: #f7faff;
}

.xf-mama-info-row.is-media {
  border-color: #e2d6ff;
  background: #fbf7ff;
}

.xf-mama-info-row.is-preference {
  border-color: #d7f0dd;
  background: #f7fcf8;
}

.xf-mama-info-title,
.xf-mama-info-copy,
.xf-mama-info-account-title,
.xf-mama-info-account-summary {
  display: block;
}

.xf-mama-info-title {
  color: #151222;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.xf-mama-info-copy {
  margin-top: 8rpx;
  color: #6b6474;
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.45;
}

.xf-mama-info-action {
  color: #6c27d6;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-mama-info-account {
  margin-top: -6rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f8f6ff;
}

.xf-mama-info-account-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.xf-mama-info-account-title {
  color: #151222;
  font-size: 23rpx;
  font-weight: 900;
}

.xf-mama-info-account-summary {
  margin-top: 6rpx;
  color: #6b6474;
  font-size: 22rpx;
  font-weight: 750;
}

.xf-mama-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 12rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #f0ebf7;
}

.xf-mama-editor-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0;
  padding: 14rpx 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f3eaff;
  color: #6c27d6;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-mama-editor-back::after {
  border: 0;
}

.xf-mama-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.xf-mama-icon {
  width: 88rpx;
  height: 88rpx;
}

.xf-mama-title,
.xf-mama-subtitle,
.xf-mama-field,
.xf-mama-notes text {
  display: block;
}

.xf-mama-title {
  color: #151222;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.18;
}

.xf-mama-subtitle {
  margin-top: 6rpx;
  color: #6b6474;
  font-size: 23rpx;
  font-weight: 700;
}

.xf-mama-intro-text {
  display: block;
  color: #5f5966;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.68;
}

.xf-mama-field {
  margin-top: 20rpx;
  color: #4b4453;
  font-size: 25rpx;
  font-weight: 800;
}

.xf-mama-form-section {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #f0ebf7;
}

.xf-mama-section-heading {
  display: block;
  color: #151222;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.xf-mama-field input,
.xf-mama-picker {
  box-sizing: border-box;
  width: 100%;
  margin-top: 12rpx;
  height: 78rpx;
  min-height: 78rpx;
  border: 2rpx solid #ddd7e8;
  border-radius: 22rpx;
  background: #ffffff;
  color: #171321;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 78rpx;
  padding: 0 22rpx;
}

.xf-mama-field input.is-locked {
  background: #f6f2ff;
  color: #70687f;
}

.xf-mama-field textarea {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  margin-top: 12rpx;
  border: 2rpx solid #ddd7e8;
  border-radius: 22rpx;
  background: #ffffff;
  color: #171321;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
  padding: 20rpx 22rpx;
}

.xf-mama-picker {
  color: #8b8792;
}

.xf-mama-placeholder {
  color: #a19ca8;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.xf-mama-textarea-placeholder {
  color: #a19ca8;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.xf-mama-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.xf-mama-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 2rpx solid #ddd7e8;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5d5666;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 62rpx;
}

.xf-mama-chip::after {
  border: 0;
}

.xf-mama-chip.is-active {
  border-color: #6c27d6;
  background: #6c27d6;
  color: #ffffff;
}

.xf-mama-gender-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.xf-mama-gender-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid #ddd7e8;
  border-radius: 999rpx;
  background: #f5f6fa;
  color: #6b6474;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 54rpx;
}

.xf-mama-gender-chip::after {
  border: 0;
}

.xf-mama-gender-chip.is-active {
  border-color: #8f4dff;
  background: #f3eaff;
  color: #7c2ce6;
}

.xf-mama-upload-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  margin: 12rpx 0 0;
  padding: 0 22rpx;
  border: 2rpx solid #ddd7e8;
  border-radius: 22rpx;
  background: #ffffff;
  color: #6c27d6;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 78rpx;
  text-align: left;
}

.xf-mama-upload-button::after {
  border: 0;
}

.xf-mama-upload-button[disabled] {
  color: #8b8792;
  background: #f5f6fa;
}

.xf-mama-upload-hint {
  display: block;
  margin-top: 8rpx;
  color: #8b8792;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.xf-mama-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f8f6ff;
}

.xf-mama-media-account {
  margin-top: 22rpx;
  padding: 20rpx;
  border: 2rpx solid #eee8f7;
  border-radius: 24rpx;
  background: #fbfaff;
}

.xf-mama-media-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.xf-mama-media-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.xf-mama-media-title text:last-child {
  color: #151222;
  font-size: 25rpx;
  font-weight: 900;
}

.xf-mama-platform-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 42rpx;
  overflow: hidden;
}

.xf-mama-platform-logo.is-xiaohongshu {
  background: #ff2442;
  box-shadow: 0 6rpx 14rpx rgba(255, 36, 66, 0.2);
}

.xf-mama-platform-logo.is-douyin {
  background: #151222;
  box-shadow: 0 6rpx 14rpx rgba(21, 18, 34, 0.2);
}

.xf-mama-platform-logo.is-unselected {
  background: #d8c9f4;
  color: #6c27d6;
  box-shadow: 0 6rpx 14rpx rgba(108, 39, 214, 0.12);
}

.xf-mama-platform-logo-image {
  display: block;
  width: 100%;
  height: 100%;
}

.xf-mama-media-remove,
.xf-mama-add-account {
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-mama-add-account-row {
  margin-top: 20rpx;
}

.xf-mama-media-remove {
  padding: 14rpx 20rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 22rpx;
}

.xf-mama-add-account {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #f3eaff;
  color: #6c27d6;
  font-size: 25rpx;
}

.xf-mama-media-remove::after,
.xf-mama-add-account::after {
  border: 0;
}

.xf-mama-field.is-nested {
  margin-top: 0;
}

.xf-mama-check {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  color: #4b4453;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.5;
}

.xf-mama-check-circle .wx-checkbox-input {
  width: 30rpx;
  height: 30rpx;
  margin-top: 2rpx;
  border: 2rpx solid #6c27d6;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6c27d6;
  opacity: 0.42;
}

.xf-mama-check-circle .wx-checkbox-input.wx-checkbox-input-checked {
  border-color: #6c27d6;
  background: #ffffff;
  opacity: 1;
}

.xf-mama-check-circle .wx-checkbox-input.wx-checkbox-input-checked::before {
  color: #6c27d6;
  font-size: 26rpx;
  font-weight: 900;
  transform: translate(-50%, -50%) scale(0.72);
}

.xf-mama-message {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 850;
}

.xf-mama-message.success {
  background: #effaf4;
  color: #166534;
}

.xf-mama-message.error {
  background: #fff1f2;
  color: #be123c;
}

.xf-mama-submit {
  margin-top: 26rpx;
  border: 0;
  border-radius: 26rpx;
  background: #6c27d6;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1;
  padding: 26rpx;
  box-shadow: 0 14rpx 32rpx rgba(108, 39, 214, 0.24);
}

.xf-mama-submit::after {
  border: 0;
}

.xf-mama-review-card {
  box-sizing: border-box;
  width: 100%;
  padding: 44rpx 32rpx 34rpx;
  border: 2rpx solid rgba(94, 23, 235, 0.14);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(94, 23, 235, 0.1);
}

.xf-mama-review-card.pending {
  border-color: rgba(108, 39, 214, 0.16);
}

.xf-mama-review-card.needs_info {
  border-color: rgba(245, 158, 11, 0.28);
}

.xf-mama-review-card.rejected {
  border-color: rgba(244, 63, 94, 0.24);
}

.xf-mama-review-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  background: #f1eaff;
  color: #6c27d6;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-mama-review-card.needs_info .xf-mama-review-icon {
  background: #fff7ed;
  color: #d97706;
}

.xf-mama-review-card.rejected .xf-mama-review-icon {
  background: #fff1f2;
  color: #be123c;
}

.xf-mama-review-title {
  display: block;
  margin-top: 26rpx;
  color: #151222;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.xf-mama-review-copy {
  display: block;
  margin-top: 18rpx;
  color: #5f5966;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1.65;
}

.xf-mama-review-info {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 32rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8f6ff;
}

.xf-mama-review-info view {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.xf-mama-review-info text {
  color: #6b6474;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.xf-mama-review-info text:last-child {
  color: #151222;
  text-align: right;
}

.xf-mama-review-note {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff7ed;
}

.xf-mama-review-note text {
  display: block;
  color: #9a3412;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.55;
}

.xf-mama-review-note text:first-child {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #c2410c;
}

.xf-mama-review-next {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #effaf4;
}

.xf-mama-review-next text {
  display: block;
  color: #166534;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.6;
}

.xf-mama-review-action {
  margin-top: 28rpx;
  border: 0;
  border-radius: 24rpx;
  background: #6c27d6;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  padding: 24rpx;
}

.xf-mama-review-action::after {
  border: 0;
}

.xf-mama-task-hero {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 26rpx 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  color: #151222;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-mama-task-manage {
  align-self: center;
  margin: 0;
  padding: 16rpx 20rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f3eaff;
  color: #6c27d6;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-mama-task-manage::after {
  border: 0;
}

.xf-mama-task-hero-icon {
  width: 76rpx;
  height: 76rpx;
}

.xf-mama-task-kicker,
.xf-mama-task-title,
.xf-mama-task-subtitle {
  display: block;
}

.xf-mama-task-kicker {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #f4eeff;
  color: #6c27d6;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-mama-task-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-mama-task-subtitle {
  margin-top: 12rpx;
  color: #6b6474;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1.45;
}

.xf-mama-task-empty {
  margin-top: 22rpx;
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #6b6474;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.5;
  text-align: center;
}

.xf-mama-task-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.xf-mama-task-row {
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 2rpx solid rgba(108, 39, 214, 0.08);
  box-shadow: 0 12rpx 30rpx rgba(35, 31, 44, 0.06);
}

.xf-mama-task-logo,
.xf-mama-detail-logo {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
}

.xf-mama-task-main {
  flex: 1;
  min-width: 0;
}

.xf-mama-task-row-head {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
}

.xf-mama-task-name {
  display: block;
  overflow: hidden;
  color: #151222;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-mama-task-price-group {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  min-width: 148rpx;
  max-width: 188rpx;
}

.xf-mama-task-price-label {
  color: #9a8faf;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1;
}

.xf-mama-task-price {
  color: #f04438;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.1;
}

.xf-mama-task-traffic {
  display: block;
  align-items: center;
  box-sizing: border-box;
  max-width: 100%;
  padding: 4rpx 0 0;
  background: transparent;
  color: #c2410c;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.15;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}

.xf-mama-task-meta {
  display: block;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-mama-task-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
  margin-left: 90rpx;
}

.xf-mama-task-stats text {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f7f3ff;
  color: #5e17eb;
  font-size: 21rpx;
  font-weight: 850;
  line-height: 1;
}

.xf-mama-detail-shell {
  border-radius: 30rpx;
  overflow: hidden;
  background: #f3f6f5;
}

.xf-mama-detail-hero {
  box-sizing: border-box;
  min-height: 218rpx;
  padding: 28rpx 24rpx 34rpx;
  background: linear-gradient(135deg, #6c27d6 0%, #8b3cf6 58%, #ec3d8c 100%);
  color: #ffffff;
}

.xf-mama-detail-back {
  width: 54rpx;
  height: 54rpx;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 46rpx;
}

.xf-mama-detail-brand {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 22rpx;
}

.xf-mama-detail-copy {
  flex: 1;
  min-width: 0;
}

.xf-mama-detail-title {
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-mama-detail-meta-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.xf-mama-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.xf-mama-detail-tags text {
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 850;
}

.xf-mama-detail-share-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  min-height: 42rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.xf-mama-detail-share-icon::after {
  border: 0;
}

.xf-mama-detail-share-icon[disabled] {
  opacity: 0.58;
}

.xf-mama-notice-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: -26rpx 22rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #151222;
  font-size: 25rpx;
  font-weight: 850;
  box-shadow: 0 12rpx 28rpx rgba(20, 35, 28, 0.08);
}

.xf-mama-notice-row text:nth-child(2) {
  flex: 1;
}

.xf-mama-notice-badge {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: #f4eeff;
  color: #6c27d6;
  font-size: 20rpx;
  font-weight: 900;
}

.xf-mama-project-card {
  margin-top: 20rpx;
  background: #ffffff;
}

.xf-mama-project-title {
  padding: 28rpx 24rpx 4rpx;
  color: #151222;
  font-size: 32rpx;
  font-weight: 900;
}

.xf-mama-section-title {
  display: block;
  padding: 28rpx 24rpx 16rpx;
  color: #151222;
  font-size: 29rpx;
  font-weight: 900;
}

.xf-mama-price-table {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr 1fr 1fr;
  margin: 0 24rpx 28rpx;
  border: 2rpx solid #d5dbea;
  border-radius: 12rpx;
  overflow: hidden;
}

.xf-mama-price-table view {
  min-height: 62rpx;
  border-right: 2rpx solid #d5dbea;
  border-bottom: 2rpx solid #d5dbea;
  color: #667085;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 62rpx;
  text-align: center;
}

.xf-mama-price-table view:nth-child(4n) {
  border-right: 0;
}

.xf-mama-price-table view:nth-child(n + 5) {
  border-bottom: 0;
  color: #151222;
}

.xf-mama-price-table .is-price {
  color: #f04438;
}

.xf-mama-fold-row {
  padding: 24rpx;
  border-top: 14rpx solid #f4f5f7;
}

.xf-mama-fold-row text:first-child {
  display: block;
  color: #151222;
  font-size: 28rpx;
  font-weight: 900;
}

.xf-mama-fold-row text:last-child {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.55;
}

.xf-mama-example-gallery {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.xf-mama-example-image {
  display: block;
  width: 100%;
  border-radius: 20rpx;
}

.xf-mama-proof-card {
  padding: 6rpx 24rpx 28rpx;
  border-top: 14rpx solid #f4f5f7;
  background: #ffffff;
}

.xf-mama-proof-card .xf-mama-section-title {
  padding-left: 0;
  padding-right: 0;
}

.xf-mama-task-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  padding: 8rpx 24rpx 28rpx;
  background: #ffffff;
}

.xf-mama-transfer-card {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #faf8fd;
}

.xf-mama-transfer-image {
  display: block;
  width: 100%;
  margin-top: 16rpx;
  border-radius: 18rpx;
}

.xf-mama-content-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f7f2ff;
}

.xf-mama-content-title,
.xf-mama-content-hint {
  display: block;
}

.xf-mama-content-title {
  color: #2f185b;
  font-size: 27rpx;
  font-weight: 900;
}

.xf-mama-content-hint {
  margin-top: 8rpx;
  color: #75668e;
  font-size: 22rpx;
  line-height: 1.45;
}

.xf-mama-content-button {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #6c27d6;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.xf-mama-content-button::after {
  border: 0;
}

.xf-mama-task-actions .xf-mama-submit {
  margin-top: 0;
}

.xf-mama-share-button {
  border: 2rpx solid rgba(108, 39, 214, 0.22);
  border-radius: 26rpx;
  background: #f7f2ff;
  color: #5e17eb;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1;
  padding: 24rpx;
}

.xf-mama-share-button::after {
  border: 0;
}

.xf-mama-submit[disabled] {
  background: #c8c2d3;
  color: #ffffff;
  box-shadow: none;
}

.xf-mama-notes {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
}

.xf-mama-notes text {
  box-sizing: border-box;
  min-height: 104rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(94, 23, 235, 0.1);
  border-radius: 32rpx;
  background: #f1eaff;
  color: #39206f;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
  display: flex;
  align-items: center;
}

.xf-mama-dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(12, 10, 28, 0.38);
}

.xf-mama-dialog {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 72rpx rgba(36, 27, 73, 0.22);
  overflow: hidden;
}

.xf-mama-dialog-head {
  display: flex;
  align-items: center;
  padding: 28rpx 96rpx 18rpx 30rpx;
  color: #151222;
  font-size: 30rpx;
  font-weight: 950;
}

.xf-mama-dialog-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #f6f4fb;
  color: #8b93a7;
  font-size: 32rpx;
  line-height: 52rpx;
}

.xf-mama-dialog-copy {
  display: block;
  padding: 0 30rpx 32rpx;
  color: #4f5b6f;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.7;
  white-space: pre-wrap;
}

.xf-mama-content-link-dialog {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 620rpx;
  padding: 42rpx 32rpx 34rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 72rpx rgba(36, 27, 73, 0.22);
}

.xf-mama-content-link-close {
  background: #f4efff;
  color: #5e17eb;
}

.xf-mama-content-link-title,
.xf-mama-content-link-name,
.xf-mama-content-link-label,
.xf-mama-content-link-value {
  display: block;
}

.xf-mama-content-link-title {
  padding-right: 72rpx;
  color: #211839;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.4;
}

.xf-mama-content-link-name {
  margin-top: 22rpx;
  color: #7761ad;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.5;
}

.xf-mama-content-link-label {
  margin-top: 28rpx;
  color: #8878ad;
  font-size: 25rpx;
  font-weight: 800;
}

.xf-mama-content-link-value {
  box-sizing: border-box;
  width: 100%;
  margin-top: 12rpx;
  padding: 24rpx 20rpx;
  border: 2rpx solid #ddd1ff;
  border-radius: 20rpx;
  background: #f8f5ff;
  color: #5e17eb;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.45;
  overflow-wrap: anywhere;
  word-break: break-all;
  user-select: text;
}

.xf-mama-share-dialog {
  position: relative;
  width: 620rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 72rpx rgba(36, 27, 73, 0.22);
  overflow: hidden;
  padding: 76rpx 28rpx 30rpx;
}

.xf-mama-share-image {
  display: block;
  width: 100%;
  border-radius: 22rpx;
  background: #fff7fb;
}

.xf-mama-share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1660px;
}
.xf-mama-required {
  margin-left: 4rpx;
  color: #e11d48;
}
