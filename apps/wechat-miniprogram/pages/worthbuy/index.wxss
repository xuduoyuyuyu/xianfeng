page{background:#f8f6ff;color:#1e1b4b}.wb-page{min-height:100vh;padding-bottom:calc(150rpx + env(safe-area-inset-bottom));box-sizing:border-box}.wb-topbar{position:fixed;z-index:20;left:0;right:0;top:0;background:rgba(255,255,255,.98);display:flex;align-items:flex-end;justify-content:center;padding-bottom:18rpx;box-sizing:border-box;border-bottom:1rpx solid #eee8f5}.wb-topbar image{width:150rpx;height:58rpx}.wb-topbar>text{font-size:28rpx;font-weight:700;margin-left:12rpx}.wb-back{position:absolute;left:18rpx;bottom:8rpx;background:transparent;color:#7c3aed;font-size:54rpx;padding:0 20rpx;line-height:1}.wb-back::after,.wb-section-head button::after,.wb-delete::after{border:0}

.wb-hero{margin:38rpx 24rpx 28rpx;padding:44rpx 42rpx 42rpx;background:radial-gradient(circle at 85% 15%,rgba(143,100,255,.1),transparent 38%),linear-gradient(135deg,#f4f1fd 0%,#faf8ff 48%,#f0ebff 100%);border:2rpx solid #d8d0ef;border-radius:48rpx;box-shadow:0 24rpx 80rpx rgba(80,62,125,.08);display:flex;flex-direction:column;align-items:center;text-align:center}.wb-kicker{padding:12rpx 28rpx;border:2rpx solid #d9cdf7;border-radius:999rpx;color:#6f4cc3;font-size:22rpx;font-weight:700;letter-spacing:7rpx}.wb-title{font-size:42rpx;font-weight:800;margin-top:28rpx}.wb-subtitle{max-width:610rpx;font-size:28rpx;color:#7569a5;line-height:1.75;margin:28rpx 0 38rpx}.wb-search-row{width:100%;height:96rpx;background:#fff;border:2rpx solid #e2d8ff;border-radius:26rpx;display:flex;align-items:center;padding:0 28rpx;box-sizing:border-box;box-shadow:0 8rpx 24rpx rgba(124,58,237,.05)}.wb-search-icon{color:#8b6ddd;font-size:52rpx;line-height:1;transform:rotate(-20deg);margin-right:18rpx}.wb-search-row input{flex:1;text-align:left;font-size:28rpx;color:#1e1b4b}.wb-submit{width:100%;height:94rpx;margin-top:22rpx;border-radius:26rpx;background:linear-gradient(135deg,#7c3aed,#9b5cf6);color:#fff;font-size:30rpx;font-weight:700;display:flex;align-items:center;justify-content:center}.wb-submit[disabled]{background:#e6e6ef;color:#fff}.wb-support{margin-top:22rpx;color:#a2a3b3;font-size:24rpx}.wb-error{width:100%;margin-top:18rpx;padding:18rpx;background:#fff4f4;border-radius:18rpx;color:#b42318;box-sizing:border-box}.wb-error button{margin-top:12rpx;font-size:25rpx}

.wb-section-head{display:flex;justify-content:space-between;align-items:center;margin:30rpx 30rpx 18rpx}.wb-section-head>text{font-size:30rpx;font-weight:800}.wb-section-head button{margin:0;background:transparent;color:#7c3aed;font-size:26rpx;padding:8rpx}.wb-list{padding:0 24rpx}.wb-card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.wb-card{position:relative;min-height:128rpx;display:flex;align-items:center;gap:20rpx;background:#fff;border:2rpx solid #e5def2;border-radius:30rpx;padding:24rpx 22rpx;box-sizing:border-box;overflow:hidden}.wb-card-icon{flex:0 0 54rpx;width:54rpx;font-size:42rpx;text-align:center}.wb-card-copy{min-width:0;flex:1;display:flex;flex-direction:column;align-items:flex-start}.wb-card-title{width:100%;font-size:27rpx;line-height:1.35;font-weight:750;color:#1e1b4b;text-align:left;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.wb-card-tag{margin-top:12rpx;padding:5rpx 12rpx;background:#f3eeff;color:#8b5cf6;border-radius:10rpx;font-size:22rpx;line-height:1.2}.wb-delete{position:absolute;right:8rpx;top:6rpx;background:rgba(255,255,255,.92);color:#a33;font-size:20rpx;padding:4rpx 8rpx;line-height:1.2}.wb-empty{text-align:center;color:#81778d;padding:44rpx 20rpx}.wb-empty button{margin-top:16rpx;color:#7c3aed;background:#fff}
