page{background:#f8f6ff;color:#211b2d}.wb-page{min-height:100vh;padding-bottom:60rpx}.wb-topbar{position:fixed;z-index:20;left:0;right:0;top:0;background:rgba(255,255,255,.96);display:flex;align-items:flex-end;justify-content:center;padding-bottom:18rpx;box-sizing:border-box;border-bottom:1rpx solid #eee8f5}.wb-topbar image{width:150rpx;height:58rpx}.wb-topbar>text{font-size:28rpx;font-weight:700;margin-left:12rpx}.wb-back{position:absolute;left:20rpx;bottom:10rpx;background:transparent;font-size:54rpx;padding:0 20rpx}.wb-back::after,.wb-section-head button::after,.wb-delete::after{border:0}.wb-hero{margin:28rpx 24rpx;padding:42rpx 30rpx;background:linear-gradient(145deg,#fff,#f0e8ff);border:1rpx solid #e2d6f4;border-radius:36rpx;box-shadow:0 18rpx 46rpx rgba(96,54,150,.1);display:flex;flex-direction:column}.wb-kicker{color:#7a36cf;font-size:22rpx;letter-spacing:5rpx}.wb-title{font-size:48rpx;font-weight:800;margin-top:10rpx}.wb-subtitle{font-size:27rpx;color:#6f657d;line-height:1.7;margin:14rpx 0 24rpx}.wb-hero textarea{height:180rpx;background:#fff;border:1rpx solid #ded5e9;border-radius:24rpx;padding:24rpx;box-sizing:border-box;font-size:29rpx}.wb-submit{margin-top:20rpx;background:#6c27d6;color:#fff;border-radius:999rpx;font-weight:700}.wb-error{margin-top:18rpx;padding:18rpx;background:#fff4f4;border-radius:18rpx;color:#b42318}.wb-error button{margin-top:12rpx;font-size:25rpx}.wb-section-head{display:flex;justify-content:space-between;align-items:center;margin:34rpx 28rpx 18rpx}.wb-section-head>text{font-size:36rpx;font-weight:800}.wb-section-head button{margin:0;background:transparent;color:#6c27d6;font-size:27rpx}.wb-list{padding:0 24rpx}.wb-card{display:grid;grid-template-columns:92rpx 1fr auto;gap:20rpx;align-items:start;background:#fff;border:1rpx solid #e5deed;border-radius:28rpx;padding:26rpx;margin-bottom:18rpx}.wb-score{width:82rpx;height:82rpx;border-radius:50%;background:#efe4ff;color:#6c27d6;font-size:32rpx;font-weight:800;display:flex;align-items:center;justify-content:center}.wb-card-title{font-size:31rpx;font-weight:750;display:block}.wb-reason{font-size:25rpx;line-height:1.55;color:#70657d;margin-top:8rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.wb-verdict{display:block;color:#7a36cf;font-size:23rpx;margin-top:12rpx}.wb-delete{background:transparent;color:#a33;font-size:23rpx;padding:0}.wb-empty{text-align:center;color:#81778d;padding:44rpx 20rpx}
