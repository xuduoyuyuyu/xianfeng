<view class="wb-page" style="padding-top: {{chromeHeight}}px;">
  <view class="xf-native-topbar" style="height: {{topbarHeight}}px;">
    <view class="xf-native-nav-row" style="height: {{topbarHeight}}px;">
      <view class="xf-native-menu-button" style="top: {{logoTop}}px; height: {{logoHeight}}px;" catchtap="openSettings" role="button" aria-label="打开设置"><view class="xf-native-menu-icon" aria-hidden="true"></view></view>
      <image class="xf-native-logo" style="top: {{logoTop}}px; height: {{logoHeight}}px;" src="/assets/nav/logo.png" mode="aspectFit" bindtap="goProgramsHome" aria-label="回到首页" />
      <button class="xf-native-welfare-button" style="top: {{logoTop}}px; right: {{welfareRight}}px; height: {{logoHeight}}px;" catchtap="openWelfare" aria-label="百宝箱"><image class="xf-native-welfare-icon" src="/assets/menu/welfare-gift-icon.png" mode="aspectFit" aria-hidden="true" /></button>
    </view>
  </view>

  <view class="wb-hero">
    <text class="wb-kicker">VALUE CHECK</text>
    <text class="wb-title">知物</text>
    <text class="wb-subtitle">输入商品链接或品牌名称，AI 帮你深度分析值不值得买，看穿消费迷雾</text>
    <view class="wb-search-row">
      <text class="wb-search-icon">⌕</text>
      <input value="{{input}}" bindinput="onInput" placeholder="粘贴商品链接或输入品牌名称…" maxlength="800"/>
    </view>
    <button class="wb-submit {{input && !submitting ? '' : 'is-disabled'}}" open-type="{{isLoggedIn ? '' : 'getPhoneNumber'}}" bindtap="submitAnalysis" bindgetphonenumber="authorizeAnalysis" loading="{{submitting}}">{{submitting ? submitStage : '开始分析'}}</button>
    <text class="wb-support">支持淘宝、京东、拼多多等平台链接，或直接输入品牌名</text>
    <view wx:if="{{actionError}}" class="wb-error">
      <text>{{actionError}}</text>
      <button wx:if="{{actionErrorType === 'pro' || actionErrorType === 'points'}}" bindtap="openPro">查看 Pro</button>
    </view>
  </view>

  <view class="wb-section-head">
    <text>{{showHistory ? '我的分析' : '公开知物'}}</text>
    <button open-type="{{isLoggedIn || showHistory ? '' : 'getPhoneNumber'}}" bindtap="toggleHistory" bindgetphonenumber="authorizeHistory">{{showHistory ? '查看公开' : '我的分析'}}</button>
  </view>

  <view wx:if="{{showHistory}}" class="wb-list">
    <view wx:if="{{!myItems.length}}" class="wb-empty">暂无个人分析记录</view>
    <view class="wb-card-grid">
      <view wx:for="{{myItems}}" wx:key="id" class="wb-card" data-index="{{index}}" data-scope="my" bindtap="openDetail">
        <text class="wb-card-icon">{{item.displayEmoji}}</text>
        <view class="wb-card-copy">
          <text class="wb-card-title">{{item.title}}</text>
          <text class="wb-card-tag {{item.isIqTax ? 'is-iq-tax' : ''}}">{{item.categoryLabel}}</text>
        </view>
        <button class="wb-delete" data-index="{{index}}" catchtap="deleteHistoryItem">删除</button>
      </view>
    </view>
  </view>

  <view wx:else class="wb-list">
    <view wx:if="{{loading}}" class="wb-empty">正在加载知物内容…</view>
    <view wx:if="{{error}}" class="wb-empty">{{error}}<button bindtap="onPullDownRefresh">重试</button></view>
    <view class="wb-card-grid">
      <view wx:for="{{publicItems}}" wx:key="id" class="wb-card" data-index="{{index}}" data-scope="public" bindtap="openDetail">
        <text class="wb-card-icon">{{item.displayEmoji}}</text>
        <view class="wb-card-copy">
          <text class="wb-card-title">{{item.title}}</text>
          <text class="wb-card-tag {{item.isIqTax ? 'is-iq-tax' : ''}}">{{item.categoryLabel}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="wb-empty">正在加载更多…</view>
  </view>
</view>
<phone-login-gate id="worthbuyPhoneLoginGate" visible="{{false}}" bind:success="handleLoginSuccess" bind:failure="handleLoginFailure" />
<custom-tab-bar selected="{{selected}}" hidden="{{hideTabbar}}" />
