@import "../../styles/native-list.wxss";

.xf-topics-guide {
  box-sizing: border-box;
  width: 100%;
  margin: 24rpx 0 28rpx;
  padding: 56rpx 42rpx 36rpx;
  border: 2rpx solid #d8d0ef;
  border-radius: 48rpx;
  background:
    radial-gradient(circle at 85% 15%, rgba(143, 100, 255, 0.1), transparent 38%),
    linear-gradient(135deg, #f4f1fd 0%, #faf8ff 48%, #f0ebff 100%);
  box-shadow: 0 24rpx 80rpx rgba(80, 62, 125, 0.1);
}

.xf-topics-guide-copy {
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.xf-topics-eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-width: 282rpx;
  height: 48rpx;
  padding: 0 26rpx;
  border: 2rpx solid #cfc2ef;
  border-radius: 999rpx;
  background: #f3eefc;
  color: #5b3fa1;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 48rpx;
  white-space: nowrap;
}

.xf-topics-eyebrow-word,
.xf-topics-eyebrow-amp {
  display: inline-block;
  line-height: 48rpx;
  letter-spacing: 0.18em;
  text-align: center;
  white-space: nowrap;
  word-break: keep-all;
}

.xf-topics-eyebrow-amp {
  margin: 0 10rpx;
}

.xf-topics-guide-title {
  display: block;
  margin-top: 32rpx;
  color: #2b1a3a;
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.15;
}

.xf-topics-guide-subtitle {
  display: block;
  margin-top: 14rpx;
  color: #6f62a3;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.7;
}

.xf-topics-ask-box {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  margin-top: 34rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(124, 77, 255, 0.22);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 28rpx rgba(124, 77, 255, 0.09);
}

.xf-topics-guide-search-icon {
  position: relative;
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
}

.xf-topics-guide-search-circle {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  box-sizing: border-box;
  width: 25rpx;
  height: 25rpx;
  border: 5rpx solid #8f7bd6;
  border-radius: 50%;
}

.xf-topics-guide-search-line {
  position: absolute;
  right: 4rpx;
  bottom: 7rpx;
  width: 18rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #8f7bd6;
  transform: rotate(45deg);
}

.xf-topics-guide-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 90rpx;
  color: #1e1b4b;
  font-size: 28rpx;
  line-height: 90rpx;
}

.xf-topics-ask-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  margin-top: 24rpx;
  padding: 0 32rpx;
  border: 0;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #7c3aed, #a855f7);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 112rpx;
}

.xf-topics-ask-button.is-disabled {
  background: #d1d5db;
}

.xf-topics-ask-helper {
  display: block;
  margin-top: 20rpx;
  color: #9ca3af;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
  text-align: center;
}

.xf-topics-submit-panel {
  display: block;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #ddd6fe;
  border-radius: 28rpx;
  background: #fff7ed;
}

.xf-topics-submit-panel.is-success {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.xf-topics-submit-panel.is-error {
  border-color: #fecaca;
  background: #fef2f2;
}

.xf-topics-submit-panel.is-confirmRefine,
.xf-topics-submit-panel.is-loading {
  border-color: #ddd6fe;
  background: #f3eeff;
}

.xf-topics-submit-message,
.xf-topics-refine-text {
  display: block;
  color: #6b21a8;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
}

.xf-topics-submit-panel.is-success .xf-topics-submit-message {
  color: #166534;
}

.xf-topics-submit-panel.is-error .xf-topics-submit-message {
  color: #dc2626;
}

.xf-topics-submit-progress {
  display: block;
  margin-top: 18rpx;
}

.xf-topics-submit-progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.xf-topics-submit-progress-label,
.xf-topics-submit-progress-percent {
  display: block;
  color: #7c3aed;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.xf-topics-submit-progress-percent {
  flex: 0 0 auto;
}

.xf-topics-submit-progress-track {
  height: 12rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e9d5ff;
}

.xf-topics-submit-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7c3aed, #a855f7);
}

.xf-topics-refine-box {
  display: block;
  margin-top: 18rpx;
}

.xf-topics-refine-text {
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border: 2rpx solid #c4b5fd;
  border-radius: 18rpx;
  background: #ffffff;
  color: #1e1b4b;
  font-size: 28rpx;
}

.xf-topics-submit-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.xf-topics-submit-primary,
.xf-topics-submit-secondary,
.xf-topics-submit-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 68rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.xf-topics-submit-primary {
  background: linear-gradient(135deg, #7c3aed, #a855f7);
  color: #ffffff;
}

.xf-topics-submit-secondary {
  border: 2rpx solid #ddd6fe;
  background: #ffffff;
  color: #7c3aed;
}

.xf-topics-submit-link {
  min-height: 56rpx;
  margin: 12rpx auto 0;
  background: transparent;
  color: #8b5cf6;
  font-size: 22rpx;
  line-height: 56rpx;
  text-decoration: underline;
}

.xf-topics-ask-button::after,
.xf-topics-guide-tag::after,
.xf-topics-guide-tag-toggle::after,
.xf-topics-submit-primary::after,
.xf-topics-submit-secondary::after,
.xf-topics-submit-link::after,
.xf-topics-delete-button::after {
  border: 0;
}

.xf-topics-guide-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  box-sizing: border-box;
  width: calc(100% + 72rpx);
  gap: 10rpx 6rpx;
  margin-right: -36rpx;
  margin-top: 28rpx;
  margin-left: -36rpx;
}

.xf-topics-guide-row-break {
  flex: 0 0 100%;
  width: 100%;
  height: 0;
}

.xf-topics-guide-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ede9fe;
  color: #5b21b6;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.xf-topics-guide-tag.is-active {
  background: #7c3aed;
  color: #ffffff;
}

.xf-topics-guide-tag-toggle {
  display: block;
  margin: 12rpx auto 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.xf-topics-page .xf-native-card {
  align-items: flex-start;
}

.xf-topics-page .xf-native-list {
  gap: 34rpx;
}

.xf-topics-page .xf-topics-card {
  position: relative;
  display: block;
  min-height: 0;
  padding: 40rpx 48rpx 42rpx;
  border: 2rpx solid #f3f0ff;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 48rpx rgba(47, 35, 85, 0.08);
}

.xf-topics-page .xf-topics-card.is-disabled {
  opacity: 0.72;
}

.xf-topics-page .xf-topics-card.is-delete-ready {
  border-color: #fecaca;
  box-shadow: 0 20rpx 54rpx rgba(248, 113, 113, 0.16);
}

.xf-topics-delete-button {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 58rpx;
  height: 58rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #f87171;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 58rpx;
  box-shadow: 0 12rpx 24rpx rgba(248, 113, 113, 0.28);
}

.xf-topics-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.xf-topics-card-actions {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 12rpx;
}

.xf-topics-page .xf-native-card-title {
  flex: 1 1 auto;
  margin-top: 0;
  color: #1e1b4b;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.36;
}

.xf-topics-page .xf-native-topic-mark {
  display: block;
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.xf-topics-page .xf-native-topic-mark.is-emoji {
  font-size: 64rpx;
  line-height: 76rpx;
  text-align: center;
}

.xf-topic-progress,
.xf-topic-subtitle {
  display: block;
}

.xf-topic-progress {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f6f0ff;
}

.xf-topic-progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.xf-topic-progress-label,
.xf-topic-progress-percent {
  display: block;
  color: #7c3aed;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.xf-topic-progress-percent {
  flex: 0 0 auto;
}

.xf-topic-progress-track {
  height: 12rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e9d5ff;
}

.xf-topic-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #7c3aed;
}

.xf-topic-subtitle {
  margin-top: 22rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.5;
}

.xf-topics-page .xf-native-description {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.6;
  -webkit-line-clamp: 2;
}

.xf-topics-page .xf-native-tags {
  gap: 14rpx;
  margin-top: 26rpx;
}

.xf-topics-page .xf-native-tag {
  max-width: 184rpx;
  padding: 4rpx 18rpx;
  border: 0;
  border-radius: 20rpx;
  background: #f3eeff;
  color: #7c3aed;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 30rpx;
}
