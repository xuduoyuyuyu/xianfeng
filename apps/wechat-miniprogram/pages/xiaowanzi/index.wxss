  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #f3edff;
  color: #5e17eb;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1;
}

.xf-xiaowanzi-history-delete::after {
  border: 0;
}

.xf-xiaowanzi-history-card:last-child {
  margin-bottom: 0;
}

.xf-xiaowanzi-history-card-title {
  display: block;
  width: 100%;
  color: #1f254b;
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  overflow: hidden;
  text-overflow: ellipsis;
  overflow-wrap: normal;
  white-space: nowrap;
  word-break: normal;
}

.xf-xiaowanzi-history-card-time {
  display: block;
  margin-top: 3px;
  color: #9eb0cf;
  font-size: 12px;
  font-weight: 400;
  line-height: 14px;
}

.xf-xiaowanzi-history-card-child {
  display: block;
  margin-top: 4px;
  color: #5c47ff;
  font-size: 13px;
  font-weight: 400;
  line-height: 16px;
}

.xf-xiaowanzi-history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 0;
  box-sizing: border-box;
  padding: 48rpx 16rpx;
  border: 2rpx solid rgba(124, 77, 255, 0.12);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(35, 37, 71, 0.04);
  text-align: center;
}

.xf-xiaowanzi-history-empty-title {
  color: #1f254b;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.35;
}

.xf-xiaowanzi-history-empty-sub {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.25;
}

.xf-xiaowanzi-history-exit {
  position: absolute;
  right: 36rpx;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #601bec;
  color: #ffffff;
  box-shadow: 0 28rpx 60rpx rgba(96, 27, 236, 0.28);
}

.xf-xiaowanzi-history-exit-mark {
  display: block;
  width: 24px;
  height: 24px;
}

@keyframes xfXiaowanziHistoryMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes xfXiaowanziHistoryDrawerIn {
  from { opacity: 0.72; transform: translateX(-100%); }
  to { opacity: 1; transform: none; }
}

.xf-xiaowanzi-share-select-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: transparent;
  pointer-events: auto;
}

.xf-xiaowanzi-share-select-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 95;
  box-sizing: border-box;
  max-height: 55vh;
  padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 48rpx 48rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 48rpx rgba(0, 0, 0, 0.1);
  overflow-y: auto;
  animation: xfXiaowanziShareSlideUp 0.25s ease both;
}

.xf-xiaowanzi-share-select-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  color: #11143b;
  font-size: 34rpx;
  font-weight: 400;
}

.xf-xiaowanzi-share-select-head button {
  padding: 8rpx 24rpx;
  color: #7c34e8;
  font-size: 30rpx;
  font-weight: 400;
}

.xf-xiaowanzi-share-select-channels {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.xf-xiaowanzi-share-count {
  display: block;
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 400;
}

.xf-xiaowanzi-share-channel-row {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 4px;
}

.xf-xiaowanzi-share-channel {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
  min-width: 90px;
  gap: 10px;
  padding: 16px 12px;
  border-radius: 16px;
  background: transparent;
  color: #4b5563;
  font-size: 12px;
  font-weight: 400;
  transition: background 0.15s ease, transform 0.15s ease;
}

.xf-xiaowanzi-share-channel.is-pressed {
  background: #f5f3ff;
  transform: translateY(-2px);
}

.xf-xiaowanzi-share-channel[disabled] {
  opacity: 0.35;
}

.xf-xiaowanzi-share-channel-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: linear-gradient(180deg, #fbf9ff 0%, #f0eaff 100%);
  color: #7c34e8;
  box-shadow: 0 3px 8px rgba(124, 52, 232, 0.08);
  transition: box-shadow 0.15s ease, transform 0.15s ease;
}

.xf-xiaowanzi-share-channel-icon-img {
  display: block;
  width: 30px;
  height: 30px;
}

.xf-xiaowanzi-share-channel.is-pressed .xf-xiaowanzi-share-channel-icon {
  box-shadow: 0 5px 12px rgba(124, 52, 232, 0.12);
  transform: scale(0.98);
}

.xf-xiaowanzi-share-privacy {
  display: block;
  margin-top: 16rpx;
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 400;
  text-align: center;
}

.xf-xiaowanzi-share-error {
  display: block;
  color: #b91c1c;
  font-size: 22rpx;
  line-height: 1.5;
}

.xf-xiaowanzi-share-channel-label {
  white-space: nowrap;
}

.xf-xiaowanzi-share-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  background: rgba(15, 23, 42, 0.42);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}

.xf-xiaowanzi-share-preview-panel {
  position: fixed;
  left: 10rpx;
  right: 10rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 121;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 70rpx rgba(15, 23, 42, 0.22);
}

.xf-xiaowanzi-share-preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 auto;
  height: 88rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #edf0f7;
  background: #ffffff;
}

.xf-xiaowanzi-share-preview-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1;
}

.xf-xiaowanzi-share-preview-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #6b7280;
  font-size: 46rpx;
  font-weight: 300;
  line-height: 1;
}

.xf-xiaowanzi-share-preview-scroll {
  flex: 1 1 auto;
  min-height: 0;
  padding: 18rpx 16rpx 22rpx;
  box-sizing: border-box;
  background: #f8f7fc;
}

.xf-xiaowanzi-share-preview-image {
  display: block;
  width: 100%;
  border-radius: 20rpx;
}

.xf-xiaowanzi-share-preview-actions {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #edf0f7;
  background: #ffffff;
}

.xf-xiaowanzi-share-preview-guide {
  color: #8a90a6;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.3;
  text-align: center;
}

.xf-xiaowanzi-share-preview-save {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  height: 72rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7c34e8 0%, #6d28f2 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
  box-shadow: 0 16rpx 32rpx rgba(109, 40, 242, 0.22);
}

.xf-xiaowanzi-share-preview-save.is-pressed {
  transform: translateY(2rpx);
  box-shadow: 0 10rpx 22rpx rgba(109, 40, 242, 0.18);
}

.xf-xiaowanzi-child-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(15, 23, 42, 0.36);
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
}

.xf-xiaowanzi-child-picker-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  box-sizing: border-box;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fbf9ff;
  box-shadow: 0 -8rpx 48rpx rgba(0, 0, 0, 0.1);
  animation: xfXiaowanziShareSlideUp 0.25s ease both;
}

.xf-xiaowanzi-child-picker-title {
  display: block;
  margin-bottom: 18rpx;
  color: #11143b;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.35;
}

.xf-xiaowanzi-child-picker-empty {
  margin-bottom: 20rpx;
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.35;
}

.xf-xiaowanzi-child-picker-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.xf-xiaowanzi-child-picker-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 2rpx solid #e5e7f2;
  border-radius: 24rpx;
  background: #ffffff;
}

.xf-xiaowanzi-child-picker-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e4e7ff;
  color: #4338ca;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1;
}

.xf-xiaowanzi-child-picker-main {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  flex-direction: column;
}

.xf-xiaowanzi-child-picker-name {
  overflow: hidden;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-xiaowanzi-child-picker-tag {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.2;
}

.xf-xiaowanzi-child-picker-select {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 98rpx;
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7c34e8 0%, #7f37ea 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
  box-shadow: 0 16rpx 32rpx rgba(124, 52, 232, 0.2);
}

.xf-xiaowanzi-child-picker-actions {
  display: flex;
  gap: 16rpx;
}

.xf-xiaowanzi-child-picker-cancel,
.xf-xiaowanzi-child-picker-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  height: 64rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

.xf-xiaowanzi-child-picker-cancel {
  border: 2rpx solid rgba(124, 52, 232, 0.26);
  background: rgba(124, 52, 232, 0.04);
  color: #7c34e8;
}

.xf-xiaowanzi-child-picker-primary {
  background: linear-gradient(135deg, #7c34e8 0%, #7f37ea 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 32rpx rgba(124, 52, 232, 0.18);
}

@keyframes xfXiaowanziShareSlideUp {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.xf-xiaowanzi-toast {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 200;
  transform: translate(-50%, -50%);
  padding: 24rpx 48rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.76);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  pointer-events: none;
}

.xf-xiaowanzi-share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  opacity: 0;
  pointer-events: none;
}

.xf-xiaowanzi-archive-scrim {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  z-index: 100200;
  width: 16vw;
  background: rgba(15, 12, 35, 0.42);
}

.xf-xiaowanzi-archive-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100201;
  width: 84vw;
  height: 100vh;
  box-sizing: border-box;
  padding: 86rpx 28rpx 56rpx;
  background: #f6f7fb;
  border-radius: 0 0 0 36rpx;
  box-shadow: -22rpx 0 52rpx rgba(31, 20, 71, 0.16);
  overflow-y: auto;
}
