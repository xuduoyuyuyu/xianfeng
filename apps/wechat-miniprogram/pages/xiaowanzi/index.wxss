@import "../mine/profile-panel.wxss";

@font-face {
  font-family: "Material Symbols Rounded";
  src: url("/assets/fonts/material-symbols-rounded.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: block;
}

page {
  min-height: 100vh;
  background: #e9edff;
}

.xf-xiaowanzi-page {
  min-height: 100vh;
  color: #101433;
  background:
    radial-gradient(circle at 74% 2%, rgba(255, 228, 236, 0.9) 0, rgba(255, 228, 236, 0) 34%),
    radial-gradient(circle at 16% 10%, rgba(211, 218, 255, 0.92) 0, rgba(211, 218, 255, 0) 40%),
    linear-gradient(180deg, #f2f1ff 0%, #e9edff 100%);
}

.xf-xiaowanzi-page,
.xf-xiaowanzi-page view,
.xf-xiaowanzi-page text,
.xf-xiaowanzi-page button,
.xf-xiaowanzi-page input,
.xf-xiaowanzi-page textarea {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-weight: 500;
}

.xf-xiaowanzi-native-shell {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  pointer-events: none;
}

.xf-xiaowanzi-topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  box-sizing: border-box;
  background: transparent;
}

.xf-xiaowanzi-home-entry,
.xf-xiaowanzi-menu-entry,
.xf-xiaowanzi-knowledge-pill,
.xf-xiaowanzi-login-gate,
.xf-xiaowanzi-inline-action,
.xf-xiaowanzi-card-share,
.xf-xiaowanzi-child-link,
.xf-xiaowanzi-voice,
.xf-xiaowanzi-send,
.xf-xiaowanzi-plus,
.xf-xiaowanzi-attach-action,
.xf-xiaowanzi-history-new,
.xf-xiaowanzi-history-exit,
.xf-xiaowanzi-share-check,
.xf-xiaowanzi-share-select-head button,
.xf-xiaowanzi-share-channel,
.xf-xiaowanzi-share-preview-close,
.xf-xiaowanzi-share-preview-save,
.xf-xiaowanzi-child-picker-select,
.xf-xiaowanzi-child-picker-cancel,
.xf-xiaowanzi-child-picker-primary {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
}

.xf-xiaowanzi-home-entry::after,
.xf-xiaowanzi-menu-entry::after,
.xf-xiaowanzi-knowledge-pill::after,
.xf-xiaowanzi-login-gate::after,
.xf-xiaowanzi-inline-action::after,
.xf-xiaowanzi-card-share::after,
.xf-xiaowanzi-child-link::after,
.xf-xiaowanzi-voice::after,
.xf-xiaowanzi-send::after,
.xf-xiaowanzi-plus::after,
.xf-xiaowanzi-attach-action::after,
.xf-xiaowanzi-history-new::after,
.xf-xiaowanzi-history-exit::after,
.xf-xiaowanzi-share-check::after,
.xf-xiaowanzi-share-select-head button::after,
.xf-xiaowanzi-share-channel::after,
.xf-xiaowanzi-share-preview-close::after,
.xf-xiaowanzi-share-preview-save::after,
.xf-xiaowanzi-child-picker-select::after,
.xf-xiaowanzi-child-picker-cancel::after,
.xf-xiaowanzi-child-picker-primary::after {
  border: 0;
}

.xf-xiaowanzi-home-entry {
  position: absolute;
  left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  border-radius: 50%;
  background: transparent;
  color: #4f5878;
  pointer-events: auto;
}

.xf-xiaowanzi-home-entry.is-pressed,
.xf-xiaowanzi-menu-entry.is-pressed {
  opacity: 0.55;
}

.xf-xiaowanzi-back-mark {
  position: relative;
  display: block;
  width: 16rpx;
  height: 20rpx;
  transform: translate(3rpx, 2rpx);
}

.xf-xiaowanzi-back-mark::before,
.xf-xiaowanzi-back-mark::after {
  position: absolute;
  top: 8.5rpx;
  left: 0;
  width: 14rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #1d2f42;
  transform-origin: left center;
  content: "";
}

.xf-xiaowanzi-back-mark::before {
  transform: rotate(-45deg);
}

.xf-xiaowanzi-back-mark::after {
  transform: rotate(45deg);
}

.xf-xiaowanzi-menu-mark,
.xf-xiaowanzi-menu-mark::before {
  display: block;
  width: 26rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #334155;
  content: "";
}

.xf-xiaowanzi-menu-mark {
  position: relative;
  transform: translateY(-5rpx);
}

.xf-xiaowanzi-menu-mark::before {
  position: absolute;
  top: 10rpx;
  left: 0;
  width: 18rpx;
}

.xf-xiaowanzi-menu-entry {
  position: absolute;
  left: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  color: #38405f;
  pointer-events: auto;
}

.xf-xiaowanzi-knowledge-pill {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3.5px;
  width: 86px;
  box-sizing: border-box;
  padding: 0 5px 0 1.5px;
  border: 1px solid rgba(124, 77, 255, 0.22);
  border-radius: 999rpx;
  background: rgba(91, 72, 255, 0.06);
  color: #4f5878;
  font-size: 12.6px;
  font-weight: 400;
  box-shadow: none;
  overflow: hidden;
  pointer-events: auto;
  transition: width 180ms ease, padding 180ms ease, background 180ms ease;
}

.xf-xiaowanzi-knowledge-title {
  display: block;
  width: 43.2px;
  height: 13.7px;
  overflow: hidden;
  opacity: 1;
  transition: opacity 120ms ease, width 180ms ease;
}

.xf-xiaowanzi-knowledge-pill.is-collapsed {
  width: 34px;
  padding: 0;
  gap: 0;
  background: rgba(255, 255, 255, 0.82);
  aspect-ratio: 1 / 1;
}

.xf-xiaowanzi-knowledge-pill.is-collapsed .xf-xiaowanzi-knowledge-title {
  width: 0;
  opacity: 0;
}

.xf-xiaowanzi-knowledge-logo {
  flex: 0 0 auto;
  width: 27.9px;
  height: 27.9px;
  border-radius: 50%;
  filter: drop-shadow(0 8rpx 16rpx rgba(92, 75, 190, 0.22));
  transform: none;
}

.xf-xiaowanzi-knowledge-pill.is-collapsed .xf-xiaowanzi-knowledge-logo {
  transform: translateX(0);
}

.xf-xiaowanzi-login-gate {
  position: fixed;
  inset: 0;
  z-index: 100300;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.01);
  color: transparent;
  line-height: 1;
  overflow: hidden;
  pointer-events: auto;
}

.xf-xiaowanzi-login-sr {
  position: absolute;
  left: 0;
  top: 0;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
}

.xf-xiaowanzi-child-boundary {
  position: absolute;
  left: 52rpx;
  right: 52rpx;
  display: block;
  box-sizing: border-box;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #6558e8;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.35;
  text-align: center;
  box-shadow: 0 14rpx 34rpx rgba(105, 87, 214, 0.08);
  pointer-events: none;
}

.xf-xiaowanzi-chat-list {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 84px;
  z-index: 2;
  box-sizing: border-box;
  padding: 0 28rpx 12px;
  background: transparent;
}

.xf-xiaowanzi-chat-list.is-home {
  bottom: 84px;
  padding: 0 28rpx 12px;
}

.xf-xiaowanzi-chat-list.has-attachment-menu {
  bottom: calc(170px + env(safe-area-inset-bottom));
}

.xf-xiaowanzi-chat-list.has-share-selection {
  z-index: 85;
}

.xf-xiaowanzi-chat-list.has-attachment-menu .xf-xiaowanzi-home {
  padding-top: 60rpx;
}

.xf-xiaowanzi-chat-list.has-attachment-menu .xf-xiaowanzi-hero {
  min-height: 132px;
  padding-bottom: 12rpx;
}

.xf-xiaowanzi-chat-list.has-attachment-menu .xf-xiaowanzi-prompt-panel {
  margin-bottom: 72rpx;
}

.xf-xiaowanzi-home {
  box-sizing: border-box;
  min-height: 100%;
  padding: calc(44rpx + 5px) 0 40rpx;
}

.xf-xiaowanzi-hero {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 132px;
  padding: 0 8px 8rpx 4px;
}

.xf-xiaowanzi-hero-bot {
  flex: 0 0 auto;
  width: 105.6px;
  height: 105.6px;
  margin-right: 20px;
}

.xf-xiaowanzi-hero-copy {
  flex: 1 1 auto;
  min-width: 0;
  padding-top: 0;
}

.xf-xiaowanzi-hello-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.xf-xiaowanzi-hello {
  color: #111631;
  font-size: 24px;
  font-weight: 500;
  line-height: 1;
  animation: xfXiaowanziHomeHelloIn 0.38s 0.58s cubic-bezier(0.2, 0.9, 0.22, 1) both;
}

.xf-xiaowanzi-spark {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #6d4bff;
  box-shadow: 0 18rpx 46rpx rgba(91, 71, 205, 0.1);
  animation:
    xfXiaowanziHomeSparkPop 0.48s 0.74s cubic-bezier(0.18, 0.92, 0.2, 1) both,
    xfXiaowanziHomeSparkBreathe 1.8s 1.35s ease-in-out infinite;
}

.xf-xiaowanzi-spark::before,
.xf-xiaowanzi-spark::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7px;
  height: 17px;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(45deg);
}

.xf-xiaowanzi-spark::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.xf-xiaowanzi-hero-title {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  color: #3f3bdc;
  font-size: 27px;
  font-weight: 500;
  line-height: 1.22;
  white-space: normal;
}

.xf-xiaowanzi-hero-title-line {
  display: flex;
  flex-wrap: nowrap;
  min-height: 1.22em;
  white-space: nowrap;
}

.xf-xiaowanzi-hero-title-char {
  display: inline-block;
  flex: 0 0 auto;
  opacity: 0;
  transform: translateY(8px);
  filter: blur(6px);
  animation: xfXiaowanziHomeTitleCharIn 0.34s cubic-bezier(0.2, 0.9, 0.22, 1) both;
}

@keyframes xfXiaowanziHomeHelloIn {
  0% {
    opacity: 0;
    transform: translateY(10px) scale(0.94);
    filter: blur(7px);
  }

  70% {
    opacity: 1;
    transform: translateY(-2px) scale(1.03);
    filter: blur(0);
  }

  100% {
    opacity: 1;
    transform: none;
    filter: none;
  }
}

@keyframes xfXiaowanziHomeTitleCharIn {
  0% {
    opacity: 0;
    transform: translateY(8px);
    filter: blur(6px);
  }

  70% {
    opacity: 1;
    transform: translateY(-1px);
    filter: blur(0);
  }

  100% {
    opacity: 1;
    transform: none;
    filter: none;
  }
}

@keyframes xfXiaowanziHomeSparkPop {
  0% {
    opacity: 0;
    transform: scale(0.45) rotate(-24deg);
    filter: blur(4px);
  }

  58% {
    opacity: 1;
    transform: scale(1.18) rotate(8deg);
    filter: blur(0);
  }

  100% {
    opacity: 1;
    transform: scale(1) rotate(0);
    filter: none;
  }
}

@keyframes xfXiaowanziHomeSparkBreathe {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 18rpx 46rpx rgba(91, 71, 205, 0.1);
  }

  50% {
    transform: scale(1.08);
    box-shadow: 0 0 18px rgba(124, 77, 255, 0.22), 0 18rpx 46rpx rgba(91, 71, 205, 0.12);
  }
}

.xf-xiaowanzi-prompt-panel {
  box-sizing: border-box;
  margin: 0 0 18px;
  padding: 11px 10px;
  border: 1px solid rgba(255, 255, 255, 0.86);
  border-radius: 30px;
  background: rgba(255, 255, 255, 0.54);
  box-shadow:
    inset 0 -4px 0 rgba(255, 255, 255, 0.3),
    0 18px 38px rgba(70, 73, 132, 0.08);
}

.xf-xiaowanzi-prompt-heading {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
  color: #121735;
  font-size: 21px;
  font-weight: 500;
  line-height: 1;
}

.xf-xiaowanzi-prompt-bar {
  display: block;
  width: 7px;
  height: 28px;
  margin-right: 0;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #7b55ff 0%, #59a2ff 100%);
}

.xf-xiaowanzi-prompt-card {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 68px;
  box-sizing: border-box;
  margin: 0 0 14px;
  padding: 0 15px;
  border: 0;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.94);
  color: #111631;
  box-shadow: 0 8px 18px rgba(72, 75, 132, 0.06);
}

.xf-xiaowanzi-prompt-card::after {
  border: 0;
}

.xf-xiaowanzi-prompt-card:last-child {
  margin-bottom: 0;
}

.xf-xiaowanzi-prompt-card + .xf-xiaowanzi-home-user-preview {
  margin-top: 42rpx;
}

.xf-xiaowanzi-prompt-mark {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 38px;
  height: 38px;
  color: #6835f5;
  font-size: 24px;
  font-weight: 500;
  line-height: 1;
}

.xf-xiaowanzi-prompt-mark::before {
  content: "#";
  display: block;
  transform: translateY(-1px);
}

.xf-xiaowanzi-prompt-mark::after {
  content: "";
  display: none;
}

.xf-xiaowanzi-prompt-text {
  flex: 1 1 auto;
  min-width: 0;
  color: #111631;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.24;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-xiaowanzi-prompt-card.is-compact .xf-xiaowanzi-prompt-text {
  font-size: 16px;
}

.xf-xiaowanzi-prompt-arrow {
  position: relative;
  flex: 0 0 auto;
  width: 26px;
  height: 48px;
  color: #b5b9ca;
}

.xf-xiaowanzi-prompt-arrow::before {
  content: "";
  position: absolute;
  right: 3px;
  top: 22px;
  width: 20px;
  height: 2px;
  border-radius: 999rpx;
  background: currentColor;
}

.xf-xiaowanzi-prompt-arrow::after {
  content: "";
  position: absolute;
  right: 3px;
  top: 16px;
  width: 12px;
  height: 12px;
  box-sizing: border-box;
  border-top: 2px solid currentColor;
  border-right: 2px solid currentColor;
  transform: rotate(45deg);
}

.xf-xiaowanzi-home-user-preview {
  display: flex;
  justify-content: flex-end;
  width: 100%;
  box-sizing: border-box;
}

.xf-xiaowanzi-home-user-preview text {
  display: block;
  max-width: 600rpx;
  box-sizing: border-box;
  padding: 28rpx 42rpx 30rpx;
  border-radius: 34rpx 8rpx 34rpx 34rpx;
  background: linear-gradient(108deg, #5368ff 0%, #6847ff 56%, #601bec 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.42;
  text-align: left;
  box-shadow: 0 18rpx 42rpx rgba(96, 27, 236, 0.22);
}

.xf-xiaowanzi-home-thread {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

.xf-xiaowanzi-prompt-card + .xf-xiaowanzi-home-thread {
  margin-top: 42rpx;
}

.xf-xiaowanzi-home-message {
  position: relative;
  display: flex;
  width: 100%;
  box-sizing: border-box;
}

.xf-xiaowanzi-home-message.is-user {
  justify-content: flex-end;
}

.xf-xiaowanzi-home-message.is-assistant {
  justify-content: flex-start;
}

.xf-xiaowanzi-home-message.is-selecting {
  padding: 0;
}

.xf-xiaowanzi-home-assistant-wrap {
  position: relative;
  flex: 1 1 auto;
  min-width: 0;
  box-sizing: border-box;
  padding-bottom: 0;
}

.xf-xiaowanzi-home-assistant-wrap.is-thinking {
  padding-bottom: 0;
}

.xf-xiaowanzi-home-assistant-card {
  box-sizing: border-box;
  width: 100%;
  padding: 30rpx 30rpx 32rpx;
  border: 1rpx solid rgba(122, 103, 238, 0.1);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #11143b;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.82;
  box-shadow:
    0 10rpx 24rpx rgba(72, 75, 132, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.xf-xiaowanzi-message-link {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 100%;
  min-height: 88rpx;
  margin: 2rpx 0 8rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(115, 83, 224, 0.24);
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(126, 95, 255, 0.14) 0%, rgba(217, 196, 255, 0.22) 100%);
  box-sizing: border-box;
  color: #6845e8;
  font: inherit;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.34;
  text-align: left;
  text-decoration: none;
  box-shadow:
    0 12rpx 24rpx rgba(100, 82, 186, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.xf-xiaowanzi-message-link-body {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-xiaowanzi-message-link-text {
  display: -webkit-box;
  color: #2a2350;
  overflow-wrap: anywhere;
  word-break: break-word;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.xf-xiaowanzi-message-link-arrow {
  flex: 0 0 auto;
  margin-left: 18rpx;
  color: #6a42e8;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
}

.xf-xiaowanzi-message-link::after {
  border: 0;
}

.xf-xiaowanzi-md-heading {
  display: block;
  margin: 24rpx 0 12rpx;
  color: #111936;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.56;
}

.xf-xiaowanzi-md-heading:first-child {
  margin-top: 0;
}

.xf-xiaowanzi-md-paragraph {
  display: block;
  margin: 0 0 22rpx;
  color: #11143b;
  font-size: 28rpx;
  font-weight: inherit;
  line-height: 1.82;
  white-space: pre-wrap;
}

.xf-xiaowanzi-md-paragraph:last-child {
  margin-bottom: 0;
}

.xf-xiaowanzi-md-list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 10rpx 0;
  color: #11143b;
  font-size: 28rpx;
  font-weight: inherit;
  line-height: 1.72;
}

.xf-xiaowanzi-md-list-bullet {
  flex: 0 0 18rpx;
  width: 18rpx;
  color: #6d28f2;
  font-weight: 500;
  line-height: inherit;
}

.xf-xiaowanzi-md-list-text {
  flex: 1 1 auto;
  min-width: 0;
  line-height: inherit;
}

.xf-xiaowanzi-md-list-item + .xf-xiaowanzi-md-paragraph,
.xf-xiaowanzi-md-paragraph + .xf-xiaowanzi-md-list-item {
  margin-top: 16rpx;
}

.xf-xiaowanzi-home-thinking {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 226rpx;
  min-height: 86rpx;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
  border: 2rpx solid rgba(122, 103, 238, 0.1);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #a78bfa;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
  box-shadow: 0 16rpx 36rpx rgba(72, 75, 132, 0.06);
}

.xf-xiaowanzi-thinking-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  line-height: 1;
}

.xf-xiaowanzi-thinking-dot {
  display: block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
  animation: xfXiaowanziThinkingDot 1.4s ease-in-out infinite;
}

.xf-xiaowanzi-thinking-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.xf-xiaowanzi-thinking-dot.is-strong {
  animation-delay: 0.4s;
}

.xf-xiaowanzi-thinking-label {
  margin-left: 12rpx;
  animation: xfXiaowanziThinkingLabel 2s ease-in-out infinite;
}

.xf-xiaowanzi-thinking-trace {
  max-width: 560rpx;
  min-height: 32rpx;
  margin-top: 8rpx;
  color: #6f74a8;
  font-size: 22rpx;
