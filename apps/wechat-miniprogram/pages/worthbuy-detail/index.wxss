@import "../../styles/native-list.wxss";

page{background:#f8f6ff;color:#1e1b4b}.wbd-page{min-height:100vh;padding-bottom:calc(150rpx + env(safe-area-inset-bottom));box-sizing:border-box}.wbd-topbar{position:fixed;z-index:20;left:0;right:0;top:0;background:rgba(255,255,255,.98);display:flex;align-items:flex-end;justify-content:center;padding-bottom:18rpx;box-sizing:border-box;border-bottom:1rpx solid #eee8f5}.wbd-topbar>text{font-size:29rpx;font-weight:700}.wbd-content{padding:38rpx 24rpx 0}.wbd-page-title{display:block;font-size:43rpx;line-height:1.3;font-weight:800;color:#1e1b4b}.wbd-page-subtitle{display:block;margin:14rpx 0 40rpx;color:#9ca3af;font-size:27rpx}.wbd-state{padding:100rpx 40rpx;text-align:center;color:#81778d}.wbd-state button{margin-top:20rpx;color:#7c3aed;background:#fff}

.wbd-card{margin-bottom:28rpx;padding:34rpx;background:#fff;border:2rpx solid #f3f0ff;border-radius:32rpx;box-sizing:border-box}.wbd-trust-card{display:flex;flex-direction:column;align-items:center;text-align:center;padding-top:48rpx;padding-bottom:48rpx}.wbd-trust-title{font-size:31rpx;font-weight:800;letter-spacing:3rpx}.wbd-gauge{position:relative;width:360rpx;height:360rpx;margin:26rpx auto 0;display:flex;align-items:center;justify-content:center}.wbd-gauge-canvas{position:absolute;inset:0;width:360rpx;height:360rpx}.wbd-gauge-inner{position:relative;z-index:1;width:296rpx;height:296rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center}.wbd-gauge-inner text{font-size:84rpx;font-weight:800}.wbd-score-label{margin-top:28rpx;font-size:35rpx;font-weight:700}.wbd-brand{margin-top:30rpx;font-size:28rpx;font-weight:700}.wbd-tags{margin-top:22rpx;display:flex;justify-content:center;align-items:center;gap:16rpx;flex-wrap:wrap}.wbd-tax,.wbd-price{padding:12rpx 24rpx;border-radius:999rpx;font-size:27rpx;font-weight:700}.wbd-tax.good{background:#ecfdf5;color:#059669}.wbd-tax.warn{background:#fffbeb;color:#d97706}.wbd-price{background:#f3eeff;color:#7c3aed}.wbd-reason{margin-top:28rpx;color:#6b7280;font-size:27rpx;line-height:1.8}.wbd-audience{margin-top:20rpx;display:flex;justify-content:center;gap:10rpx;flex-wrap:wrap}.wbd-audience text,.chips text{padding:8rpx 16rpx;border-radius:14rpx;font-size:23rpx}.wbd-audience .good,.chips .good{background:#ecfdf5;color:#059669}.wbd-audience .warn,.chips .warn{background:#fef2f2;color:#dc2626}

.section-title{display:block;margin-bottom:28rpx;font-size:30rpx;font-weight:750}.section-title.good{color:#059669}.section-title.warn{color:#dc2626}.dimension{display:grid;grid-template-columns:112rpx minmax(0,1fr) 54rpx;gap:16rpx;align-items:center;margin:24rpx 0}.dimension-label{color:#6b7280;font-size:26rpx;text-align:right}.dimension-track{height:20rpx;background:#f3f0ff;border-radius:999rpx;overflow:hidden}.dimension-fill{height:100%;border-radius:999rpx}.dimension-score{font-size:27rpx}.cols{display:grid;grid-template-columns:1fr 1fr;gap:28rpx}.body,.bullet{display:block;color:#6b7280;font-size:27rpx;line-height:1.8}.bullet{position:relative;padding-left:24rpx;margin:10rpx 0}.bullet::before{content:"•";position:absolute;left:0;color:#8b5cf6}.chips{display:flex;gap:10rpx;flex-wrap:wrap}.alternative{padding:20rpx 0;border-top:1rpx solid #f3f0ff;display:flex;flex-direction:column;gap:8rpx;color:#6b7280;font-size:25rpx}.alternative text:first-child{color:#1e1b4b;font-weight:700}.advice{background:#fbf9ff}.wbd-reference{display:flex;align-items:flex-start;gap:14rpx;padding:20rpx 0;border-top:1rpx solid #f3f0ff;color:#4c3b78}.wbd-reference:first-of-type{border-top:0;padding-top:0}.wbd-reference-index{flex:0 0 34rpx;color:#7c3aed;font-size:25rpx;font-weight:700}.wbd-reference-content{min-width:0;flex:1;font-size:25rpx;line-height:1.6;word-break:break-all}.wbd-time{display:block;padding:8rpx 0 24rpx;text-align:center;color:#9ca3af;font-size:22rpx}
