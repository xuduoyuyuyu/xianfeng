page{background:#f8f6ff;color:#20192b}.wbd-page{min-height:100vh}.wbd-topbar{position:fixed;z-index:20;top:0;left:0;right:0;background:#fff;display:flex;align-items:flex-end;justify-content:center;padding-bottom:22rpx;box-sizing:border-box;border-bottom:1rpx solid #eee}.wbd-topbar button{position:absolute;left:18rpx;bottom:7rpx;background:transparent;font-size:55rpx}.wbd-topbar button::after,.wbd-card button::after{border:0}.wbd-topbar text{font-size:31rpx;font-weight:750}.wbd-content{padding:26rpx 22rpx 70rpx}.wbd-card{background:#fff;border:1rpx solid #e4dcec;border-radius:28rpx;padding:28rpx;margin-bottom:20rpx}.hero{display:grid;grid-template-columns:110rpx 1fr;gap:24rpx;background:linear-gradient(145deg,#fff,#f0e7ff)}.wbd-score{width:104rpx;height:104rpx;border-radius:50%;background:#6c27d6;color:#fff;display:flex;align-items:center;justify-content:center}.wbd-score text{font-size:43rpx;font-weight:800}.wbd-score small{font-size:20rpx}.wbd-title{display:block;font-size:38rpx;font-weight:800}.wbd-verdict,.wbd-price{display:inline-block;margin:12rpx 12rpx 0 0;padding:7rpx 14rpx;border-radius:99rpx;font-size:23rpx}.good{color:#18794e;background:#e8f7ef}.warn{color:#b42318;background:#fff0ed}.wbd-price{color:#6c27d6;background:#eee3ff}.wbd-reason{grid-column:1/3;font-size:28rpx;line-height:1.7;color:#62596d}.section-title{display:block;font-size:31rpx;font-weight:800;margin-bottom:18rpx}.dimension{display:grid;grid-template-columns:120rpx 1fr 50rpx;gap:14rpx;align-items:center;margin:16rpx 0}.dimension>view{height:13rpx;background:#eee7f5;border-radius:99rpx;overflow:hidden}.dimension>view>view{height:100%;background:#7a36cf}.cols{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.bullet,.body{display:block;font-size:27rpx;line-height:1.7;color:#5f5668;margin:9rpx 0}.bullet::before{content:'• ';color:#7a36cf}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chips text{padding:10rpx 16rpx;border-radius:99rpx;font-size:24rpx}.alternative{padding:18rpx 0;border-bottom:1rpx solid #eee7f2}.alternative text{display:block;line-height:1.6}.advice{border-color:#d9c5fa;background:#faf6ff}.wbd-card button{text-align:left;background:#f7f3fb;font-size:25rpx;margin:10rpx 0}.wbd-time{display:block;text-align:center;color:#8a8194;font-size:23rpx}.wbd-state{text-align:center;padding:140rpx 30rpx;color:#766d80}.wbd-state text{display:block;margin-bottom:20rpx}
