<view class="wbd-page" style="padding-top: {{topbarHeight}}px;">
  <view class="wbd-topbar" style="height: {{topbarHeight}}px;"><button bindtap="goBack">‹</button><text>知物报告</text></view>
  <view wx:if="{{loading}}" class="wbd-state">正在加载完整分析…</view>
  <view wx:elif="{{error}}" class="wbd-state"><text>{{error}}</text><button bindtap="loadDetail">重试</button><button bindtap="goWorthBuyList">返回知物</button></view>
  <view wx:else class="wbd-content">
    <view class="wbd-card hero"><view class="wbd-score"><text>{{report.score}}</text><small>分</small></view><view><text class="wbd-title">{{report.title}}</text><text class="wbd-verdict {{report.isIqTax ? 'warn' : 'good'}}">{{report.isIqTax ? '谨慎购买' : '值得购买'}}</text><text wx:if="{{report.priceRange}}" class="wbd-price">{{report.priceRange}}</text></view><text wx:if="{{report.reason}}" class="wbd-reason">{{report.reason}}</text></view>
    <view wx:if="{{report.hasDimensions}}" class="wbd-card"><text class="section-title">多维评分</text><view wx:for="{{report.dimensions}}" wx:key="key" class="dimension"><text>{{item.key}}</text><view><view style="width:{{item.score}}%"></view></view><text>{{item.score}}</text></view></view>
    <view wx:if="{{report.hasPros || report.hasCons}}" class="wbd-card cols"><view wx:if="{{report.hasPros}}"><text class="section-title good">优点</text><text wx:for="{{report.pros}}" wx:key="*this" class="bullet">{{item}}</text></view><view wx:if="{{report.hasCons}}"><text class="section-title warn">注意</text><text wx:for="{{report.cons}}" wx:key="*this" class="bullet">{{item}}</text></view></view>
    <view wx:if="{{report.hasBusinessModel}}" class="wbd-card"><text class="section-title">商业模式</text><text class="body">{{report.businessModel}}</text></view>
    <view wx:if="{{report.hasCommentAnalysis}}" class="wbd-card"><text class="section-title">评论分析</text><text class="body">{{report.commentAnalysis}}</text></view>
    <view wx:if="{{report.hasDataPoints}}" class="wbd-card"><text class="section-title">关键依据</text><text wx:for="{{report.dataPoints}}" wx:key="*this" class="bullet">{{item}}</text></view>
    <view wx:if="{{report.hasAudience}}" class="wbd-card"><text class="section-title">适用人群</text><view class="chips"><text wx:for="{{report.suitableFor}}" wx:key="*this" class="good">{{item}}</text><text wx:for="{{report.notSuitableFor}}" wx:key="*this" class="warn">{{item}}</text></view></view>
    <view wx:if="{{report.hasAlternatives}}" class="wbd-card"><text class="section-title">替代方案</text><view wx:for="{{report.alternatives}}" wx:key="name" class="alternative"><text>{{item.name}}</text><text>{{item.price}} · {{item.score}} 分</text><text>{{item.reason}}</text></view></view>
    <view wx:if="{{report.hasRecommendation || report.hasBuyAdvice}}" class="wbd-card advice"><text class="section-title">综合建议</text><text wx:if="{{report.recommendation}}" class="body">{{report.recommendation}}</text><text wx:if="{{report.buyAdvice}}" class="body">{{report.buyAdvice}}</text></view>
    <view wx:if="{{report.hasReferences}}" class="wbd-card"><text class="section-title">参考来源</text><button wx:for="{{report.references}}" wx:key="url" data-url="{{item.url}}" bindtap="copyReference">{{item.title || item.url}} · 复制链接</button></view>
    <text wx:if="{{report.analyzedAt}}" class="wbd-time">分析时间：{{report.analyzedAt}}</text>
  </view>
</view>
