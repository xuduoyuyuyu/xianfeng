@import "../../styles/native-list.wxss";

.xf-materials-page .xf-native-card {
  display: block;
  min-height: 0;
  padding: 22rpx;
  border-color: #e2dcf0;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 36rpx rgba(80, 62, 125, 0.05);
}

.xf-materials-page .xf-native-card-title {
  margin-top: 0;
  color: #2b1a3a;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.28;
}

.xf-materials-field-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.xf-materials-field-tag {
  max-width: 360rpx;
  padding: 4rpx 14rpx;
  overflow: hidden;
  border: 2rpx solid #d5c8ff;
  border-radius: 999rpx;
  background: #f6f0ff;
  color: #5e17eb;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-materials-field-tag.stage {
  border-color: #d5c8ff;
  background: #f6f0ff;
  color: #5e17eb;
}

.xf-materials-field-tag.grade {
  border-color: #d9d8ee;
  background: #f7f7ff;
  color: #4e4c87;
}

.xf-materials-field-tag.subject {
  border-color: #cde6ea;
  background: #f2fbfe;
  color: #25678a;
}

.xf-materials-field-tag.category {
  border-color: #f1d9ee;
  background: #fff5ff;
  color: #8a3daa;
}

.xf-materials-page .xf-native-description {
  margin-top: 16rpx;
  color: #6f62a4;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.5;
}

.xf-materials-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
}

.xf-materials-host {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #9b8ac6;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
  line-height: 54rpx;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.xf-materials-copy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #f3edff;
}

.xf-materials-copy-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.xf-materials-copy-button::after {
  border: 0;
}

.xf-materials-link-mask {
  position: fixed;
  z-index: 90;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(31, 24, 43, 0.42);
}

.xf-materials-link-modal {
  box-sizing: border-box;
  width: 100%;
  max-width: 640rpx;
  padding: 34rpx 32rpx 36rpx;
  border: 2rpx solid #ece6fb;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 80rpx rgba(50, 37, 86, 0.18);
}

.xf-materials-share-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 750px;
  height: 600px;
  pointer-events: none;
}

.xf-materials-link-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.xf-materials-link-title {
  color: #24163a;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.xf-materials-link-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #f3edff;
  color: #5e17eb;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 54rpx;
}

.xf-materials-link-close::after {
  border: 0;
}

.xf-materials-link-name {
  display: block;
  margin-top: 18rpx;
  color: #6f62a4;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.xf-materials-link-url {
  display: block;
  margin-top: 28rpx;
  padding: 22rpx;
  border: 2rpx solid #e2d8ff;
  border-radius: 22rpx;
  background: #f8f5ff;
  color: #5e17eb;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.55;
  user-select: text;
  word-break: break-all;
}
