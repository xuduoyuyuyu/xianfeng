@import "../../styles/native-list.wxss";

.xf-materials-page .xf-native-card {
  display: block;
  min-height: 0;
  padding: 22rpx;
  border-color: #e2dcf0;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 36rpx rgba(80, 62, 125, 0.05);
}

.xf-materials-page .xf-native-card-title {
  margin-top: 0;
  color: #2b1a3a;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.28;
}

.xf-materials-field-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.xf-materials-field-tag {
  max-width: 360rpx;
  padding: 4rpx 14rpx;
  overflow: hidden;
  border: 2rpx solid #d5c8ff;
  border-radius: 999rpx;
  background: #f6f0ff;
  color: #5e17eb;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-materials-field-tag.stage {
  border-color: #d5c8ff;
  background: #f6f0ff;
  color: #5e17eb;
}

.xf-materials-field-tag.grade {
  border-color: #d9d8ee;
  background: #f7f7ff;
  color: #4e4c87;
}

.xf-materials-field-tag.subject {
  border-color: #cde6ea;
  background: #f2fbfe;
  color: #25678a;
}

.xf-materials-field-tag.category {
  border-color: #f1d9ee;
  background: #fff5ff;
  color: #8a3daa;
}

.xf-materials-page .xf-native-description {
  margin-top: 16rpx;
  color: #6f62a4;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.5;
}

.xf-materials-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
}

.xf-materials-host {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #9b8ac6;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
  line-height: 54rpx;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.xf-materials-copy-button {
  flex: 0 0 auto;
  min-width: 156rpx;
  min-height: 54rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: #5e17eb;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 54rpx;
}

.xf-materials-copy-button::after {
  border: 0;
}
