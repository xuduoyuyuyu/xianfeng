  border: 0;
}

.xf-flash-mode-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
}

.xf-flash-mode-icon.is-self,
.xf-flash-mode-icon.is-child {
  border: 0;
  background: #f1eef6;
  color: #6c27d6;
}

.xf-flash-mode-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-flash-mode-copy text:first-child {
  display: block;
  color: #242128;
  font-size: 29rpx;
  font-weight: 900;
}

.xf-flash-mode-copy text:last-child {
  display: block;
  margin-top: 7rpx;
  color: #79737f;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.45;
}

.xf-flash-mode-arrow {
  color: #aaa5ae;
  font-size: 42rpx;
  font-weight: 500;
}

.xf-flash-note,
.xf-flash-result-note {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #eef2ff;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.6;
}

.xf-flash-subject-note {
  margin-top: 20rpx;
  color: #a19ba6;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
}

.xf-flash-age-mask {
  position: fixed;
  inset: 0;
  z-index: 36;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 32rpx;
  background: rgba(29, 27, 33, 0.34);
}

.xf-flash-age-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 660rpx;
  padding: 34rpx;
  border: 2rpx solid #ebe9ee;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 64rpx rgba(29, 27, 33, 0.16);
}

.xf-flash-age-kicker,
.xf-flash-age-title,
.xf-flash-age-copy,
.xf-flash-age-advice {
  display: block;
}

.xf-flash-age-kicker {
  color: #6c27d6;
  font-size: 21rpx;
  font-weight: 900;
}

.xf-flash-age-title {
  margin-top: 12rpx;
  color: #201d27;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.25;
}

.xf-flash-age-copy,
.xf-flash-age-advice {
  color: #68626e;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.65;
}

.xf-flash-age-copy {
  margin-top: 20rpx;
}

.xf-flash-age-advice {
  margin-top: 12rpx;
  color: #8c8691;
}

.xf-flash-age-actions {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 14rpx;
  margin-top: 28rpx;
}

.xf-flash-age-button {
  height: 82rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid #e7e4ea;
  border-radius: 20rpx;
  background: #ffffff;
  color: #68626e;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 80rpx;
}

.xf-flash-age-button::after {
  border: 0;
}

.xf-flash-age-button.is-primary {
  border-color: #6c27d6;
  background: #6c27d6;
  color: #ffffff;
}

.xf-flash-age-button.is-pressed {
  transform: scale(0.98);
}

.xf-flash-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.xf-flash-question-stage {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  padding: 18rpx 26rpx calc(24rpx + env(safe-area-inset-bottom));
}

.xf-flash-questions {
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding-top: 0;
  padding-bottom: 0;
  background: #f7f3ff;
}

.xf-flash-question-hero {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  flex: 0 0 232rpx;
  min-height: 0;
  padding: 26rpx 28rpx;
  overflow: hidden;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-flash-question-hero-copy {
  position: relative;
  z-index: 2;
  width: 62%;
}

.xf-flash-question-display {
  display: block;
  margin-top: 20rpx;
  color: #15123f;
  font-size: 50rpx;
  font-weight: 950;
  line-height: 1.04;
}

.xf-flash-question-hero-art {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 238rpx;
  height: 220rpx;
}

.xf-flash-question-hero-mascot {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 226rpx;
  height: 226rpx;
  transform: rotate(3deg);
}

.xf-flash-question-count-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
  color: #15123f;
}

.xf-flash-question-count {
  font-size: 66rpx;
  font-weight: 950;
  line-height: 1;
}

.xf-flash-question-total {
  margin-left: 8rpx;
  font-size: 27rpx;
  font-weight: 850;
}

.xf-flash-question-mini-art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.72);
  transform: rotate(5deg);
}

.xf-flash-question-mini-art image {
  width: 86rpx;
  height: 86rpx;
}

.xf-flash-dimension-title {
  margin-top: 12rpx;
  color: #101335;
  font-size: 42rpx;
  font-weight: 900;
}

.xf-flash-count {
  flex: 0 0 auto;
  color: #6c27d6;
  font-size: 27rpx;
  font-weight: 900;
}

.xf-flash-progress-track {
  height: 10rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.xf-flash-progress-value {
  height: 100%;
  border-radius: inherit;
  background: #6c27d6;
  transition: width 180ms ease;
}

.xf-flash-hint {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
  text-align: left;
}

.xf-flash-question-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.xf-flash-question-card {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 0;
  overflow: hidden;
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  padding: 30rpx 34rpx 24rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
  transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
}

.xf-flash-question-card.is-answered {
  border-color: #cdb8ff;
}

.xf-flash-question-card.is-sliding {
  border-color: #a98aea;
  box-shadow: 0 24rpx 60rpx rgba(86, 48, 158, 0.13);
  transform: scale(1.008);
}

.xf-flash-question-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.xf-flash-question-number {
  color: #6c27d6;
  font-size: 23rpx;
  font-weight: 900;
}

.xf-flash-answer-label {
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 700;
}

.xf-flash-answer-label.is-selected {
  color: #6c27d6;
}

.xf-flash-question-text {
  min-height: 0;
  margin-top: 22rpx;
  color: #101335;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.55;
}

.xf-flash-scale-caption {
  display: flex;
  justify-content: space-between;
  margin-top: 42rpx;
  padding: 0 6rpx;
  color: #918aa3;
  font-size: 21rpx;
  font-weight: 750;
}

.xf-flash-slider-shell {
  position: relative;
  display: flex;
  align-items: center;
  height: 68rpx;
  margin-top: 10rpx;
}

.xf-flash-slider-track {
  position: absolute;
  top: 50%;
  right: 14rpx;
  left: 14rpx;
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dfe5ee;
  transform: translateY(-50%);
  transition: height 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.xf-flash-slider-fill {
  height: 100%;
  border-radius: inherit;
  background: #6c27d6;
  transition: width 70ms linear;
}

.xf-flash-slider-shell.is-sliding .xf-flash-slider-track {
  height: 16rpx;
}

.xf-flash-slider {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: calc(100% + 8rpx);
  margin: 0 -4rpx;
}

.xf-flash-slider-labels {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 48rpx;
  padding: 0 14rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 700;
}

.xf-flash-slider-label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 34rpx;
  transform-origin: center bottom;
  transition: color 180ms ease, transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.xf-flash-slider-label.is-near {
  color: #7c3aed;
  transform: translateY(-4rpx) scale(1.22);
}

.xf-flash-slider-label.is-current {
  color: #6c27d6;
  font-weight: 900;
  transform: translateY(-10rpx) scale(1.65);
}

.xf-flash-slider-label.is-selected {
  color: #6c27d6;
  font-weight: 900;
  transform: scale(1.15);
}

.xf-flash-message {
  margin-top: 24rpx;
  color: #ff4d67;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.xf-flash-question-actions {
  display: grid;
  flex: 0 0 auto;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.xf-flash-question-nav {
  height: 78rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  background: #ffffff;
  color: #6c27d6;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 76rpx;
  transition: transform 140ms ease;
}

.xf-flash-question-nav::after {
  border: 0;
}

.xf-flash-question-nav.is-next {
  background: #6c27d6;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(108, 39, 214, 0.2);
}

.xf-flash-question-nav.is-pressed {
  transform: scale(0.96);
}

.xf-flash-question-position {
  color: #8a84a0;
  font-size: 22rpx;
  font-weight: 850;
}

.xf-flash-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.xf-flash-primary,
.xf-flash-secondary {
  flex: 1 1 0;
  height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 88rpx;
}

.xf-flash-primary {
  background: #6c27d6;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(108, 39, 214, 0.2);
}

.xf-flash-secondary {
  background: #eef2ff;
  color: #6c27d6;
}

.xf-flash-primary.is-pressed,
.xf-flash-secondary.is-pressed {
  transform: scale(0.98);
}

.xf-flash-primary.is-full,
.xf-flash-secondary.is-full {
  width: 100%;
  margin-top: 30rpx;
}

.xf-flash-result-head {
  text-align: left;
}

.xf-flash-result-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 230rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-flash-result-head {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-flash-result-display {
  margin-top: 20rpx;
  color: #15123f;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.2;
}

.xf-flash-result-icon {
  flex: 0 0 auto;
  width: 148rpx;
  height: 148rpx;
}

.xf-flash-result-head .xf-flash-title {
  font-size: 42rpx;
}

.xf-flash-radar-card {
  display: flex;
  justify-content: center;
  margin-top: 22rpx;
  overflow: hidden;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-flash-radar {
  display: block;
}

.xf-flash-analysis-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 34rpx;
  background: #ffffff;
  color: #101335;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-picture-naming-interpretation {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid #eee8f7;
  text-align: left;
}

.xf-picture-naming-interpretation .xf-flash-analysis-paragraph {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.xf-flash-analysis-eyebrow {
  display: inline-flex;
  width: fit-content;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #efe8ff;
  color: #6c27d6;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-flash-analysis-title {
  margin-top: 16rpx;
  color: #101335;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.xf-flash-analysis-paragraph {
  margin-top: 26rpx;
  color: #475569;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.75;
}

.xf-flash-source-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-flash-source-summary.is-pressed {
  background: #fbf9ff;
}

.xf-flash-source-summary-copy {
  min-width: 0;
}

.xf-flash-source-summary-kicker,
.xf-flash-source-summary-title,
.xf-flash-source-summary-note {
  display: block;
}

.xf-flash-source-summary-kicker {
  color: #6c27d6;
  font-size: 20rpx;
  font-weight: 900;
}

.xf-flash-source-summary-title {
  margin-top: 8rpx;
  color: #29252f;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.45;
}

.xf-flash-source-summary-note {
  margin-top: 7rpx;
  color: #8a8394;
  font-size: 19rpx;
  font-weight: 700;
}

.xf-flash-source-summary-arrow {
  flex: 0 0 auto;
  color: #6c27d6;
  font-size: 42rpx;
  font-weight: 500;
}

.xf-flash-save-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 64rpx;
  margin-top: 18rpx;
  color: #8a8394;
  font-size: 22rpx;
  font-weight: 750;
}

.xf-flash-save-status.saved {
  color: #6c27d6;
}

.xf-flash-save-status.error {
  color: #675f70;
}

.xf-flash-save-retry {
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 999rpx;
  background: #efe8ff;
  color: #6c27d6;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 56rpx;
}

.xf-flash-save-retry::after {
  border: 0;
}

.xf-flash-result-note {
  margin-top: 22rpx;
  text-align: center;
}
