@import "../../styles/native-list.wxss";

page {
  background: #f7f3ff;
  color: #101335;
}

.xf-flash-page {
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  background: #f7f3ff;
  color: #101335;
}

.xf-flash-scroll {
  box-sizing: border-box;
  padding: 0 26rpx 80rpx;
}

.xf-flash-scroll.is-question-mode {
  padding: 0;
}

.xf-picture-naming {
  box-sizing: border-box;
  min-height: 100%;
  padding: 28rpx 26rpx 52rpx;
}

.xf-picture-naming-stage {
  max-width: 760rpx;
  margin: 0 auto;
}

.xf-picture-naming-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.xf-picture-naming-title,
.xf-picture-naming-count,
.xf-picture-naming-photo-note {
  display: block;
}

.xf-picture-naming-title {
  margin-top: 16rpx;
  color: #15123f;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.25;
}

.xf-english-pack-trigger {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: fit-content;
  margin: 18rpx auto 0;
  padding: 9rpx 14rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6c27d6;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 1.2;
}

.xf-english-pack-trigger::after,
.xf-english-result-pack-switch::after,
.xf-english-pack-item::after {
  border: 0;
}

.xf-english-pack-trigger text:last-child {
  color: #8a8394;
  font-weight: 700;
}

.xf-picture-naming-count {
  flex: 0 0 auto;
  padding-top: 12rpx;
  color: #6c27d6;
  font-size: 26rpx;
  font-weight: 900;
}

.xf-picture-naming-card {
  margin-top: 22rpx;
  padding: 0;
  overflow: hidden;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-picture-naming-card.is-photo-view {
  padding: 0;
  overflow: hidden;
}

.xf-picture-naming-photo-shell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 660rpx;
  overflow: hidden;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
}

.xf-picture-naming-photo-shell.is-flipping,
.xf-picture-naming-word-shell.is-flipping {
  opacity: 0.82;
}

.xf-picture-naming-photo {
  display: block;
  width: 100%;
  height: 100%;
}

.xf-picture-naming-word-shell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-sizing: border-box;
  width: 100%;
  height: 660rpx;
  padding: 40rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #f3f0f7;
}

.xf-picture-naming-word-shell.has-no-photo {
  cursor: default;
}

.xf-english-card-flip-hint {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 7rpx;
  padding: 9rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #766d80;
  font-size: 17rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(62, 43, 87, 0.06);
}

.xf-flash-pronunciation-button {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.12);
  border-radius: 999rpx;
  background: #ffffff;
  color: #6c27d6;
  font-size: 19rpx;
  font-weight: 850;
  box-shadow: 0 8rpx 22rpx rgba(73, 41, 120, 0.08);
}

.xf-flash-pronunciation-button.is-playing,
.xf-flash-recognition-focus-character-card.is-playing {
  background: #f0e7ff;
}

.xf-flash-pronunciation-icon {
  width: 30rpx;
  height: 30rpx;
}

.xf-picture-naming-word {
  color: #17133f;
  font-size: 132rpx;
  font-weight: 950;
  letter-spacing: 1rpx;
  line-height: 1.1;
  text-align: center;
}

.xf-picture-naming-ipa {
  color: #736b7d;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.xf-picture-naming-photo-note {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 64rpx;
  margin-top: 0;
  padding: 0 24rpx;
  background: #ffffff;
  color: #8a8394;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.xf-english-result-pack-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.xf-english-result-pack-switch {
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #6c27d6;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1.3;
}

.xf-picture-naming-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.xf-picture-naming-primary,
.xf-picture-naming-skip {
  flex: 1 1 0;
  height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 88rpx;
}

.xf-picture-naming-primary {
  background: #6c27d6;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(108, 39, 214, 0.2);
}

.xf-picture-naming-skip {
  background: #efe8ff;
  color: #6c27d6;
}

.xf-picture-naming-summary {
  margin-top: 22rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-flash-catalog,
.xf-flash-questions,
.xf-flash-result {
  padding-top: 36rpx;
}

.xf-flash-kicker,
.xf-flash-title,
.xf-flash-lead,
.xf-flash-dimension-title,
.xf-flash-hint,
.xf-flash-question-text,
.xf-flash-analysis-eyebrow,
.xf-flash-analysis-title,
.xf-flash-analysis-paragraph,
.xf-flash-result-note {
  display: block;
}

.xf-flash-kicker {
  display: inline-flex;
  width: fit-content;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #efe8ff;
  color: #6c27d6;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-flash-title {
  margin-top: 20rpx;
  color: #101335;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-flash-lead {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.6;
}

.xf-flash-catalog {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-top: 24rpx;
}

.xf-flash-catalog-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 352rpx;
  padding: 28rpx 30rpx 30rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-flash-catalog-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 172rpx;
  height: 172rpx;
  overflow: hidden;
  border-radius: 46rpx;
  background: transparent;
}

.xf-flash-catalog-icon {
  display: block;
  width: 172rpx;
  height: 172rpx;
}

.xf-flash-catalog-hero-copy {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  min-width: 0;
  margin-top: 20rpx;
  text-align: center;
}

.xf-flash-catalog-title,
.xf-flash-catalog-subtitle,
.xf-flash-catalog-foot-title,
.xf-flash-catalog-foot-subtitle {
  display: block;
}

.xf-flash-catalog-title {
  color: #15123f;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-flash-catalog-subtitle {
  margin-top: 12rpx;
  color: #6b6474;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1.45;
}

.xf-flash-catalog-panel {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.38);
}

.xf-flash-test-card {
  display: block;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 26rpx;
  border: 2rpx solid rgba(108, 39, 214, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  color: #101335;
  line-height: normal;
  text-align: left;
  box-shadow: 0 12rpx 30rpx rgba(35, 31, 44, 0.06);
  transition: box-shadow 160ms ease, transform 160ms ease;
}

.xf-flash-test-card.is-pressed {
  box-shadow: 0 8rpx 20rpx rgba(35, 31, 44, 0.06);
  transform: scale(0.985);
}

.xf-flash-test-card + .xf-flash-test-card {
  margin-top: 18rpx;
}

.xf-flash-test-row-head {
  display: grid;
  grid-template-columns: 108rpx minmax(0, 1fr) 30rpx;
  align-items: center;
  gap: 20rpx;
}

.xf-flash-test-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #f5f0ff;
}

.xf-flash-test-icon {
  display: block;
  flex: 0 0 auto;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  border: 0;
  border-radius: 22rpx;
  background: transparent;
}

.xf-flash-test-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-flash-test-badge,
.xf-flash-test-title,
.xf-flash-test-subtitle,
.xf-flash-test-source,
.xf-flash-test-meta {
  display: block;
}

.xf-flash-test-badge {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #f3eaff;
  color: #6c27d6;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-flash-test-title {
  color: #17143d;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1.2;
}

.xf-flash-test-subtitle {
  margin-top: 8rpx;
  color: #777087;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.42;
}

.xf-flash-test-source {
  margin-top: 9rpx;
  color: #8a8394;
  font-size: 19rpx;
  font-weight: 750;
  line-height: 1.35;
}

.xf-flash-test-meta {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #f7f3ff;
  color: #756e82;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
}

.xf-flash-test-facts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  margin-left: 128rpx;
}

.xf-flash-test-card .xf-flash-mode-arrow {
  display: block;
  align-self: center;
  flex: 0 0 auto;
  width: auto;
  height: auto;
  border-radius: 0;
  background: transparent;
  color: #a39cad;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.xf-flash-catalog-foot {
  box-sizing: border-box;
  width: 100%;
  margin-top: auto;
  padding: 48rpx 8rpx 12rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  text-align: center;
  box-shadow: none;
}

.xf-flash-catalog-foot-title {
  color: #6c27d6;
  font-size: 24rpx;
  font-weight: 900;
}

.xf-flash-catalog-foot-subtitle {
  margin-top: 7rpx;
  color: #8a84a0;
  font-size: 21rpx;
  font-weight: 750;
}

.xf-flash-result-display {
  display: block;
}

.xf-flash-recognition {
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  background: #f7f3ff;
}

.xf-flash-recognition-stage {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  padding: 28rpx 26rpx calc(26rpx + env(safe-area-inset-bottom));
}

.xf-flash-recognition-head,
.xf-flash-recognition-card,
.xf-flash-recognition-summary {
  box-sizing: border-box;
  border: 2rpx solid rgba(108, 39, 214, 0.1);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(108, 39, 214, 0.08);
}

.xf-flash-recognition-head {
  padding: 24rpx 28rpx;
}

.xf-flash-recognition-title,
.xf-flash-recognition-lead,
.xf-flash-recognition-character,
.xf-flash-recognition-tip,
.xf-flash-recognition-summary-label,
.xf-flash-recognition-summary-value,
.xf-flash-recognition-summary-meta,
.xf-flash-recognition-summary-caveat {
  display: block;
}

.xf-flash-recognition-list-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: fit-content;
  max-width: 100%;
  margin: 20rpx auto 0;
  padding: 8rpx 4rpx;
  border: 0;
  background: transparent;
  color: #6c27d6;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 1.4;
  text-align: center;
}

.xf-flash-recognition-list-entry text + text {
  margin-left: 6rpx;
}

.xf-flash-recognition-list-entry.is-pressed {
  background: transparent;
  opacity: 0.7;
}

.xf-flash-character-list-mask {
  position: fixed;
  inset: 0;
  z-index: 38;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(29, 27, 33, 0.34);
}

.xf-flash-source-mask {
  z-index: 40;
}

.xf-flash-character-list-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 702rpx;
  max-height: 78vh;
  padding: 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 64rpx rgba(29, 27, 33, 0.18);
}

.xf-flash-character-list-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.xf-flash-character-list-kicker,
.xf-flash-character-list-title,
.xf-flash-character-list-label,
.xf-flash-character-list-empty {
  display: block;
}

.xf-flash-character-list-kicker {
  color: #6c27d6;
  font-size: 21rpx;
  font-weight: 900;
}

.xf-flash-character-list-title {
  margin-top: 8rpx;
  color: #1f1d24;
  font-size: 36rpx;
  font-weight: 950;
}

.xf-flash-character-list-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #f3f2f4;
  color: #77717c;
  font-size: 40rpx;
  line-height: 1;
}

.xf-flash-character-list-tabs {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #f3f0f7;
}

.xf-flash-character-list-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  height: 70rpx;
  padding: 0 12rpx;
  border: 2rpx solid transparent;
  border-radius: 15rpx;
  color: #756e82;
  font-size: 21rpx;
  font-weight: 850;
  white-space: nowrap;
}

.xf-flash-character-list-tab.is-active {
  border-color: #e4d7f7;
  background: #ffffff;
  color: #6c27d6;
  box-shadow: 0 6rpx 16rpx rgba(75, 44, 119, 0.08);
}

.xf-flash-character-list-tab.is-pressed {
  transform: scale(0.98);
}

.xf-flash-character-list-scroll {
  max-height: calc(78vh - 250rpx);
  margin-top: 20rpx;
}

.xf-flash-source-dialog {
  display: flex;
  flex-direction: column;
  height: 84vh;
  max-height: 84vh;
  overflow: hidden;
}

.xf-english-source-dialog {
  height: 68vh;
  max-height: 68vh;
}

.xf-flash-source-disclaimer {
  display: block;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f7f3ff;
  color: #756e82;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.55;
}

.xf-flash-source-scroll {
  flex: 1 1 auto;
  min-height: 0;
  height: 0;
  max-height: none;
  margin-top: 18rpx;
}

.xf-flash-source-item {
  padding: 22rpx;
  border: 2rpx solid #ece7f3;
  border-radius: 22rpx;
  background: #ffffff;
}

.xf-flash-source-item + .xf-flash-source-item {
  margin-top: 16rpx;
}

.xf-flash-source-item-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.xf-flash-source-item-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: #efe8ff;
  color: #6c27d6;
  font-size: 20rpx;
  font-weight: 900;
}

.xf-flash-source-item-heading {
  min-width: 0;
}

.xf-flash-source-item-title,
.xf-flash-source-item-meta,
.xf-flash-source-item-purpose {
  display: block;
}

.xf-flash-source-item-title {
  color: #242128;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.4;
}

.xf-flash-source-item-meta {
  margin-top: 6rpx;
  color: #8a8394;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.45;
}

.xf-flash-source-item-purpose {
  margin-top: 16rpx;
  color: #625b6b;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.55;
}

.xf-flash-source-copy {
  width: fit-content;
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #f3edff;
  color: #6c27d6;
  font-size: 20rpx;
  font-weight: 850;
}

.xf-flash-source-copy.is-pressed {
  background: #e9deff;
}

.xf-flash-character-list-section {
  padding: 24rpx;
  border-radius: 24rpx;
}

.xf-flash-character-list-section.is-known {
  background: #f1f8f4;
}

.xf-flash-character-list-section.is-unknown {
  margin-top: 18rpx;
  background: #f8f5fb;
}

.xf-flash-character-list-label {
  color: #302a37;
  font-size: 25rpx;
  font-weight: 900;
}

.xf-flash-character-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.xf-flash-character-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #171337;
  font-size: 34rpx;
  font-weight: 850;
  box-shadow: 0 6rpx 16rpx rgba(48, 42, 55, 0.06);
  line-height: 64rpx;
  margin: 0;
  padding: 0;
}

.xf-picture-naming-word-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.xf-picture-naming-word-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 68rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #171337;
  font-size: 25rpx;
  font-weight: 850;
  box-shadow: 0 6rpx 16rpx rgba(48, 42, 55, 0.06);
  line-height: 1.2;
  margin: 0;
}

.xf-flash-character-chip::after,
.xf-picture-naming-word-chip::after {
  border: 0;
}

.xf-english-pack-dialog {
  max-height: 78vh;
}

.xf-english-pack-disclaimer {
  display: block;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f3ff;
  color: #766d80;
