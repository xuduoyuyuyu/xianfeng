  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.62;
}

.xf-worthbuy-detail-block + .xf-worthbuy-detail-block {
  margin-top: 30rpx;
}

.xf-worthbuy-detail-audience {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.xf-worthbuy-detail-chip {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.xf-worthbuy-detail-chip.is-good {
  background: #ecfdf5;
  color: #059669;
}

.xf-worthbuy-detail-chip.is-warning {
  background: #fff7ed;
  color: #c2410c;
}

.xf-worthbuy-detail-card.is-advice {
  background: #f4efff;
}

.xf-worthbuy-detail-state {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 180rpx 44rpx 44rpx;
  background: #f8f6ff;
}

.xf-worthbuy-detail-skeleton {
  height: 28rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #e8e1f4;
}

.xf-worthbuy-detail-skeleton.is-title {
  height: 56rpx;
}

.xf-worthbuy-detail-skeleton.is-short {
