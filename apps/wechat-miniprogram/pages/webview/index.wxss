@import "../../styles/native-list.wxss";

page {
  background: #ffffff;
}

.xf-webview-login-gate {
  position: fixed;
  inset: 0;
  z-index: 100300;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.01);
  color: transparent;
  line-height: 1;
}

.xf-webview-login-gate::after {
  display: none;
}

.xf-webview-login-gate.is-binding {
  pointer-events: none;
}

.xf-webview-login-sr {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
}

.xf-program-detail-page {
  position: relative;
  box-sizing: border-box;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #211a18;
}

.xf-program-detail-topbar {
  background: #ffffff;
  box-shadow: none;
}

.xf-program-detail-back-button {
  left: 26rpx;
}

.xf-program-detail-scroll {
  box-sizing: border-box;
  height: 100%;
  padding-bottom: 40rpx;
  background: #ffffff;
}

.xf-program-detail-hero {
  position: relative;
  min-height: 540rpx;
  overflow: hidden;
  background: #5e17eb;
}

.xf-program-detail-hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: grayscale(100%) contrast(118%) brightness(72%);
  opacity: 0.58;
}

.xf-program-detail-hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(94, 23, 235, 0.25), rgba(0, 0, 0, 0.82));
}

.xf-program-detail-hero-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: 540rpx;
  padding: 120rpx 44rpx 72rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  transform: translateY(-48rpx);
}

.xf-program-detail-title {
  display: block;
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.18;
}

.xf-program-detail-description {
  display: -webkit-box;
  margin-top: 24rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.56;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.xf-program-detail-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 42rpx;
}

.xf-program-detail-play,
.xf-program-detail-hero-icon,
.xf-program-detail-secondary,
.xf-program-detail-primary {
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.xf-program-detail-play {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 214rpx;
  height: 76rpx;
  padding: 0 34rpx;
  background: #ffffff;
  color: #5e17eb;
  line-height: 1;
}

.xf-program-detail-hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  padding: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.56);
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 34rpx;
  line-height: 1;
}

.xf-program-detail-hero-icon.is-active {
  background: #ffffff;
  color: #5e17eb;
}

.xf-program-detail-action-icon,
.xf-program-detail-play-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.xf-program-detail-secondary {
  min-width: 142rpx;
  height: 76rpx;
  padding: 0 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  line-height: 76rpx;
}

.xf-program-detail-card {
  box-sizing: border-box;
  margin: 28rpx 28rpx 0;
  padding: 34rpx;
  border: 1rpx solid rgba(94, 23, 235, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 58rpx rgba(54, 43, 84, 0.06);
}

.xf-program-detail-card.is-summary {
  margin-top: -42rpx;
  position: relative;
  z-index: 2;
  overflow: hidden;
}

.xf-program-detail-summary-corner {
  position: absolute;
  top: 0;
  right: 0;
  width: 96rpx;
  height: 96rpx;
  border-bottom-left-radius: 28rpx;
  background: #f3ecff;
}

.xf-program-detail-card-head,
.xf-program-detail-section-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.xf-program-detail-card.is-summary .xf-program-detail-card-head {
  justify-content: center;
  width: fit-content;
  margin: 0 auto 30rpx;
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid #f1edf7;
}

.xf-program-detail-card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: rgba(94, 23, 235, 0.1);
  color: #5e17eb;
  font-size: 28rpx;
  font-weight: 900;
}

.xf-program-detail-card-icon-image {
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.xf-program-detail-card-title,
.xf-program-detail-section-title {
  display: block;
  color: #211a18;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-program-detail-card.is-summary .xf-program-detail-card-title {
  color: #5e17eb;
}

.xf-program-detail-card-subtitle {
  display: block;
  margin-top: 4rpx;
  color: #a2a0aa;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  line-height: 1.2;
}

.xf-program-detail-summary-title {
  display: block;
  margin-top: 30rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #5e17eb;
  color: #211a18;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.xf-program-detail-summary-body,
.xf-program-detail-content-text,
.xf-program-detail-guest-bio {
  display: block;
  color: #5f5552;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.68;
}

.xf-program-detail-summary-body {
  margin-top: 22rpx;
}

.xf-program-detail-highlight {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(94, 23, 235, 0.06);
  color: #211a18;
  font-size: 26rpx;
  line-height: 1.56;
}

.xf-program-detail-highlight-label {
  color: #5e17eb;
  font-weight: 900;
}

.xf-program-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.xf-program-detail-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f2f5;
  color: #6f6670;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.xf-program-detail-content-shell {
  box-sizing: border-box;
  margin: 28rpx 28rpx 0;
  padding: 28rpx;
  border: 1rpx solid rgba(94, 23, 235, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 58rpx rgba(54, 43, 84, 0.06);
}

.xf-program-detail-tabs {
  display: flex;
  width: fit-content;
  max-width: calc(100% - 56rpx);
  margin: 28rpx 28rpx 0;
  padding: 8rpx;
  border: 1rpx solid #e7e3ec;
  border-radius: 999rpx;
  background: #fafafa;
}

.xf-program-detail-content-shell .xf-program-detail-tabs {
  max-width: 100%;
  margin: 0;
}

.xf-program-detail-tab {
  min-width: 144rpx;
  height: 62rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: rgba(33, 26, 24, 0.68);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 62rpx;
}

.xf-program-detail-tab.is-active {
  background: #5e17eb;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(94, 23, 235, 0.22);
}

.xf-program-detail-content-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0eef2;
}

.xf-program-detail-content-row:last-child {
  border-bottom: 0;
}

.xf-program-detail-content-row.is-featured {
  padding: 24rpx;
  border-bottom: 0;
  border-radius: 24rpx;
  background: rgba(94, 23, 235, 0.06);
}

.xf-program-detail-content-row.is-featured .xf-program-detail-content-text {
  color: #211a18;
  font-weight: 800;
}

.xf-program-detail-content-panel {
  margin-top: 32rpx;
}

.xf-program-detail-content-panel.is-mindmap {
  margin-right: 0;
}

.xf-program-detail-mindmap-outline {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.xf-program-detail-mindmap-root {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 26rpx;
  border-left: 6rpx solid #5e17eb;
  border-radius: 12rpx;
  background: #f7f4ff;
}

.xf-program-detail-mindmap-root-label {
  color: #7c34e8;
  font-size: 19rpx;
  font-weight: 800;
}

.xf-program-detail-mindmap-root-title {
  color: #211a18;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.xf-program-detail-mindmap-root-summary {
  color: #726b7a;
  font-size: 23rpx;
  line-height: 1.65;
}

.xf-program-detail-mindmap-branches {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.xf-program-detail-mindmap-branch {
  overflow: hidden;
  border: 1rpx solid #eee8ff;
  border-left: 6rpx solid #7c3aed;
  border-radius: 16rpx;
  background: #ffffff;
}

.xf-program-detail-mindmap-branch-button {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 22rpx 22rpx 22rpx 20rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.xf-program-detail-mindmap-branch-button::after {
  border: 0;
}

.xf-program-detail-mindmap-branch-number {
  flex: 0 0 auto;
  width: 52rpx;
  color: #5e17eb;
  font-size: 22rpx;
  font-weight: 900;
}

.xf-program-detail-mindmap-branch-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 5rpx;
}

.xf-program-detail-mindmap-branch-title {
  color: #211a18;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.4;
}

.xf-program-detail-mindmap-branch-summary,
.xf-program-detail-mindmap-branch-count {
  color: #857f8c;
  font-size: 20rpx;
  line-height: 1.45;
}

.xf-program-detail-mindmap-branch-count {
  color: #5e17eb;
  font-weight: 700;
}

.xf-program-detail-mindmap-toggle {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 38rpx;
  height: 38rpx;
  margin-left: 14rpx;
  border: 2rpx solid #c8b5ff;
  border-radius: 50%;
  background: #ffffff;
  color: #5e17eb;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.xf-program-detail-mindmap-children {
  position: relative;
  display: flex;
  flex-direction: column;
  margin: 0 22rpx 22rpx 72rpx;
  padding-left: 28rpx;
  border-left: 2rpx solid #e8e1f5;
}

.xf-program-detail-mindmap-child {
  position: relative;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0edf4;
}

.xf-program-detail-mindmap-child:last-child {
  border-bottom: 0;
}

.xf-program-detail-mindmap-child-dot {
  position: absolute;
  top: 30rpx;
  left: -36rpx;
  width: 14rpx;
  height: 14rpx;
  border: 5rpx solid #ffffff;
  border-radius: 50%;
  background: #5e17eb;
  box-shadow: 0 0 0 2rpx #d8ccff;
}

.xf-program-detail-mindmap-child-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.xf-program-detail-mindmap-child-title {
  color: #302b33;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.5;
}

.xf-program-detail-mindmap-child-summary {
  color: #857f8c;
  font-size: 21rpx;
  line-height: 1.55;
}

.xf-program-detail-transcript-meta {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}

.xf-program-detail-time,
.xf-program-detail-speaker,
.xf-program-detail-transcript-separator {
  display: block;
  color: #5e17eb;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.3;
}

.xf-program-detail-speaker {
  margin-top: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.xf-program-detail-content-text {
  margin-top: 12rpx;
}

.xf-program-dictionary-term {
  margin: 0 2rpx;
  padding: 1rpx 6rpx;
  border-radius: 8rpx;
  color: #5e17eb;
  background: rgba(94, 23, 235, 0.1);
  font-weight: 800;
}

.xf-program-dictionary-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 16, 28, 0.42);
}

.xf-program-dictionary-sheet {
  box-sizing: border-box;
  width: 100%;
  padding: 34rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
}

.xf-program-dictionary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.xf-program-dictionary-title {
  color: #211a18;
  font-size: 36rpx;
  font-weight: 900;
}

.xf-program-dictionary-close {
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 28rpx;
  background: #f4f0ff;
  color: #5e17eb;
  font-size: 40rpx;
  line-height: 56rpx;
}

.xf-program-dictionary-close::after {
  border: 0;
}

.xf-program-dictionary-definition {
  display: block;
  margin-top: 24rpx;
  color: #4f4854;
  font-size: 28rpx;
  line-height: 1.7;
}

.xf-program-dictionary-aliases {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 22rpx;
  color: #6f6874;
  font-size: 24rpx;
}

.xf-program-dictionary-alias-label {
  color: #5e17eb;
  font-weight: 800;
}

.xf-program-detail-card.is-guest {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.xf-program-detail-card.is-guest.is-centered {
  display: block;
  text-align: center;
}

.xf-program-detail-guest-switcher {
  width: 100%;
  margin: 0 auto 40rpx;
  white-space: nowrap;
}

.xf-program-detail-guest-switcher-inner {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-sizing: border-box;
  min-width: 100%;
  padding: 0 4rpx;
}

.xf-program-detail-guest-pill {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 68rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid #e7e5e4;
  border-radius: 999rpx;
  background: #f5f5f4;
  color: #44403c;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.xf-program-detail-guest-pill::after {
  border: 0;
}

.xf-program-detail-guest-pill.is-active {
  border-color: rgba(94, 23, 235, 0.25);
  background: rgba(94, 23, 235, 0.12);
  color: #5e17eb;
}

.xf-program-detail-guest-pill-avatar {
  display: block;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(94, 23, 235, 0.12);
}

.xf-program-detail-guest-pill-avatar.is-fallback {
  box-sizing: border-box;
  padding: 2rpx;
  background: #ffffff;
}

.xf-program-detail-guest-pill-name {
  line-height: 1;
}

.xf-program-detail-guest-avatar-wrap {
  position: relative;
  flex: 0 0 auto;
  width: 116rpx;
  height: 116rpx;
}

.xf-program-detail-card.is-guest.is-centered .xf-program-detail-guest-avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 188rpx;
  height: 188rpx;
  margin: 0 auto 24rpx;
  padding: 12rpx;
  border: 2rpx solid #eee8ff;
  border-radius: 40rpx;
  background: #f4f0ff;
}

.xf-program-detail-guest-avatar {
  display: block;
  width: 116rpx;
  height: 116rpx;
  border-radius: 28rpx;
  background: #f4f0ff;
}

.xf-program-detail-card.is-guest.is-centered .xf-program-detail-guest-avatar {
  width: 164rpx;
  height: 164rpx;
  border-radius: 32rpx;
}

.xf-program-detail-guest-avatar.is-fallback {
  box-sizing: border-box;
  padding: 12rpx;
  background: #ffffff;
}

.xf-program-detail-guest-wish,
.xf-expert-detail-wish {
  position: absolute;
  right: -16rpx;
  bottom: -16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  min-width: 52rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 32rpx;
  background: #f43f5e;
  box-shadow: 0 8rpx 18rpx rgba(225, 29, 72, 0.24);
}

.xf-program-detail-guest-wish.is-animating,
.xf-expert-detail-wish.is-animating {
  animation: xfReturnWishPulse 300ms ease-out;
}

.xf-program-detail-wish-icon {
  display: block;
  flex: 0 0 auto;
  width: 28rpx;
  height: 28rpx;
}

.xf-program-detail-wish-bubble {
  position: absolute;
  bottom: 0;
  z-index: 12;
  display: block;
  width: 40rpx;
  height: 40rpx;
  pointer-events: none;
  opacity: 0;
  animation-name: xfReturnWishBubble;
  animation-timing-function: ease-out;
  animation-fill-mode: forwards;
}

@keyframes xfReturnWishPulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

@keyframes xfReturnWishBubble {
  0% { opacity: 1; transform: translateY(0) scale(0.5) rotate(0deg); }
  30% { opacity: 1; transform: translateY(-80rpx) scale(1.2) rotate(10deg); }
  60% { opacity: 0.8; transform: translateY(-160rpx) scale(1) rotate(-5deg); }
  100% { opacity: 0; transform: translateY(-280rpx) scale(0.6) rotate(15deg); }
}

.xf-program-detail-guest-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-program-detail-guest-name {
  display: block;
  color: #211a18;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.xf-program-detail-guest-title {
  display: block;
  margin-top: 8rpx;
  color: #5e17eb;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
  line-height: 1.3;
}

.xf-program-detail-guest-bio {
  margin-top: 18rpx;
}

.xf-program-detail-card.is-guest.is-centered .xf-program-detail-guest-bio {
  max-width: 560rpx;
  margin: 24rpx auto 0;
}

.xf-program-detail-guest-profile {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 70rpx;
  margin: 24rpx 0 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: #5e17eb;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 70rpx;
}

.xf-program-detail-card.is-guest.is-centered .xf-program-detail-guest-profile {
  height: 98rpx;
  border-radius: 18rpx;
  box-shadow: 0 16rpx 34rpx rgba(94, 23, 235, 0.2);
}

.xf-program-detail-guest-profile-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.xf-program-detail-card.is-extension {
  background: #fbf9ff;
}

.xf-program-detail-extension-label {
  display: block;
  margin-top: 28rpx;
  color: #a2a0aa;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
  line-height: 1.3;
}

.xf-program-detail-extension-list {
  margin-top: 18rpx;
}

