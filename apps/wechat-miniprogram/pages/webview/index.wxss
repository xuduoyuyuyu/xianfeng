}

.xf-worthbuy-detail-error {
  display: block;
  color: #171437;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.5;
  text-align: center;
}

.xf-worthbuy-detail-primary {
  width: 100%;
  height: 84rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: 999rpx;
  background: #5e17eb;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.xf-worthbuy-detail-primary.is-bottom {
  margin-top: 28rpx;
}

.xf-worthbuy-detail-primary::after {
  border: 0;
}
