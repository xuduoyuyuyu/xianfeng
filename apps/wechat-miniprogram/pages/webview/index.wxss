.xf-topic-detail-page {
  min-height: 100vh;
  background: #f8f6ff;
  color: #1f1736;
}

.xf-topic-detail-scroll {
  box-sizing: border-box;
  height: 100vh;
  padding: 28rpx 24rpx 150rpx;
