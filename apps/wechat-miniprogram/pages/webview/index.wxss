}

.xf-material-detail-info-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0eef7;
}

.xf-material-detail-info-row:first-child {
  padding-top: 0;
}

.xf-material-detail-info-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.xf-material-detail-info-label {
  color: #7c3aed;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.4;
}

.xf-material-detail-info-value {
  color: #6b5f95;
