}

.xf-material-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.xf-material-detail-tag {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f1eaff;
  color: #6d28d9;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.xf-material-detail-tag.stage {
