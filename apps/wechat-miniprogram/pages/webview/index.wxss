}

.xf-topic-detail-eyebrow {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 8rpx 22rpx;
  border: 1rpx solid #cfc2ef;
  border-radius: 999rpx;
  background: #f3eefc;
  color: #5b3fa1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
  line-height: 1.2;
}

.xf-topic-detail-eyebrow-amp {
  margin: 0 10rpx;
}

.xf-topic-detail-title-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 28rpx;
}

.xf-topic-detail-title {
  flex: 1 1 auto;
  min-width: 0;
  color: #24163a;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-topic-detail-emoji {
  flex: 0 0 auto;
  font-size: 54rpx;
  line-height: 1;
}

.xf-topic-detail-subtitle,
.xf-topic-detail-summary {
  display: block;
  color: #6b6485;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.72;
}

.xf-topic-detail-subtitle {
  margin-top: 22rpx;
  color: #5d4f8f;
  font-weight: 800;
}

.xf-topic-detail-summary {
