  font-weight: 900;
  letter-spacing: 0.14em;
  line-height: 34rpx;
}

.xf-worthbuy-detail-title {
  display: block;
  margin-top: 16rpx;
  color: #171437;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.22;
}

.xf-worthbuy-detail-verdict {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.xf-worthbuy-detail-verdict text {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.xf-worthbuy-detail-verdict.is-good text {
  background: #ecfdf5;
  color: #059669;
}

.xf-worthbuy-detail-verdict.is-warning text {
  background: #fff7ed;
  color: #c2410c;
}

.xf-worthbuy-detail-verdict .xf-worthbuy-detail-price {
  background: #f3eeff;
  color: #6d28d9;
}

.xf-worthbuy-detail-score-label {
  display: block;
  margin-top: 28rpx;
  color: #5e17eb;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.xf-worthbuy-detail-reason {
  display: block;
  margin-top: 14rpx;
  color: #667085;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.72;
}

.xf-worthbuy-detail-section-title {
  display: block;
  color: #171437;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.xf-worthbuy-detail-dimension {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
}

.xf-worthbuy-detail-dimension-label {
  flex: 0 0 auto;
  width: 112rpx;
  color: #69728a;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.xf-worthbuy-detail-score-track {
  flex: 1 1 auto;
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eee8fb;
}

.xf-worthbuy-detail-score-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #5e17eb;
}

.xf-worthbuy-detail-dimension-score {
  flex: 0 0 auto;
  width: 44rpx;
  color: #5e17eb;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: right;
}

.xf-worthbuy-detail-card.is-pros-cons {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 22rpx;
}

.xf-worthbuy-detail-column {
  min-width: 0;
}

.xf-worthbuy-detail-column-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.24;
}

.xf-worthbuy-detail-column-title.is-good {
  color: #059669;
}

.xf-worthbuy-detail-column-title.is-warning {
  color: #c2410c;
}

.xf-worthbuy-detail-list-item,
.xf-worthbuy-detail-point,
.xf-worthbuy-detail-advice {
  display: block;
  margin-top: 16rpx;
