.xf-expert-detail-citations > button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  margin: 0;
  padding: 14rpx 20rpx;
  border: 1rpx solid #e8e0f2;
  border-radius: 22rpx;
  background: #ffffff;
  color: #241a3a;
  text-align: left;
}

.xf-expert-detail-citations > button::after {
  border: 0;
}

.xf-expert-detail-citations > button view text {
  display: block;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.4;
}

.xf-expert-detail-citations > button view text + text {
  color: #8e81b3;
  font-size: 18rpx;
  font-weight: 600;
}

.xf-expert-detail-citations > button > text {
  color: #5e17eb;
  font-size: 28rpx;
  transition: transform 180ms ease;
}

.xf-expert-detail-citations > button > text.is-expanded {
  transform: rotate(180deg);
}

.xf-expert-detail-citation {
  margin-top: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #eee8f8;
  border-radius: 20rpx;
  background: #fcfaff;
}

.xf-expert-detail-citation-source,
.xf-expert-detail-citation-title,
.xf-expert-detail-citation-locator,
.xf-expert-detail-citation-copy {
  display: block;
}

.xf-expert-detail-citation-source {
  color: #5e17eb;
  font-size: 18rpx;
  font-weight: 900;
}

.xf-expert-detail-citation-title {
  margin-top: 5rpx;
  color: #241a3a;
  font-size: 22rpx;
  font-weight: 900;
}

.xf-expert-detail-citation-locator,
.xf-expert-detail-citation-copy {
  margin-top: 6rpx;
  color: #756b9b;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.55;
}

.xf-expert-detail-composer {
  position: fixed;
  right: 15px;
  bottom: calc(18px + env(safe-area-inset-bottom));
  left: 15px;
  z-index: 80;
  pointer-events: auto;
}

.xf-expert-detail-input-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 10px;
}

.xf-expert-detail-input-shell {
  display: flex;
  align-items: center;
  flex: 1 1 auto;
  min-width: 0;
  height: 58px;
  box-sizing: border-box;
  padding: 0 6px 0 7px;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 10px 26px rgba(70, 73, 132, 0.12),
    0 18px 38px rgba(122, 144, 255, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.xf-expert-detail-input-shell.has-typed-input,
.xf-expert-detail-input-shell.is-input-focused {
  box-shadow:
    0 12px 29px rgba(70, 73, 132, 0.16),
    0 24px 48px rgba(91, 72, 255, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);
}

.xf-expert-detail-voice {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 44px;
  height: 44px;
  margin: 0 4px 0 0;
  padding: 0;
  border-radius: 50%;
  background: #ffffff;
  color: #111936;
  box-shadow: 0 8px 18px rgba(70, 73, 132, 0.1);
}

.xf-expert-detail-voice-icon {
  display: block;
  width: 25px;
  height: 25px;
}

.xf-expert-detail-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 58px;
  color: #111936;
  font-size: 15px;
  font-weight: 400;
  line-height: 58px;
  text-align: center;
}

.xf-expert-detail-input-shell.has-typed-input .xf-expert-detail-input,
.xf-expert-detail-input-shell.is-input-focused .xf-expert-detail-input {
  text-align: left;
}

.xf-expert-detail-input-shell.is-placeholder .xf-expert-detail-input {
  font-size: 13px;
}

.xf-expert-detail-input-placeholder {
  color: #a5adc6;
  font-size: 13px;
  font-weight: 400;
}

.xf-expert-detail-send {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 46px;
  height: 46px;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #bca6fb 0%, #aa92f5 100%);
  color: #ffffff;
  box-shadow: 0 10px 22px rgba(118, 91, 220, 0.2);
}

.xf-expert-detail-input-shell.has-typed-input .xf-expert-detail-send {
  background: linear-gradient(135deg, #5b48ff 0%, #7a45f4 100%);
  box-shadow: 0 12px 26px rgba(91, 72, 255, 0.28);
}

.xf-expert-detail-send-mark {
  display: block;
  width: 22px;
  height: 22px;
}

.xf-expert-detail-plus {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 52px;
  height: 52px;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #ffffff;
  color: #111936;
  box-shadow: 0 10px 26px rgba(70, 73, 132, 0.1);
}

.xf-expert-detail-plus.is-open {
  color: #5b48ff;
  box-shadow: 0 14px 30px rgba(91, 72, 255, 0.18);
}

.xf-expert-detail-plus-mark {
  display: block;
  width: 17.6px;
  height: 17.6px;
}

.xf-expert-detail-attach-menu {
  position: fixed;
  right: 30px;
  bottom: calc(86px + env(safe-area-inset-bottom));
  left: 30px;
  z-index: 79;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  padding: 12px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 20px 44px rgba(70, 73, 132, 0.14);
}

.xf-expert-detail-attach-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 70px;
  margin: 0;
  padding: 0;
  border-radius: 20px;
  background: rgba(245, 243, 255, 0.86);
  color: #111936;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.2;
}

.xf-expert-detail-attach-icon {
  display: block;
  width: 24px;
  height: 24px;
}

.xf-expert-detail-send::after,
.xf-expert-detail-voice::after,
.xf-expert-detail-plus::after,
.xf-expert-detail-attach-action::after,
.xf-expert-detail-login::after {
  border: 0;
}

.xf-expert-detail-send[disabled] {
  color: #ffffff;
  opacity: 1;
}

.xf-expert-detail-login {
  width: 100%;
  height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  background: #5e17eb;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 88rpx;
  box-shadow: 0 18rpx 28rpx rgba(36, 26, 58, 0.28), 0 4rpx 10rpx rgba(36, 26, 58, 0.16);
}

.xf-worthbuy-detail-page {
  min-height: 100vh;
  background: #f8f6ff;
}

.xf-worthbuy-detail-scroll {
  box-sizing: border-box;
  height: 100vh;
  padding: 28rpx 28rpx 132rpx;
  background: #f8f6ff;
}

.xf-worthbuy-detail-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #e6def7;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(80, 62, 125, 0.06);
}

.xf-worthbuy-detail-card.is-hero {
  margin-top: 0;
  background: #ffffff;
}

.xf-worthbuy-detail-hero-head {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.xf-worthbuy-detail-score-ring {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 164rpx;
  height: 164rpx;
  border: 16rpx solid #e9ddff;
  border-radius: 50%;
  background: #ffffff;
}

.xf-worthbuy-detail-score {
  display: block;
  color: #5e17eb;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-worthbuy-detail-score-unit {
  display: block;
  margin-top: 6rpx;
  color: #9a91ad;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.xf-worthbuy-detail-hero-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-worthbuy-detail-eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 34rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f2ecff;
  color: #6d28d9;
