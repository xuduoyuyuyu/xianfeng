.xf-phone-login-mask{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:48rpx;background:rgba(26,20,48,.58);box-sizing:border-box}.xf-phone-login-card{width:100%;max-width:620rpx;padding:56rpx 44rpx 44rpx;border-radius:40rpx;background:#fff;box-shadow:0 28rpx 90rpx rgba(28,19,57,.25);display:flex;flex-direction:column;align-items:center;text-align:center;box-sizing:border-box}.xf-phone-login-image{width:150rpx;height:150rpx}.xf-phone-login-title{margin-top:20rpx;color:#22164f;font-size:38rpx;font-weight:800}.xf-phone-login-description{margin-top:18rpx;color:#756b91;font-size:27rpx;line-height:1.65}.xf-phone-login-message{margin-top:18rpx;color:#b42318;font-size:24rpx}.xf-phone-login-button{width:100%;margin-top:34rpx;border:0;border-radius:999rpx;background:linear-gradient(135deg,#6d3df5,#8d5bff);color:#fff;font-size:29rpx;font-weight:700}.xf-phone-login-button::after{border:0}.xf-phone-login-button.is-binding{opacity:.7}.xf-wechat-profile-card{padding-top:44rpx}.xf-wechat-profile-avatar-button{display:flex;flex-direction:column;align-items:center;gap:14rpx;margin:30rpx 0 0;padding:0;border:0;background:transparent;color:#6d3df5;font-size:24rpx;font-weight:700;line-height:1.4}.xf-wechat-profile-avatar-button::after,.xf-wechat-profile-skip::after{border:0}.xf-wechat-profile-avatar{width:132rpx;height:132rpx;border:4rpx solid #eee8ff;border-radius:30rpx;background:#f5f2ff}.xf-wechat-profile-nickname{width:100%;height:84rpx;margin-top:28rpx;padding:0 26rpx;border:2rpx solid #e2d9fb;border-radius:22rpx;background:#faf9ff;color:#22164f;font-size:28rpx;text-align:left;box-sizing:border-box}.xf-wechat-profile-skip{margin:20rpx 0 0;padding:0;border:0;background:transparent;color:#9187aa;font-size:25rpx;line-height:1.6}
