page {
  background: #f3f2f8;
  color: #1f1d1a;
}

@font-face {
  font-family: "Material Symbols Rounded";
  src: url("/assets/fonts/material-symbols-rounded.woff2") format("woff2");
}

.material-symbols-rounded {
  font-family: "Material Symbols Rounded";
  font-weight: 400;
  font-style: normal;
  line-height: 1;
  letter-spacing: 0;
  text-transform: none;
  white-space: nowrap;
  direction: ltr;
  font-feature-settings: "liga";
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.xf-native-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-right: 26rpx;
  padding-bottom: 188rpx;
  padding-left: 26rpx;
  background-color: #f3f2f8;
  background-image:
    linear-gradient(45deg, rgba(118, 83, 205, 0.055) 0, rgba(118, 83, 205, 0.055) 1rpx, transparent 1rpx, transparent 36rpx),
    linear-gradient(-45deg, rgba(118, 83, 205, 0.04) 0, rgba(118, 83, 205, 0.04) 1rpx, transparent 1rpx, transparent 64rpx);
  background-position: 0 0, 0 0;
  background-size: 36rpx 36rpx, 64rpx 64rpx;
}

.xf-native-topbar {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 40;
  box-sizing: border-box;
  display: flex;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 29, 26, 0.06);
}

.xf-native-nav-row {
  position: relative;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.xf-native-logo {
  position: absolute;
  left: 50%;
  width: 142rpx;
  transform: translateX(-50%);
}

.xf-native-menu-button {
  position: absolute;
  left: 26rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  box-shadow: none;
}

.xf-native-menu-button::after {
  border: 0;
}

.xf-native-back-button {
  left: 26rpx;
}

.xf-native-welfare-button {
  position: absolute;
  right: 104px;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  box-shadow: none;
}

.xf-native-welfare-button::after {
  border: 0;
}

.xf-native-welfare-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  transform-origin: 50% 50%;
  animation: xfNativeWelfareEntryShake 0.72s 0.24s cubic-bezier(0.2, 0.9, 0.22, 1) both;
}

@keyframes xfNativeWelfareEntryShake {
  0%,
  100% {
    transform: translateX(0) rotate(0) scale(1);
  }

  18% {
    transform: translateX(-3rpx) rotate(-10deg) scale(1.04);
  }

  34% {
    transform: translateX(3rpx) rotate(9deg) scale(1.04);
  }

  50% {
    transform: translateX(-2rpx) rotate(-6deg) scale(1.02);
  }

  66% {
    transform: translateX(2rpx) rotate(4deg) scale(1.01);
  }

  82% {
    transform: translateX(0) rotate(-2deg) scale(1);
  }
}

.xf-native-menu-icon,
.xf-native-menu-icon::before {
  display: block;
  width: 26rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #334155;
  content: "";
}

.xf-native-menu-icon {
  position: relative;
  transform: translateY(-5rpx);
}

.xf-native-menu-icon::before {
  position: absolute;
  top: 10rpx;
  left: 0;
  width: 18rpx;
}

.xf-native-back-icon {
  display: block;
  width: 22rpx;
  height: 22rpx;
