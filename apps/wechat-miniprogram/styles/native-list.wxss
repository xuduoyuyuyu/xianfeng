.xf-profile-back::after,
.xf-profile-tab::after,
.xf-profile-add-child::after,
.xf-profile-chip::after,
.xf-account-avatar-actions button::after,
.xf-profile-primary::after,
.xf-profile-secondary::after,
.xf-profile-danger::after,
.xf-memory-switch::after,
.xf-memory-search button::after,
.xf-memory-item button::after,
.xf-setting-segment button::after {
  border: 0;
}

.xf-profile-title {
  color: #101335;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: center;
}

.xf-profile-header-spacer {
  width: 140rpx;
}

.xf-profile-tabs {
  width: 100%;
  margin-bottom: 30rpx;
  white-space: nowrap;
}

.xf-profile-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-width: 136rpx;
  max-width: 196rpx;
  height: 64rpx;
  margin: 0 16rpx 0 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe1ea;
  border-radius: 999rpx;
  background: #ffffff;
  color: #101335;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
  vertical-align: top;
}

.xf-profile-tab.is-active {
  border-color: #cdb8ff;
  background: #efe8ff;
  color: #6c27d6;
  box-shadow: inset 0 0 0 4rpx rgba(124, 58, 237, 0.12);
}

.xf-profile-tab image {
  flex: 0 0 38rpx;
  width: 38rpx;
  height: 38rpx;
}

.xf-profile-tab text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-profile-add-child {
  display: inline-flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 2rpx dashed #cdb8ff;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6c27d6;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 64rpx;
  vertical-align: top;
}

.xf-profile-insight {
  box-sizing: border-box;
  margin-bottom: 34rpx;
  padding: 30rpx 34rpx;
  border: 2rpx solid #dacdff;
  border-radius: 30rpx;
  background: rgba(246, 244, 255, 0.84);
}

.xf-profile-insight-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #101335;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-profile-insight-head text:last-child {
  color: #7c3aed;
  font-size: 24rpx;
}

.xf-profile-insight-copy {
  margin-top: 20rpx;
  color: #69728a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.55;
}

.xf-profile-card {
  overflow: hidden;
  box-sizing: border-box;
  margin-bottom: 32rpx;
  padding: 32rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(31, 20, 71, 0.06);
}

.xf-profile-card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  color: #101335;
  font-size: 28rpx;
  font-weight: 900;
}

.xf-profile-card-title text:last-child {
  color: #7c3aed;
  font-size: 24rpx;
}

.xf-account-avatar-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-height: 172rpx;
}

.xf-account-avatar-image {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
}

.xf-account-avatar-empty {
  display: flex;
  flex: 0 0 104rpx;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 800;
}

.xf-account-avatar-body {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-account-avatar-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.xf-account-avatar-actions button {
  height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid #dbe1ea;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 52rpx;
}

.xf-account-avatar-copy {
  display: block;
  color: #94a3b8;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.45;
}

.xf-profile-field {
  margin-bottom: 28rpx;
}

.xf-profile-select-field {
  position: relative;
}

.xf-profile-label {
  display: block;
  margin-bottom: 14rpx;
  color: #445066;
  font-size: 25rpx;
  font-weight: 900;
}

.xf-profile-field input,
.xf-profile-input-like,
.xf-profile-readonly {
  width: 100%;
  min-height: 70rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe1ea;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #101335;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 70rpx;
  padding: 0 24rpx;
}

.xf-profile-input-like {
  display: flex;
  align-items: center;
}

.xf-profile-select-like {
  justify-content: space-between;
  gap: 16rpx;
}

.xf-profile-select-like text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-profile-inline-options {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 12rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8c7ff;
  border-radius: 22rpx;
  background: #ffffff;
}

.xf-profile-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #101335;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 64rpx;
  text-align: left;
}

.xf-profile-option.is-active {
  background: #efe8ff;
  color: #6c27d6;
}

.xf-profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.xf-profile-grade-field {
  grid-column: 1 / -1;
}

.xf-profile-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.xf-profile-chip {
  min-height: 52rpx;
  margin: 0;
  box-sizing: border-box;
  border: 2rpx solid #dbe1ea;
  border-radius: 999rpx;
  background: #f4f6fb;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 52rpx;
  padding: 0 24rpx;
  text-align: center;
}

.xf-profile-chip.is-active {
  border-color: #7c3aed;
  background: #f5efff;
  color: #6c27d6;
}

.xf-profile-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 14rpx;
}

.xf-profile-delete-zone {
  display: flex;
  justify-content: center;
  padding: 6rpx 0 16rpx;
}

.xf-profile-delete-child {
  display: block;
  width: auto;
  min-width: 0;
  height: auto;
  margin: 0;
  padding: 10rpx 24rpx;
  border: 0;
  background: transparent;
  color: #ff4d67;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.xf-profile-delete-child::after {
  border: 0;
}

.xf-profile-primary,
.xf-profile-secondary {
  height: 76rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.xf-profile-primary {
  background: #6c27d6;
  color: #ffffff;
}

.xf-account-save {
  width: 100%;
  margin-top: 20rpx;
  background: #eef2ff;
  color: #6c27d6;
}

.xf-profile-shortcuts {
  margin-top: 34rpx;
  padding: 0;
}

.xf-profile-shortcut {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.07);
  box-sizing: border-box;
}

.xf-profile-shortcut:last-child {
  border-bottom: 0;
}

.xf-profile-shortcut-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.xf-profile-shortcut-copy {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.xf-profile-shortcut-title,
.xf-profile-shortcut-subtitle {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xf-profile-shortcut-title {
  color: #334155;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.15;
}

.xf-profile-shortcut-subtitle {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.2;
}

.xf-profile-secondary {
  background: #eef2ff;
  color: #101335;
}

.xf-profile-message {
  min-height: 0;
  margin-top: 18rpx;
  color: #6c27d6;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.xf-profile-danger {
  display: block;
  width: 100%;
  margin: 44rpx 0 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #ff4057;
  font-size: 26rpx;
  font-weight: 900;
}

.xf-memory-panel,
.xf-settings-panel {
  background: #f6f7fb;
}

.xf-memory-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 74rpx;
}

.xf-memory-title,
.xf-memory-section-title {
  color: #101335;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.xf-memory-switch {
  position: relative;
  width: 96rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.xf-memory-switch text {
  position: absolute;
  top: 7rpx;
  left: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.16);
  transition: left 0.16s ease;
}

.xf-memory-switch.is-on {
  background: #6c27d6;
}

.xf-memory-switch.is-on text {
  left: 48rpx;
}

.xf-memory-copy {
  margin-top: 20rpx;
  font-size: 23rpx;
  font-weight: 500;
  color: #9aa4b5;
  line-height: 1.62;
}

.xf-memory-copy view {
  margin-bottom: 16rpx;
}

.xf-memory-copy view:last-child {
  margin-bottom: 0;
}

.xf-memory-search {
  display: flex;
  align-items: center;
  gap: 18rpx;
  height: 86rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.xf-memory-search text {
  flex: 0 0 auto;
  color: #94a3b8;
  font-size: 36rpx;
  font-weight: 700;
}

.xf-memory-search input {
  flex: 1 1 auto;
  min-width: 0;
  height: 86rpx;
  color: #101335;
  font-size: 27rpx;
  font-weight: 800;
}

.xf-memory-search button {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 0 0 26rpx;
  border: 0;
  border-left: 1rpx solid rgba(15, 23, 42, 0.1);
  background: transparent;
  color: #101335;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.xf-memory-list-card {
  padding: 24rpx;
}

.xf-memory-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.xf-memory-item,
.xf-memory-empty {
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #101335;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.55;
  padding: 24rpx;
}

.xf-memory-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.xf-memory-item text {
  flex: 1 1 auto;
  min-width: 0;
}

.xf-memory-item button {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #fff1f4;
  color: #ff4057;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.xf-memory-empty {
  color: #69728a;
}

.xf-settings-card {
  padding: 0;
}

.xf-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 92rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  background: #ffffff;
  color: #101335;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.2;
  padding: 0 30rpx;
  text-align: left;
}

.xf-setting-row:last-child {
  border-bottom: 0;
}

.xf-setting-button {
  width: 100%;
  margin: 0;
  border-radius: 0;
}

.xf-setting-row text,
.xf-setting-row button {
  font-size: inherit;
}

.xf-setting-value {
  color: #94a3b8;
  font-size: 25rpx;
  font-weight: 850;
}

.xf-setting-segment {
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #f1f4f9;
  padding: 6rpx;
}

.xf-setting-segment button {
  min-width: 68rpx;
  height: 48rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: #9aa3b7;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.xf-setting-segment button.is-active {
  background: #ffffff;
  color: #6c27d6;
  box-shadow: 0 6rpx 16rpx rgba(31, 20, 71, 0.08);
}

.xf-font-standard .xf-setting-row text,
.xf-font-standard .xf-setting-row button,
.xf-font-standard .xf-setting-value,
.xf-font-standard .xf-setting-segment button {
  font-size: 25rpx;
}

.xf-font-small .xf-setting-row {
  font-size: 24rpx;
}

.xf-font-small .xf-setting-row text,
.xf-font-small .xf-setting-row button,
.xf-font-small .xf-setting-value,
.xf-font-small .xf-setting-segment button {
  font-size: 22rpx;
}

.xf-font-large .xf-setting-row {
  font-size: 31rpx;
}

.xf-font-large .xf-setting-row text,
.xf-font-large .xf-setting-row button,
.xf-font-large .xf-setting-value,
.xf-font-large .xf-setting-segment button {
  font-size: 29rpx;
}

.xf-settings-login,
.xf-settings-logout {
  width: 100%;
  margin-top: 22rpx;
}

.xf-settings-panel {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 190rpx);
}

.xf-settings-bottom {
  margin-top: auto;
  padding-top: 120rpx;
  padding-bottom: 86rpx;
}

.xf-settings-danger {
  margin-top: 0;
}
